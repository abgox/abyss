{
    "version": "3.0.2",
    "description": "一个高性能、可扩展的应用启动器和插件平台 | A High-Performance, Extensible Application Launcher and Plugin Platform",
    "homepage": "https://github.com/ZToolsCenter/ZTools",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ZToolsCenter/ZTools/releases/download/v3.0.2/ZTools-3.0.2-win-x64-setup.exe",
            "hash": "6d9deac5fa1f383b2f5cdf19acb7680fdadb3fe5561a7386d0185cfbc7ba2971"
        }
    },
    "shortcuts": [
        [
            "app\\ZTools.exe",
            "ZTools"
        ]
    ],
    "link": "$env:AppData\\ZTools",
    "cleanup": "$env:LocalAppData\\ztools-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall ZTools.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ZToolsCenter/ZTools/releases/download/v$version/ZTools-$version-win-x64-setup.exe"
            }
        }
    }
}
