    "architecture": {
        "64bit": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.5.8/FluxDown-0.5.8-windows-x64-setup.exe",
            "hash": "1ae5d355565eaa6190d0406a26dd2993aec57a6deca56352f19510b4809b7481"
        },
        "arm64": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.5.8/FluxDown-0.5.8-windows-arm64-setup.exe",
            "hash": "1b1a362a1a708f21a1d6fcb007d755765a83490ce8fd8bbaf554e178c837b024"
        }
    },
    "shortcuts": [
        [
            "app\\fluxdown-desktop.exe",
            "FluxDown"
        ]
    ],
    "link": [
        "$env:AppData\\FluxDown",
        "$env:LocalAppData\\FluxDown"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zerx-lab/FluxDown/releases/download/v$version/FluxDown-$version-windows-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/zerx-lab/FluxDown/releases/download/v$version/FluxDown-$version-windows-arm64-setup.exe"
            }
        }
