{
    "version": "0.2.0",
    "description": "一款免费开源的 RSS 阅读器 | A free and open-source feed reader",
    "homepage": "https://github.com/zhanglun/lettura",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/zhanglun/lettura/releases/download/v0.2.0/Lettura_0.2.0_x64-setup.exe",
            "hash": "2d73ed9590ce19a04363155dc2dbed744df683484ac501adea1daa15bf5becd7"
        }
    },
    "shortcuts": [
        [
            "app\\Lettura.exe",
            "Lettura"
        ]
    ],
    "link": "$home\\.lettura",
    "cleanup": [
        "$env:AppData\\com.lettura.dev",
        "$env:LocalAppData\\com.lettura.dev"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zhanglun/lettura/releases/download/v$version/Lettura_$version_x64-setup.exe"
            }
        }
    }
}
