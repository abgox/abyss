{
    "version": "3.15.3",
    "description": "一款专为长周期任务打造、由 Z.ai 提供技术支持的全功能智能自主开发环境（ADE） | A full-featured Agentic Development Environment (ADE) built for Long Horizon Tasks, powered by Z.ai",
    "homepage": "https://zcode.z.ai",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn-zcode.z.ai/zcode/electron/releases/3.15.3/windows-x64/ZCode-3.15.3-win-x64.exe",
            "hash": "bc8100ba4377256fbe1531d549b4775f18e3ba21768b6294ca50751cd461faca"
        },
        "arm64": {
            "url": "https://cdn-zcode.z.ai/zcode/electron/releases/3.15.3/windows-arm64/ZCode-3.15.3-win-arm64.exe",
            "hash": "c9b99c870bfb531d540cc27d5fed40809073f09e8c12e11f1df2446c639164f4"
        }
    },
    "shortcuts": [
        [
            "app\\ZCode.exe",
            "ZCode"
        ]
    ],
    "link": [
        "$home\\.zcode",
        "$home\\ZCodeProject",
        "$env:AppData\\ZCode"
    ],
    "cleanup": "$env:LocalAppData\\@zcodedesktop-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall ZCode.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://zcode.z.ai/api/v2/releases/latest?target=windows&arch=x86_64",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn-zcode.z.ai/zcode/electron/releases/$version/windows-x64/ZCode-$version-win-x64.exe"
            },
            "arm64": {
                "url": "https://cdn-zcode.z.ai/zcode/electron/releases/$version/windows-arm64/ZCode-$version-win-arm64.exe"
            }
        }
    }
}
