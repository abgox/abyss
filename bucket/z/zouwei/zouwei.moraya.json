{
    "version": "0.45.16",
    "description": "极致优雅的开源 Markdown AI Agent | An extremely elegant open-source Markdown AI Agent",
    "homepage": "https://moraya.app",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/zouwei/moraya/releases/download/v0.45.16/Moraya_0.45.16_win_x64-setup.exe",
            "hash": "d9b9c0c7cce0f6a24a0ecb1223e724ca8f9a78b29d08458915d5d89529eb7e79"
        }
    },
    "shortcuts": [
        [
            "app\\moraya.exe",
            "Moraya"
        ]
    ],
    "link": [
        "$env:AppData\\com.moraya.app",
        "$home\\.moraya"
    ],
    "cleanup": "$env:LocalAppData\\com.moraya.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zouwei/moraya/releases/download/v$version/Moraya_$version_win_x64-setup.exe"
            }
        }
    }
}
