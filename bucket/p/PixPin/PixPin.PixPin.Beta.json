            "hash": "4863baea38536ba49e65359537d491d5f6cde76cb3eb0849e18623bc145e78e2"
        }
    },
    "conflicts": [
        "PixPin.PixPin",
        "PixPin.PixPin.Beta"
    ],
    "bin": "app\\PixPin.exe",
    "shortcuts": [
