{
    "version": "2.1.19",
    "description": "一款功能齐全的 PDF 管理软件 | A piece of full-featured PDF management software",
    "homepage": "https://www.pdfgear.com",
    "license": {
        "identifier": "Freeware"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloadfiles.pdfgear.com/releases/windows/pdfgear_setup_v2.1.19.exe",
            "hash": "2f9c2548233f54ea58c7946accef44b8714f1e23517deaa3249f7286a122639b"
        }
    },
    "shortcuts": [
        [
            "app\\PDFLauncher.exe",
            "PDFgear"
        ]
    ],
    "link": "$env:LocalAppData\\PDFgear",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "PDFgear.PDFgear",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
