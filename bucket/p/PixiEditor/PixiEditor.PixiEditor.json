{
    "version": "2.1.2.2",
    "description": "一款满足你所有 2D 创作需求的通用编辑器 | A Universal Editor for all your 2D needs",
    "homepage": "https://pixieditor.net",
    "license": {
        "identifier": "LGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/PixiEditor/PixiEditor/releases/download/2.1.2.2/PixiEditor.2.1.2.2.x64-win.zip",
            "hash": "15b8c8b57df16fcd759e54bb836cffa3dfb1a2228992ca445023a5b4c1a5e77d"
        }
    },
    "extract_dir": "PixiEditor",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\PixiEditor.exe",
            "PixiEditor"
        ]
    ],
    "link": [
        "$env:AppData\\PixiEditor",
        "$env:LocalAppData\\PixiEditor"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/PixiEditor/PixiEditor/releases/download/$version/PixiEditor.$version.x64-win.zip"
            }
        }
    }
}
