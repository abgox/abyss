{
    "version": "0.4.3",
    "description": "现代化、跨平台的休息提醒应用 | A modern, cross-platform break reminder application",
    "homepage": "https://github.com/pilgrimlyieu/Focust",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/pilgrimlyieu/Focust/releases/download/v0.4.3/focust_0.4.3_windows_installer.exe",
            "hash": "52abe30ff90a4f6a079d0273734a5c7969be086938183e6e435bbd5144f9c03b"
        }
    },
    "shortcuts": [
        [
            "app\\focust.exe",
            "Focust"
        ]
    ],
    "link": "$env:AppData\\com.fesmoph.focust",
    "cleanup": "$env:LocalAppData\\com.fesmoph.focust",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pilgrimlyieu/Focust/releases/download/v$version/focust_$version_windows_installer.exe"
            }
        }
    }
}
