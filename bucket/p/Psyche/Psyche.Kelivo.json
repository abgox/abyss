{
    "version": "1.2.2+66",
    "description": "一个 Flutter LLM 聊天客户端 | A Flutter LLM Chat Client",
    "homepage": "https://kelivo.psycheas.top",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Chevey339/kelivo/releases/download/v1.2.2/Kelivo_windows_1.2.2+66_setup.exe",
            "hash": "a4d2249e51e9b373bc587a46b1f4229795c2701a3e2fb1f63434bf2440027d1c"
        }
    },
    "shortcuts": [
        [
            "app\\kelivo.exe",
            "Kelivo"
        ]
    ],
    "link": [
        "$env:AppData\\com.psyche\\kelivo",
        "$env:LocalAppData\\com.psyche\\kelivo"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Psyche.Kelivo",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
