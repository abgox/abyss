{
    "version": "2.5.0",
    "description": "一个友好的 Godot 版本管理器 | A friendly Godot version manager",
    "homepage": "https://fgvm.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/patricktcoakley/fgvm/releases/download/v2.5.0/fgvm-win-x64.zip",
            "hash": "7ce38fbd78619d8487a309b1297b52e27abb17c352e1a0d223f31850c7fdc1ac"
        }
    },
    "extract_to": "app",
    "env_set": {
        "FGVM_HOME": "$scoopdir\\persist\\abgox.abyss"
    },
    "env_add_path": "fgvm\\bin",
    "bin": "app\\fgvm.exe",
    "link": "$home\\fgvm",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/patricktcoakley/fgvm/releases/download/v$version/fgvm-win-x64.zip"
            }
        }
    }
}
