{
    "version": "2.4.0",
    "description": "一个友好的 Godot 版本管理器 | A friendly Godot version manager",
    "homepage": "https://fgvm.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/patricktcoakley/fgvm/releases/download/v2.4.0/fgvm-win-x64.zip",
            "hash": "9de3e0451bff62ddf741a835ef51e088c315370b0d1827da0783f5d8d73659a2"
        }
    },
    "extract_to": "app",
    "env_set": {
        "FGVM_HOME": "$persist_dir"
    },
    "env_add_path": "fgvm\\bin",
    "bin": "app\\fgvm.exe",
    "link": "$home\\fgvm",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/patricktcoakley/fgvm/releases/download/v$version/fgvm-win-x64.zip"
            }
        }
    }
}
