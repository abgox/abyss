            "hash": "5e0c70cbf4f694080c34aa7c6c745e606c16fe76a4b5423b93ebf9dc34274c99"
        },
        "arm64": {
            "url": "https://github.com/voidtools/ES/releases/download/1.1.0.38/ES-1.1.0.38.ARM64.zip",
            "hash": "86eddd4ae8925833e33be1d09e7faa2442110d00daf0e48a8e963cdeb7a141fe"
        }
    },
    "extract_to": "app",
    "bin": "app\\es.exe",
    "link": "$env:AppData\\voidtools\\es",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/voidtools/ES/releases/download/$version/ES-$version.x64.zip"
            },
            "arm64": {
                "url": "https://github.com/voidtools/ES/releases/download/$version/ES-$version.ARM64.zip"
            }
        }
    }
}
