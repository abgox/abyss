{
    "version": "3.0.8",
    "description": "使用图形化的 Scrcpy 显示和控制您的 Android 设备，由 Electron 驱动 | Graphical Scrcpy to display and control Android, devices powered by Electron",
    "homepage": "https://github.com/viarotel-org/escrcpy",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/viarotel-org/escrcpy/releases/download/v3.0.8/Escrcpy-3.0.8-win-setup-x64.exe",
            "hash": "3bc75e750d457f0f79e5c230cb769920c6096f2db4d98d3ea283e6bb8b7fda5e"
        },
        "arm64": {
            "url": "https://github.com/viarotel-org/escrcpy/releases/download/v3.0.8/Escrcpy-3.0.8-win-setup-arm64.exe",
            "hash": "620cb58ff0cbaf85d2912bed4164641085628a8545941c6666928ca70450cb92"
        }
    },
    "shortcuts": [
        [
            "app\\Escrcpy.exe",
            "Escrcpy"
        ]
    ],
    "link": "$env:AppData\\escrcpy",
    "cleanup": "$env:LocalAppData\\escrcpy-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Escrcpy.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/viarotel-org/escrcpy/releases/download/v$version/Escrcpy-$version-win-setup-x64.exe"
            },
            "arm64": {
                "url": "https://github.com/viarotel-org/escrcpy/releases/download/v$version/Escrcpy-$version-win-setup-arm64.exe"
            }
        }
    }
}
