{
    "version": "3.2.0",
    "description": "使用图形化的 Scrcpy 显示和控制您的 Android 设备，由 Electron 驱动 | Graphical Scrcpy to display and control Android, devices powered by Electron",
    "homepage": "https://github.com/viarotel-org/escrcpy",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/viarotel-org/escrcpy/releases/download/v3.2.0/Escrcpy-3.2.0-win-setup-x64.exe",
            "hash": "48c5d4229a298104930f4d32be28a7f016615ee67b1904041cb0072c2bad67a1"
        },
        "arm64": {
            "url": "https://github.com/viarotel-org/escrcpy/releases/download/v3.2.0/Escrcpy-3.2.0-win-setup-arm64.exe",
            "hash": "7dc1ef43b7617e5f2f6de658914426344f817e76ff4e239639e894136414767e"
        }
    },
    "shortcuts": [
        [
            "app\\Escrcpy.exe",
            "Escrcpy"
        ]
    ],
    "link": "$env:AppData\\escrcpy",
    "cleanup": "$env:LocalAppData\\escrcpy-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Escrcpy.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/viarotel-org/escrcpy/releases/download/v$version/Escrcpy-$version-win-setup-x64.exe"
            },
            "arm64": {
                "url": "https://github.com/viarotel-org/escrcpy/releases/download/v$version/Escrcpy-$version-win-setup-arm64.exe"
            }
        }
    }
}
