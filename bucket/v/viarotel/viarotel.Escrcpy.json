{
    "version": "3.3.1",
    "description": "使用图形化的 Scrcpy 显示和控制您的 Android 设备，由 Electron 驱动 | Graphical Scrcpy to display and control Android, devices powered by Electron",
    "homepage": "https://github.com/viarotel-org/escrcpy",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/viarotel-org/escrcpy/releases/download/v3.3.1/Escrcpy-3.3.1-win-setup-x64.exe",
            "hash": "ecba4ccda783431f6297ca6aad0e9e0f9c5eab50ce82a6251d9dcb4eab28f430"
        },
        "arm64": {
            "url": "https://github.com/viarotel-org/escrcpy/releases/download/v3.3.1/Escrcpy-3.3.1-win-setup-arm64.exe",
            "hash": "72cafbb933bcc2a0274a1e2c21c93b152a98da3f224a9da17dc7cf363190c572"
        }
    },
    "shortcuts": [
        [
            "app\\Escrcpy.exe",
            "Escrcpy"
        ]
    ],
    "link": "$env:AppData\\escrcpy",
    "cleanup": "$env:LocalAppData\\escrcpy-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Escrcpy.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/viarotel-org/escrcpy/releases/download/v$version/Escrcpy-$version-win-setup-x64.exe"
            },
            "arm64": {
                "url": "https://github.com/viarotel-org/escrcpy/releases/download/v$version/Escrcpy-$version-win-setup-arm64.exe"
            }
        }
    }
}
