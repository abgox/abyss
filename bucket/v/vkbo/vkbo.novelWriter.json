            "hash": "eb7638b749b012c611e3be1076333a00bdbf2079b795cf93b880ef3f829c976d"
        }
    },
    "shortcuts": [
        [
            "app\\novelWriter.exe",
            "novelWriter"
        ]
    ],
    "link": [
        "$env:AppData\\novelwriter",
