{
    "version": "2.0.0",
    "description": "澜音，一个跨平台的音乐播放器应用，提供插件运行框架与播放功能 | A cross-platform music player application that provides a plug-in running framework and playback functions",
    "homepage": "https://ceru.docs.shiqianjiang.cn",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/timeshiftsauce/CeruMusic/releases/download/v2.0.0/ceru-music-2.0.0-win-x64-setup.exe",
            "hash": "876ab9cc263b163b9082e9d70302fadb3f320efc56bf35fd71ab90310860511e"
        }
    },
    "shortcuts": [
        [
            "app\\ceru-music.exe",
            "澜音"
        ]
    ],
    "link": "$env:AppData\\ceru-music",
    "cleanup": "$env:LocalAppData\\ceru-music-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall ceru-music.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/timeshiftsauce/CeruMusic/releases/download/v$version/ceru-music-$version-win-x64-setup.exe"
            }
        }
    }
}
