{
    "version": "3.1.60",
    "description": "轻量、高性能的 SSH 工具 | A lightweight yet high-performance SSH tool",
    "homepage": "https://ishell.cc",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://ishell-down.oss-cn-beijing.aliyuncs.com/ishellpro_3.1.60_x64-setup.exe",
            "hash": "277462e3dd2a78aea1b692657831956e3786d0a046172f05f0f8d1571d5d67d6"
        }
    },
    "shortcuts": [
        [
            "app\\ishellpro.exe",
            "ishellpro"
        ]
    ],
    "link": "$env:AppData\\cc.ishell.pro",
    "cleanup": "$env:LocalAppData\\cc.ishell.pro",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "TooYi.IShell",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
