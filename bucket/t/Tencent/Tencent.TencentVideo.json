        }
    },
    "location": "${env:ProgramFiles(x86)}\\Tencent\\QQLive",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "# 无法静默安装",
        "A-Install-App -Uninstaller 'QQLiveUninstaller.exe' -ArgumentList '/RQ=0'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Tencent.TencentVideo"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX86#/dl.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x86_machine.InstallerSha256"
