{
    "version": "2.86.0",
    "description": "腾讯元宝，腾讯的一款 AI 智能助手 | An AI assistant by Tencent",
    "homepage": "https://yuanbao.tencent.com",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn-hybrid-prod.hunyuan.tencent.com/Desktop/official/ed4c783577115de6386352736b84ee5f/yuanbao_2.86.0.615_x64.exe",
            "hash": "2fce0ea5aa2eaab19ecdfb1bfc462a2c05c6270aae5fa155375716220ab4a61f"
        }
    },
    "shortcuts": [
        [
            "app\\Yuanbao\\yuanbao.exe",
            "腾讯元宝"
        ]
    ],
    "link": "$env:AppData\\Tencent\\Yuanbao",
    "cleanup": "$env:LocalAppData\\com.tencent.yuanbao",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Yuanbao\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Tencent.Yuanbao",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
