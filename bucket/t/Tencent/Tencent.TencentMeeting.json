{
    "version": "3.45.10.411",
    "description": "腾讯会议，腾讯的一款视频会议软件 | A meeting software by Tencent",
    "homepage": "https://meeting.tencent.com",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://updatecdn.meeting.qq.com/cos/b4e365dc68200484ad9bb3fb0415c3b1/TencentMeeting_0300000000_3.45.10.411_x86_64.publish.exe",
            "hash": "c1245f657af909c3f8ca4443483ee751c9047ff66059a866d1577504d748eb7e"
        }
    },
    "location": "$env:ProgramFiles\\Tencent\\WeMeet",
    "link": "$env:AppData\\Tencent\\WeMeet",
    "cleanup": "$env:AppData\\WeMeetApp",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -ArgumentList '/SilentInstall=0','/StartProcess=0'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "$Uninstaller = Get-ChildItem \"$env:ProgramFiles\\Tencent\\WeMeet\" WeMeetUninstall.exe -Recurse | Sort-Object LastWriteTime -Descending | Select-Object -First 1",
        "A-Remove-Link",
        "A-Uninstall-App -Uninstaller $Uninstaller.FullName"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Tencent.TencentMeeting",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
