{
    "version": "3.11.8",
    "description": "腾讯文档，腾讯的一款可多人同时编辑的在线文档协作工具 | A collaborative online document tool that allows multiple people to edit at the same time by Tencent",
    "homepage": "https://docs.qq.com",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://desktop.docs.qq.com/update/release/3.11.8/TencentDocs3.11.8.x64.30002.exe",
            "hash": "c793a7fff0f64e085c0f90265c2f230d1a1ae794b70905ec4a6ebc9888d0d0a5"
        }
    },
    "shortcuts": [
        [
            "app\\TencentDocs.exe",
            "腾讯文档"
        ]
    ],
    "link": "$env:AppData\\TDAppDesktop",
    "cleanup": [
        "$env:LocalAppData\\tdappdesktop",
        "$env:LocalAppData\\tdappdesktop-updater"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall TencentDocs.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Tencent.TencentDocs",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
