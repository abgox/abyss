{
    "version": "9.43.1",
    "description": "一款适用于 Windows 的现代 SSH 客户端和终端 | A modern SSH client and terminal for Windows",
    "homepage": "https://termius.com",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://autoupdate.termius.com/windows/Install%20Termius.exe",
            "hash": "43bc1d415993253bd42976fee150cc150cea57e75b1c90a4083e33f9f3267575"
        }
    },
    "shortcuts": [
        [
            "app\\Termius.exe",
            "Termius"
        ]
    ],
    "link": "$env:AppData\\Termius",
    "cleanup": "$env:LocalAppData\\termius-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Termius.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Termius.Termius",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://autoupdate.termius.com/windows/Install%20Termius.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
