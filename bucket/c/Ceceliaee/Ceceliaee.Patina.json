{
    "version": "1.9.4",
    "description": "面向 Windows 桌面工作的本地优先时间追踪工具 | Local-first time tracking for Windows desktop work",
    "homepage": "https://github.com/Ceceliaee/patina",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Ceceliaee/patina/releases/download/v1.9.4/Patina_1.9.4_x64-setup.exe",
            "hash": "3f8dc930eeced9bd6cf10cfbea2db6a43dadc18d652c1ef85c9da8b3d2e7c1a7"
        }
    },
    "shortcuts": [
        [
            "app\\Patina.exe",
            "Patina"
        ]
    ],
    "link": "$env:AppData\\Patina",
    "cleanup": "$env:LocalAppData\\Patina",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Ceceliaee/patina/releases/download/v$version/Patina_$version_x64-setup.exe"
            }
        }
    }
}
