{
    "version": "1.9.5",
    "description": "面向 Windows 桌面工作的本地优先时间追踪工具 | Local-first time tracking for Windows desktop work",
    "homepage": "https://github.com/Ceceliaee/patina",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Ceceliaee/patina/releases/download/v1.9.5/Patina_1.9.5_x64-setup.exe",
            "hash": "5c5a5782da9939db479459e49d20df58cd21e1e0f2ce15b4c45726a469464dd4"
        }
    },
    "shortcuts": [
        [
            "app\\Patina.exe",
            "Patina"
        ]
    ],
    "link": "$env:AppData\\Patina",
    "cleanup": "$env:LocalAppData\\Patina",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Ceceliaee/patina/releases/download/v$version/Patina_$version_x64-setup.exe"
            }
        }
    }
}
