{
    "version": "1.2.9",
    "description": "下一代 Markdown 编辑器 | The next-generation Markdown editor",
    "homepage": "https://textus.catvinci.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v1.2.9/Textus_1.2.9_x64-setup.exe",
            "hash": "2422d6bf06b8a01f805f20eade6f2fb2baf75e2ee44a125dc92ee346f6afae0f"
        }
    },
    "shortcuts": [
        [
            "app\\Textus.exe",
            "Textus"
        ]
    ],
    "link": "$env:AppData\\com.catvinci.textus",
    "cleanup": "$env:LocalAppData\\com.catvinci.textus",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v$version/Textus_$version_x64-setup.exe"
            }
        }
    }
}
