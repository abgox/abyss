{
    "version": "1.2.10",
    "description": "下一代 Markdown 编辑器 | The next-generation Markdown editor",
    "homepage": "https://textus.catvinci.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v1.2.10/Textus_1.2.10_x64-setup.exe",
            "hash": "9a5f03c3cb23863b474ea8fd06bde457f86ce4da70aa71f9e2b44ecef4106480"
        }
    },
    "shortcuts": [
        [
            "app\\Textus.exe",
            "Textus"
        ]
    ],
    "link": "$env:AppData\\com.catvinci.textus",
    "cleanup": "$env:LocalAppData\\com.catvinci.textus",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v$version/Textus_$version_x64-setup.exe"
            }
        }
    }
}
