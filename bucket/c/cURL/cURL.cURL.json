            "hash": "f38b0ac2e3a280fd414b607c874a21e6dd4d1ed0e2ae622afbf0020917446561",
            "extract_dir": "curl-8.22.0_3-win64-mingw"
        },
        "arm64": {
            "url": "https://curl.se/windows/dl-8.22.0_3/curl-8.22.0_3-win64a-mingw.zip",
