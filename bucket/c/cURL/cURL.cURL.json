            "hash": "c5fad2c089f5396b80fcf2389a52da10d1a6d9284beb75922a69e6e6ef66b9a3",
            "extract_dir": "curl-8.23.0_2-win64-mingw"
        },
        "arm64": {
            "url": "https://curl.se/windows/dl-8.23.0_2/curl-8.23.0_2-win64a-mingw.zip",
