{
    "version": "28.40.0000",
    "description": "一个 Windows 上的第三方文件管理器 | A file manager for Windows",
    "homepage": "https://www.xyplorer.com/index.php",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.xyplorer.com/purchase.php"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.xyplorer.com/download/xyplorer64_28.40.0000.zip",
            "hash": "52ceafe483d787817042c0561246a5d8ab5df5524f4780a2b2851e14dec9370b"
        }
    },
    "extract_to": "app",
    "bin": "app\\XYplorer.exe",
    "shortcuts": [
        [
            "app\\XYplorer.exe",
            "XYplorer"
        ]
    ],
    "link": "$env:AppData\\XYplorer64",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe' -Installer (Get-ChildItem $dir -Filter XYplorer64*.exe -Recurse | Select-Object -First 1).FullName"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://www.xyplorer.com",
        "regex": "version.+?(([\\d.]+){3,})"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.xyplorer.com/download/xyplorer64_$version.zip"
            }
        }
    }
}
