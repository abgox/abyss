    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/charmbracelet/skate/releases/download/v1.1.0/skate_1.1.0_Windows_x86_64.zip",
            "hash": "c7378f0192c0cb0aaa07cd1057453e644d0be2101139d66ae20d28b48b6b8b52",
            "extract_dir": "skate_1.1.0_Windows_x86_64"
        }
    },
    "extract_to": "app",
    "bin": "app\\skate.exe",
