{
    "version": "0.8.6",
    "description": "开源轻量跨平台原生 AI 终端 | Open-source lightweight cross-platform AI-native terminal",
    "homepage": "https://terax.app",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/crynta/terax-ai/releases/download/v0.8.6/Terax_0.8.6_x64-setup.exe",
            "hash": "deae4e4e7e6ec16d945d98910588d8595ef5b9eb0ba4c5daa3d3b266e38f18d3"
        }
    },
    "shortcuts": [
        [
            "app\\terax.exe",
            "Terax"
        ]
    ],
    "link": "$env:AppData\\app.crynta.terax",
    "cleanup": [
        "$env:LocalAppData\\app.crynta.terax",
        "$home\\.cache\\terax"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/crynta/terax-ai/releases/download/v$version/Terax_$version_x64-setup.exe"
            }
        }
    }
}
