{
    "version": "2.0.0",
    "description": "一款极速的 CMake 文件格式化工具 | A lightning-fast CMake file formatter",
    "homepage": "https://cmakefmt.dev",
    "license": {
        "identifier": "MIT|Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/cmakefmt/cmakefmt/releases/download/v2.0.0/cmakefmt-2.0.0-x86_64-pc-windows-msvc.zip",
            "hash": "e6784902a526e2c26232a6e57f566927f5500d6ea9828b6aa2bdeb0d72ef088b",
            "extract_dir": "cmakefmt-2.0.0-x86_64-pc-windows-msvc"
        }
    },
    "extract_to": "app",
    "bin": "app\\cmakefmt.exe",
    "link": "$home\\.cmakefmt.yaml",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cmakefmt/cmakefmt/releases/download/v$version/cmakefmt-$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "cmakefmt-$version-x86_64-pc-windows-msvc"
            }
        }
    }
}
