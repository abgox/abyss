{
    "version": "2.3.0.2767",
    "description": "跨设备的通用粘贴板 | Universal Pasteboard Across Devices",
    "homepage": "https://crosspaste.com",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/CrossPaste/crosspaste-desktop/releases/download/2.3.0.2767/crosspaste-2.3.0-2767-windows-amd64.zip",
            "hash": "c4e34297bfc9d35f86e1dc36e0c4bee0c16c354475201a30699506b79445de7e"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\bin\\CrossPaste.exe",
            "CrossPaste"
        ]
    ],
    "link": "$home\\.crosspaste",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CrossPaste/crosspaste-desktop/releases/download/$matchHead.$buildVersion/crosspaste-$matchHead-$buildVersion-windows-amd64.zip"
            }
        }
    }
}
