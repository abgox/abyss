{
    "version": "2.1.7.2461",
    "description": "跨设备的通用粘贴板 | Universal Pasteboard Across Devices",
    "homepage": "https://crosspaste.com",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/CrossPaste/crosspaste-desktop/releases/download/2.1.7.2461/crosspaste-2.1.7-2461-windows-amd64.zip",
            "hash": "93df7a7d491aeed268a081a3e30013b133d2b63a63fa69a4fd7743353cea6e6c"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\bin\\CrossPaste.exe",
            "CrossPaste"
        ]
    ],
    "link": "$home\\.crosspaste",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CrossPaste/crosspaste-desktop/releases/download/$matchHead.$buildVersion/crosspaste-$matchHead-$buildVersion-windows-amd64.zip"
            }
        }
    }
