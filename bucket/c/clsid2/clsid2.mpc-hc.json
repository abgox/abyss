{
    "version": "2.8.1",
    "description": "适用于 Windows 的极其轻量级的开源媒体播放器 | An extremely light-weight, open source media player for Windows",
    "homepage": "https://github.com/clsid2/mpc-hc",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/clsid2/mpc-hc/releases/download/2.8.1/MPC-HC.2.8.1.x64.zip",
            "hash": "b57afd92d7db4f09a2a878c945509fba3ad21847a03851224152a0342286eadc",
            "shortcuts": [
                [
                    "app\\mpc-hc64.exe",
                    "MPC-HC"
                ]
            ]
        }
    },
    "extract_to": "app",
    "persist": [
        [
            "app\\mpc-hc64.ini",
            "mpc-hc64.ini"
        ],
        [
            "app\\mpc-hc.ini",
            "mpc-hc.ini"
        ],
        [
            "app\\default.mpcpl",
            "default.mpcpl"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/clsid2/mpc-hc/releases/download/$version/MPC-HC.$version.x64.zip"
            }
        }
    }
