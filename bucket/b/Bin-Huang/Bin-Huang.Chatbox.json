{
    "version": "1.22.6",
    "description": "一个可使用 ChatGPT、Claude 和其他 LLM 的桌面客户端 | A desktop client for ChatGPT, Claude and other LLMs",
    "homepage": "https://chatboxai.app",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.chatboxai.app/releases/Chatbox-1.22.6-Setup.exe",
            "hash": "f80219298a6b5f9d4d71e00dc710483324eaaa8a21c1a3bb521484f4e7776315"
        },
        "arm64": {
            "url": "https://download.chatboxai.app/releases/Chatbox-1.22.6-Setup.exe",
            "hash": "f80219298a6b5f9d4d71e00dc710483324eaaa8a21c1a3bb521484f4e7776315"
        }
    },
    "shortcuts": [
        [
            "app\\Chatbox.exe",
            "Chatbox"
        ]
    ],
    "link": "$env:AppData\\xyz.chatboxapp.app",
    "cleanup": "$env:LocalAppData\\xyz.chatboxapp.app-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Chatbox.exe' -ArgumentList '/CurrentUser','/S',\"/D=$dir\\app\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Bin-Huang.Chatbox",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_user.InstallerSha256"
                }
            }
        }
    }
}
