{
    "version": "2026.9.1",
    "description": "适用于个人、团队和企业组织的密码管理解决方案 | Password management solutions for individuals, teams, and business organizations",
    "homepage": "https://bitwarden.com",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/bitwarden/clients/releases/download/desktop-v2026.9.1/Bitwarden-Installer-2026.9.1.exe",
            "hash": "49b10f0840e70bdd1701cc9a0b729813015a70d3d3b487682a4e4a93819a3263"
        }
    },
    "shortcuts": [
        [
            "app\\Bitwarden.exe",
            "Bitwarden"
        ]
    ],
    "link": "$env:AppData\\Bitwarden",
    "cleanup": "$env:LocalAppData\\bitwarden-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Bitwarden.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "stable"
        },
        "regex": "desktop-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bitwarden/clients/releases/download/desktop-v$version/Bitwarden-Installer-$version.exe"
            }
        }
    }
