{
    "version": "2.3.61406",
    "description": "字节跳动的一个 AI 驱动的代码 IDE | An AI-powered code IDE by ByteDance",
    "homepage": "https://www.trae.ai",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.trae.ai/terms-of-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://lf-cdn.trae.ai/obj/trae-ai-sg/pkg/app/releases/stable/2.3.61406/win32/Trae-Setup-x64.exe",
            "hash": "8e0b4efa203af8fe53d9d642cf5a2e4345389c426c9dfdf803ae7f1bef9ba61f"
        }
    },
    "env_add_path": "app\\bin",
    "commands": "trae",
    "shortcuts": [
        [
            "app\\Trae.exe",
            "Trae"
        ]
    ],
    "link": [
        "$env:AppData\\Trae",
        "$home\\.trae"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://api.trae.ai/icube/api/v1/native/version/trae/latest",
        "jsonpath": "$.data.manifest.win32.download[0].x64",
        "regex": "([\\d.]{5,})"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/$version/win32/TraeCode-Setup-x64.exe"
            }
        }
    }
}
