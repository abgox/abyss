{
    "version": "0.1.69",
    "description": "字节跳动的专为日常工作打造的专业 AI 工作助手 | A professional AI work assistant built for everyday work by ByteDance",
    "homepage": "https://www.trae.cn/work",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/2.3.87413/win32/TraeWork_CN-Setup-x64.exe",
            "hash": "d1482ee8ca099341229f359f10682a26a798335edb63e3210c061cd17ef4fc27"
        }
    },
    "env_add_path": "app\\bin",
    "shortcuts": [
        [
            "app\\TRAE SOLO CN.exe",
            "TraeWork CN"
        ]
    ],
    "link": [
        "$home\\.trae-cn",
        "$env:AppData\\TRAE SOLO CN"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "ByteDance.TraeWork.CN",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
