{
    "version": "8.0.3",
    "description": "字节跳动下先进企业协作与管理平台(飞书的国际版本) | A cloud-based enterprise collaboration and management platform developed by ByteDance",
    "homepage": "https://www.larksuite.com",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://lf16-larkversion.larksuitecdn.com/obj/lark-version-sg/3c2e9990/Lark-win32_ia32-8.0.3-signed.exe",
            "hash": "7e19af9c333b2b3f5ba2f517dd8c440377d36f75312feaf65cd5285f404a4cb6"
        }
    },
    "shortcuts": [
        [
            "app\\Lark\\Lark.exe",
            "Lark"
        ]
    ],
    "link": "$env:AppData\\LarkInternational",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$InstallDir = '\"' + \"$dir\\app\" + '\"'",
        "$LogDir = '\"' + \"$env:TEMP\\Scoop_$app@$version_logs\" + '\"'",
        "A-Install-App -ArgumentList '--command=quiet_install', \"--target_dir=$InstallDir\", \"--log_dir=$LogDir\"",
        "A-Hold-App"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually 'app'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "ByteDance.Lark",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX86",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x86_user.InstallerSha256"
                }
            }
        }
    }
}
