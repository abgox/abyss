{
    "version": "7.74.22",
    "description": "字节跳动下先进企业协作与管理平台(飞书的国际版本) | A cloud-based enterprise collaboration and management platform developed by ByteDance",
    "homepage": "https://www.larksuite.com",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://lf16-larkversion.larksuitecdn.com/obj/lark-version-sg/d7054cad/Lark-win32_ia32-7.74.22-signed.exe",
            "hash": "bb52f4d683ddb2b38baca27a4a964d3354c1e2b5b18b9c9491db9bb09cd9c6a6"
        }
    },
    "shortcuts": [
        [
            "app\\Lark\\Lark.exe",
            "Lark"
        ]
    ],
    "link": "$env:AppData\\LarkInternational",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$InstallLocation = '\"' + \"$dir\\app\" + '\"'",
        "$LogLocation = '\"' + \"$env:TEMP\\scoop-$app-logs\" + '\"'",
        "A-Install-App -ArgumentList '--command=quiet_install', \"--target_dir=$InstallLocation\", \"--log_dir=$LogLocation\"",
        "A-Hold-App"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually 'app'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "ByteDance.Lark",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX86",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x86_user.InstallerSha256"
                }
            }
        }
    }
}
