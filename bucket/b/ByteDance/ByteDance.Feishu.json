{
    "version": "7.75.18",
    "description": "飞书，字节跳动下先进企业协作与管理平台 | Feishu is a cloud-based enterprise collaboration and management platform developed by ByteDance",
    "homepage": "https://www.feishu.cn",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://sf3-cn.feishucdn.com/obj/ee-appcenter/34cc1b6a/Feishu-win32_ia32-7.75.18-signed.exe",
            "hash": "f38c1e8937b3b3b27523aa92eafe55b58bcf847196ffc536d637a7b1019cf1d4"
        }
    },
    "shortcuts": [
        [
            "app\\Feishu\\Feishu.exe",
            "飞书"
        ]
    ],
    "link": "$env:AppData\\LarkShell",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$InstallLocation = '\"' + \"$dir\\app\" + '\"'",
        "$LogLocation = '\"' + \"$env:TEMP\\scoop-$app-logs\" + '\"'",
        "A-Install-App -ArgumentList '--command=quiet_install', \"--target_dir=$InstallLocation\", \"--log_dir=$LogLocation\"",
        "A-Hold-App"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually 'app'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "ByteDance.Feishu",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX86",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x86_user.InstallerSha256"
                }
            }
        }
    }
}
