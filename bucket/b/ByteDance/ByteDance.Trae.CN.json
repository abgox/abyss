{
    "version": "2.3.76125",
    "description": "字节跳动的一个 AI 驱动的代码 IDE | An AI-powered code IDE by ByteDance",
    "homepage": "https://www.trae.com.cn",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.trae.com.cn/terms-of-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/2.3.76125/win32/TraeCode_CN-Setup-x64.exe",
            "hash": "5f6094515c027477bd53931e2bcd939974911feb3271c2b9d82d7b7daf1b3e52"
        }
    },
    "env_add_path": "app\\bin",
    "commands": "trae-cn",
    "shortcuts": [
        [
            "app\\Trae CN.exe",
            "Trae CN"
        ]
    ],
    "link": [
        "$env:AppData\\Trae CN",
        "$home\\.trae-cn"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://api.trae.com.cn/icube/api/v1/native/version/trae/cn/latest",
        "jsonpath": "$.data.manifest.win32.download[0].x64",
        "regex": "([\\d.]{5,})"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/$version/win32/TraeCode_CN-Setup-x64.exe"
            }
        }
    }
}
