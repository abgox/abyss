{
    "version": "0.19.0",
    "description": "面向智能体生成变更集的优先审阅型终端差异查看器 | A review-first terminal diff viewer for agent-authored changesets",
    "homepage": "https://hunk.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/modem-dev/hunk/releases/download/v0.19.0/hunkdiff-windows-x64.tar.gz",
            "hash": "cf73aa99a3f0f0529d3157eb829720085f2efc04cfcc17efb69600a006ee87d1",
            "extract_dir": "hunkdiff-windows-x64"
        }
    },
    "extract_to": "app",
    "bin": "app\\hunk.exe",
    "link": "$home\\.config\\hunk",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/modem-dev/hunk/releases/download/v$version/hunkdiff-windows-x64.tar.gz"
            }
        }
    }
}
