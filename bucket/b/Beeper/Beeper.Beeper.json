{
    "version": "4.3.73",
    "description": "一个应用，在 iMessage、WhatsApp 和其它 13 个聊天网络上聊天 | A single app to chat on iMessage, WhatsApp, and 13 other chat networks",
    "homepage": "https://www.beeper.com",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.beeper.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://beeper-desktop.download.beeper.com/builds/Beeper%20x64%204.3.73.exe",
            "hash": "174721270f5927bd6489e8ca5d7dc85d7d27773665c0f96bcd4add46cf7acf84"
        }
    },
    "shortcuts": [
        [
            "app\\Beeper.exe",
            "Beeper"
        ]
    ],
    "link": "$env:AppData\\BeeperTexts",
    "cleanup": "$env:LocalAppData\\beepertexts-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Beeper.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Beeper.Beeper",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
