{
    "version": "3.2.8.0",
    "description": "123 云盘，一款云存储服务产品 | A cloud storage service product",
    "homepage": "https://www.123pan.com",
    "license": {
        "identifier": "Freemium",
        "url": "https://www.123pan.com/UserAgreement"
    },
    "architecture": {
        "64bit": {
            "url": "https://app.123957.com/pc-pro/windows/328/123pan_3.2.8.exe",
            "hash": "cdf71051c6571dd61d952971953e8332c598db995f0ebb6920af83fce26d692a"
        }
    },
    "location": "$env:LocalAppData\\123pan",
    "link": "$env:AppData\\123pan\\config.json",
    "cleanup": "$env:AppData\\123pan",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -ArgumentList '/S'",
        "A-Hold-App"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "123.123pan",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
