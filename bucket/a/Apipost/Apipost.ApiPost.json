{
    "version": "8.2.7",
    "description": "AI 驱动的新一代 API 开发管理工具 | AI-driven next-generation API development management tool",
    "homepage": "https://www.apipost.cn",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://img.cdn.apipost.cn/dl/8.2.7/Apipost_win_x64_8.2.7.exe",
            "hash": "4f52f43ef0402f119d1ac2f8e9c6760177768e275ef7f074cc297e05cc4b08dd"
        }
    },
    "shortcuts": [
        [
            "app\\Apipost.exe",
            "Apipost"
        ]
    ],
    "link": "$env:AppData\\Apipost",
    "cleanup": "$env:LocalAppData\\apipost-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall ApiPost.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Apipost.ApiPost",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
