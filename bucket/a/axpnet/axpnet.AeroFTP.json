{
    "version": "4.1.7",
    "description": "一款现代化、多协议的文件管理器与 FTP 客户端，内置人工智能、云端同步功能，并配备军用级加密技术 | A modern, multi-protocol file manager and FTP client with integrated AI, cloud sync, and military-grade encryption",
    "homepage": "https://www.aeroftp.app",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/axpdev-lab/aeroftp/releases/download/v4.1.7/AeroFTP_4.1.7_x64-setup.exe",
            "hash": "2d48973da191a32d8f47adf19cbada5c9e9d7e199cd1d84e9ce4e693718949ed"
        }
    },
    "env_add_path": "app",
    "commands": [
        "aeroftp",
        "aeroftp-cli",
        "aerorsync_serve"
    ],
    "shortcuts": [
        [
            "app\\aeroftp.exe",
            "AeroFTP"
        ]
    ],
    "link": [
        "$env:AppData\\aeroftp",
        "$env:AppData\\com.aeroftp.AeroFTP"
    ],
    "cleanup": "$env:LocalAppData\\com.aeroftp.AeroFTP",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/axpdev-lab/aeroftp/releases/download/v$version/AeroFTP_$version_x64-setup.exe"
            }
        }
    }
}
