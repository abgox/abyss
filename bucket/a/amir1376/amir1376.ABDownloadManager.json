{
    "version": "1.10.0",
    "description": "一款能加快你下载速度的下载管理器 | A download manager that speeds up your downloads",
    "homepage": "https://abdownloadmanager.com",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/amir1376/ab-download-manager/releases/download/v1.10.0/ABDownloadManager_1.10.0_windows_x64.zip",
            "hash": "0ca972e3e3803a7e663165df1200a6517d77e718944ae747236d59f74c6b72ed"
        }
    },
    "extract_dir": "ABDownloadManager",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\ABDownloadManager.exe",
            "ABDownloadManager"
        ]
    ],
    "link": "$home\\.abdm",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/amir1376/ab-download-manager/releases/download/v$version/ABDownloadManager_$version_windows_x64.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
