{
    "version": "1.10.2",
    "description": "一款能加快你下载速度的下载管理器 | A download manager that speeds up your downloads",
    "homepage": "https://abdownloadmanager.com",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/amir1376/ab-download-manager/releases/download/v1.10.2/ABDownloadManager_1.10.2_windows_x64.zip",
            "hash": "014c92e2eb837ffebccd69c7a9c9ed7d8f7e748e216a6dd228d2a4c67ff9f798"
        }
    },
    "extract_dir": "ABDownloadManager",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\ABDownloadManager.exe",
            "ABDownloadManager"
        ]
    ],
    "link": "$home\\.abdm",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/amir1376/ab-download-manager/releases/download/v$version/ABDownloadManager_$version_windows_x64.zip"
            }
        }
    }
}
