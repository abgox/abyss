{
    "version": "5.12.0",
    "description": "一款面向开发者的免费开源代码片段管理器 | A free and open source code snippet manager for developers",
    "homepage": "https://masscode.io",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/massCodeIO/massCode/releases/download/v5.12.0/massCode-5.12.0-x64.exe",
            "hash": "2cc654b43b0a1f8fda695a8752059f90710b3123eec8476bb2a3a2fb149f2694"
        }
    },
    "shortcuts": [
        [
            "app\\massCode.exe",
            "massCode"
        ]
    ],
    "link": [
        "$env:AppData\\masscode",
        "$home\\massCode"
    ],
    "cleanup": "$env:LocalAppData\\masscode-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall massCode.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/massCodeIO/massCode/releases/download/v$version/massCode-$version-x64.exe"
            }
        }
    }
}
