{
    "version": "4.2.3",
    "description": "语雀，阿里巴巴的笔记与文档知识库 | A knowledge base and note-taking tool by Alibaba",
    "homepage": "https://www.yuque.com",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://app.nlark.com/yuque-desktop/4.2.3.1335/BJd150b9224fb742ec915b8c7273f1c91b/Yuque-4.2.3.1335.exe",
            "hash": "0541b03ddcd6bccd92b85b415339ece142c5a6c693cc30afcb6e7397df90f933"
        }
    },
    "shortcuts": [
        [
            "app\\语雀.exe",
            "语雀"
        ]
    ],
    "link": "$env:AppData\\yuque-desktop",
    "cleanup": "$env:LocalAppData\\yuque-desktop-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall 语雀.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Alibaba.Yuque",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
