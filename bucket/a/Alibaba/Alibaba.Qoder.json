{
    "version": "1.33.0",
    "description": "用于现实软件的自主智能编程平台 | Agentic Coding Platform for Real Software",
    "homepage": "https://qoder.com",
    "license": {
        "identifier": "Unknown",
        "url": "https://qoder.com/product-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.qoder.com/release/1.33.0/QoderIDEUserSetup-x64.exe",
            "hash": "819c60e11ae0819e1d8c28a6a8bb10d5af0a3863de209beeab9bb099c640fcfa"
        }
    },
    "env_add_path": "app\\bin",
    "commands": "qoder",
    "shortcuts": [
        [
            "app\\Qoder.exe",
            "Qoder"
        ]
    ],
    "link": [
        "$env:AppData\\Qoder",
        "$home\\.qoder"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest",
            "repo": "QoderAI/changelog"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.qoder.com/release/$version/QoderIDEUserSetup-x64.exe"
            }
        }
    }
}
