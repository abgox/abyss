{
    "version": "2.4.1",
    "description": "一个跨平台桌宠 | A cross-platform desktop pet",
    "homepage": "https://github.com/ayangweb/BongoCat",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ayangweb/BongoCat/releases/download/v2.4.1/BongoCat_2.4.1_x64.exe",
            "hash": "5c70890939c404fa3bfa4399a216ebebb6b96f5f5752f3ae0f9d73473813739b"
        }
    },
    "shortcuts": [
        [
            "app\\bongocat-app.exe",
            "BongoCat"
        ]
    ],
    "link": [
        "$env:AppData\\com.ayangweb.bongo-cat",
        "$env:AppData\\com.ayangweb.BongoCat"
    ],
    "cleanup": "$env:LocalAppData\\com.ayangweb.BongoCat",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ayangweb/BongoCat/releases/download/v$version/BongoCat_$version_x64.exe"
            }
        }
    }
}
