{
    "version": "0.15.1",
    "description": "轻量级代码编辑器 | A lightweight code editor",
    "homepage": "https://athas.dev",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/athasdev/athas/releases/download/v0.15.1/Athas_0.15.1_x64-setup.exe",
            "hash": "67da9671e42ba132f1e09656b75238de260b7478337b8030cd6afb70d6f0423c"
        }
    },
    "shortcuts": [
        [
            "app\\athas-code.exe",
            "Athas"
        ]
    ],
    "link": "$env:AppData\\com.code.athas",
    "cleanup": "$env:LocalAppData\\com.code.athas",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/athasdev/athas/releases/download/v$version/Athas_$version_x64-setup.exe"
            }
        }
    }
}
