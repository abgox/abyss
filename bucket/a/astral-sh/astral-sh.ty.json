            "hash": "d03974c578a0f1842f8548737435ccea415119deaec7ee8d1ebbef716e50fd8c"
        },
        "arm64": {
            "url": "https://github.com/astral-sh/ty/releases/download/0.0.85/ty-aarch64-pc-windows-msvc.zip",
