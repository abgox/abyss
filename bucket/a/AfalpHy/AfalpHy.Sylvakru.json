{
    "version": "4.0.1",
    "description": "一款基于 Flutter 开发、支持本地及自建曲库的跨平台音乐播放器 | A cross-platform music player for local and self-hosted libraries, built with Flutter",
    "homepage": "https://github.com/AfalpHy/sylvakru",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AfalpHy/sylvakru/releases/download/v4.0.1/Sylvakru-4.0.1-Windows.zip",
            "hash": "f3b9db967ef710b27c9ee37a4e484b96d7de0457180295ce4a48d2cd807c32d1"
        }
    },
    "extract_dir": "Release",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\Sylvakru.exe",
            "Sylvakru"
        ]
    ],
    "link": "$env:AppData\\com.afalphy\\sylvakru",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AfalpHy/sylvakru/releases/download/v$version/Sylvakru-$version-Windows.zip"
            }
        }
    }
