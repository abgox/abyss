    "homepage": "https://github.com/appshubcc/Bettbox",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/appshubcc/Bettbox/releases/download/v1.18.10/Bettbox-1.18.10-windows-amd64-setup.exe",
            "hash": "712d4826deed147357955f894945325317c11174bf8a278928bfa69ce291bd3a"
        },
        "arm64": {
            "url": "https://github.com/appshubcc/Bettbox/releases/download/v1.18.10/Bettbox-1.18.10-windows-arm64-setup.exe",
            "hash": "dcad35f789ea60a7962bf4445e42bf71a8844ac3b3f82780d2f373442086bb2e"
        }
    },
    "shortcuts": [
        [
            "app\\Bettbox.exe",
            "Bettbox"
        ]
    ],
    "link": "$env:AppData\\com.appshub\\Bettbox",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually 'app'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/appshubcc/Bettbox/releases/download/v$version/Bettbox-$version-windows-amd64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/appshubcc/Bettbox/releases/download/v$version/Bettbox-$version-windows-arm64-setup.exe"
            }
        }
