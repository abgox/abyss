{
    "version": "1.19.0",
    "description": "一款使用 Mihomo(Clash Meta) 内核、基于 FlClash 早期版本进行重构的多平台网络调试及分流客户端 | A multi-platform network debugging and traffic splitting client based on an early version of FlClash, refactored and powered by the Mihomo (Clash Meta) core",
    "homepage": "https://github.com/appshubcc/Bettbox",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/appshubcc/Bettbox/releases/download/v1.19.0/Bettbox-1.19.0-windows-amd64-setup.exe",
            "hash": "d32ded2a65ecb359d8f21e4af386ed35881f94a780fd541addfe08285ba32968"
        },
        "arm64": {
            "url": "https://github.com/appshubcc/Bettbox/releases/download/v1.19.0/Bettbox-1.19.0-windows-arm64-setup.exe",
            "hash": "983c77d156a6678e7b539f16843dec08ef3b5456a4b7b7b7fa14351f1010726b"
        }
    },
    "shortcuts": [
        [
            "app\\Bettbox.exe",
            "Bettbox"
        ]
    ],
    "link": "$env:AppData\\com.appshub\\Bettbox",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually 'app'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/appshubcc/Bettbox/releases/download/v$version/Bettbox-$version-windows-amd64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/appshubcc/Bettbox/releases/download/v$version/Bettbox-$version-windows-arm64-setup.exe"
            }
        }
    }
}
