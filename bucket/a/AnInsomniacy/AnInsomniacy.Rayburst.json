{
    "version": "4.0.1",
    "description": "一款功能齐全的下载管理器 | A full-featured download manager",
    "homepage": "https://rayburst.pages.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.0.1/Rayburst_4.0.1_x64-setup.exe",
            "hash": "51692dbe1ca668d58541ab8a04ed9c305740a89155b7de33e456e7f41d12f090"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.0.1/Rayburst_4.0.1_arm64-setup.exe",
            "hash": "c6b52af536a6c7f91d37beffa37dd209557765b60f65444612db4ad17f3dd89e"
        }
    },
    "location": "$env:ProgramFiles\\Rayburst",
    "link": [
        "$env:AppData\\dev.aninsomniacy.rayburst",
        "$env:LocalAppData\\dev.aninsomniacy.rayburst"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_arm64-setup.exe"
            }
        }
    }
}
