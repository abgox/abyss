{
    "version": "4.1.0",
    "description": "一款功能齐全的下载管理器 | A full-featured download manager",
    "homepage": "https://rayburst.pages.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.1.0/Rayburst_4.1.0_x64-setup.exe",
            "hash": "93d3fc70477ab70e627289ea4fab8c7901f4383e0f56eca81cc59c9ff9ce594a"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.1.0/Rayburst_4.1.0_arm64-setup.exe",
            "hash": "bb884e08baaed3ee8eeacbd2d6e7d888c59106967076f8e454c8a85526969ac5"
        }
    },
    "location": "$env:ProgramFiles\\Rayburst",
    "link": [
        "$env:AppData\\dev.aninsomniacy.rayburst",
        "$env:LocalAppData\\dev.aninsomniacy.rayburst"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_arm64-setup.exe"
            }
        }
    }
}
