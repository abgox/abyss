{
    "version": "1.10.1",
    "description": "一款 Scoop 的桌面图形化界面 | A desktop GUI for Scoop",
    "homepage": "https://amarbego.github.io/Rscoop",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AmarBego/Rscoop/releases/download/v1.10.1/rscoop.exe",
            "hash": "abf7f2a9ba30dc27d60cedf5e5c9f0bcac350c8ee370cb180c3d5558ff5dde96"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\rscoop.exe",
            "Rscoop"
        ]
    ],
    "link": "$env:AppData\\com.rscoop.app",
    "cleanup": [
        "$env:LocalAppData\\rscoop",
        "$env:LocalAppData\\com.rscoop.app"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AmarBego/Rscoop/releases/download/v$version/rscoop.exe"
            }
        }
    }
}
