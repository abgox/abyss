{
    "version": "1.10.0",
    "description": "一款 Scoop 的桌面图形化界面 | A desktop GUI for Scoop",
    "homepage": "https://amarbego.github.io/Rscoop",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AmarBego/Rscoop/releases/download/v1.10.0/rscoop.exe",
            "hash": "551b8c53b69114ad55e59a9039b7bcf05f17761f5c190bb478b46fbdf067d3db"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\rscoop.exe",
            "Rscoop"
        ]
    ],
    "link": "$env:AppData\\com.rscoop.app",
    "cleanup": [
        "$env:LocalAppData\\rscoop",
        "$env:LocalAppData\\com.rscoop.app"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AmarBego/Rscoop/releases/download/v$version/rscoop.exe"
            }
        }
    }
}
