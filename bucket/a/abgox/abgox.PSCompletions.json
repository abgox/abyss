    "notes_cn": [
        "PowerShell: Import-Module PSCompletions  (写入 $PROFILE 可每次启动自动加载)",
        "bash: source \"<dir>/PSCompletions.bash\"  (写入 ~/.bashrc)",
        "zsh: source \"<dir>/PSCompletions.zsh\"  (写入 ~/.zshrc)",
        "fish: ln -sf \"<dir>/PSCompletions.fish\" ~/.config/fish/conf.d/PSCompletions.fish",
        "文档: https://pscompletions.abgox.com/docs/shells"
    ],
    "notes": [
        "PowerShell: Import-Module PSCompletions  (add to $PROFILE to auto-import)",
        "bash: source \"<dir>/PSCompletions.bash\"  (add to ~/.bashrc)",
        "zsh: source \"<dir>/PSCompletions.zsh\"  (add to ~/.zshrc)",
        "fish: ln -sf \"<dir>/PSCompletions.fish\" ~/.config/fish/conf.d/PSCompletions.fish",
        "Docs: https://pscompletions.abgox.com/docs/shells"
    ],
    "url": "https://cdn.powershellgallery.com/packages/pscompletions.8.0.5.nupkg",
