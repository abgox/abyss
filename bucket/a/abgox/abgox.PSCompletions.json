{
    "version": "7.5.1",
    "description": "适用于 PowerShell 的 Tab 补全管理器，基于 Rust 引擎与交互式菜单 | A tab-completion manager for PowerShell, powered by Rust engine and interactive menu",
    "homepage": "https://pscompletions.abgox.com",
    "license": {
        "identifier": "MIT"
    },
    "notes_cn": [
        "使用此模块: Import-Module PSCompletions",
        "将它写入 $PROFILE 中，即可在每次启动时自动加载。"
    ],
    "notes": [
        "Use this module: Import-Module PSCompletions",
        "Add to $PROFILE to auto-import on startup."
    ],
    "url": "https://cdn.powershellgallery.com/packages/pscompletions.7.5.1.nupkg",
    "hash": "f2a8c8e24641e17c9ce113cfc7ab390d379a298ac575c821a9b571fd244e770e",
    "env_set": {
        "PSCOMPLETIONS_DATA_DIR": "$dir\\data"
    },
    "psmodule": {
        "name": "PSCompletions"
    },
    "persist": [
        [
            "data",
            "data"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "psgallery": {
            "channel": "stable"
        }
    },
    "autoupdate": {
        "url": "https://cdn.powershellgallery.com/packages/pscompletions.$version.nupkg"
    }
}
