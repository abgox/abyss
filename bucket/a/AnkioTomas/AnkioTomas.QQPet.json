{
    "version": "0.7.3",
    "description": "QQ 宠物的跨平台复刻版本 | Cross-platform remake version of QQ Pet",
    "homepage": "https://pet.ankio.net",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnkioTomas/qqpet/releases/download/v0.7.3/QQPet.Setup.0.7.3.exe",
            "hash": "fb9630c7b36c785dbad8b6fb03e3523b258e55ac0822245d8411f7708a201e86"
        }
    },
    "shortcuts": [
        [
            "app\\QQPet.exe",
            "QQPet"
        ]
    ],
    "link": "$env:AppData\\QQPet",
    "cleanup": "$env:LocalAppData\\qqpet-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall QQPet.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnkioTomas/qqpet/releases/download/v$version/QQPet.Setup.$version.exe"
            }
        }
    }
}
