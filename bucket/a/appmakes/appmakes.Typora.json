{
    "version": "1.14.10",
    "description": "一个 Markdown 编辑器和阅读器，所见即所得 | A Markdown editor and reader",
    "homepage": "https://typora.io",
    "license": {
        "identifier": "Proprietary",
        "url": "https://support.typora.io/License-Agreement/"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloads.typora.io/windows/typora-setup-x64-1.14.10.exe",
            "hash": "2e2505e3a2bfdf9dea1b732a7bf7210873b9c841802a0d4c22b5bb75bf9ff7d4"
        }
    },
    "bin": "app\\Typora.exe",
    "shortcuts": [
        [
            "app\\Typora.exe",
            "Typora"
        ]
    ],
    "link": "$env:AppData\\Typora",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://typora.io/releases/windows_64.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.typora.io/windows/typora-setup-x64-$version.exe"
            }
        }
    }
}
