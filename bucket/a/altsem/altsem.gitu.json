{
    "version": "0.44.0",
    "description": "一个受 Magit 启发的 Git 终端用户界面 (TUI) | A terminal user interface (TUI) for Git inspired by Magit",
    "homepage": "https://github.com/altsem/gitu",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/altsem/gitu/releases/download/v0.44.0/gitu-v0.44.0-x86_64-pc-windows-msvc.zip",
            "hash": "d732619d850a07f6ed65ee3f901b879fff5f8a4585f196a0dfcd1b15c7cfc16c",
            "extract_dir": "gitu-v0.44.0-x86_64-pc-windows-msvc"
        }
    },
    "extract_to": "app",
    "bin": "app\\gitu.exe",
    "link": "$env:AppData\\gitu",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/altsem/gitu/releases/download/v$version/gitu-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "gitu-v$version-x86_64-pc-windows-msvc"
            }
        }
    }
}
