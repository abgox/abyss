{
    "version": "0.7.6",
    "description": "一款用于管理 GitHub 仓库的收藏/点赞的应用 | An app for managing github starred repositories",
    "homepage": "https://gsm.aminta.top",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AmintaCCCP/GithubStarsManager/releases/download/v0.7.6/GitHub.Stars.Manager.Setup.0.7.6.exe",
            "hash": "ddb9b3999632da77d64883785c03d79c392f702e91059264f2225629a069d185"
        }
    },
    "shortcuts": [
        [
            "app\\GitHub Stars Manager.exe",
            "GitHub Stars Manager"
        ]
    ],
    "link": "$env:AppData\\github-stars-manager",
    "cleanup": "$env:LocalAppData\\github-stars-manager-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall GitHub Stars Manager.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AmintaCCCP/GithubStarsManager/releases/download/v$version/GitHub.Stars.Manager.Setup.$version.exe"
            }
        }
    }
}
