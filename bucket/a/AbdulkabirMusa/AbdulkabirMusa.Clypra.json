{
    "version": "1.3.0",
    "description": "一款现代化的开源视频编辑器，配备专业的时间轴界面 | A modern, open-source video editor featuring a professional timeline interface",
    "homepage": "https://clypra.abdulkabirmusa.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AIEraDev/Clypra/releases/download/v1.3.0/Clypra_1.3.0_x64-setup.exe",
            "hash": "ee2217099e0aa35bee550c94df519fd9c5ff5f067828ee9bea4ff6674e76652a"
        }
    },
    "shortcuts": [
        [
            "app\\Clypra.exe",
            "Clypra"
        ]
    ],
    "link": "$env:AppData\\com.clypra.editor",
    "cleanup": "$env:LocalAppData\\com.clypra.editor",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AIEraDev/Clypra/releases/download/v$version/Clypra_$version_x64-setup.exe"
            }
        }
    }
}
