{
    "version": "8.5.9",
    "description": "一款适用于所有平台、功能丰富的 GraphQL 客户端 | A beautiful feature-rich GraphQL Client for all platforms",
    "homepage": "https://altairgraphql.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/altair-graphql/altair/releases/download/v8.5.9/altair_8.5.9_x64_win.exe",
            "hash": "b7a3f383a4e9791f73bb8b00cdc023c4183019542bdb4ef33ff935b248ca81b9"
        }
    },
    "shortcuts": [
        [
            "app\\Altair GraphQL Client.exe",
            "Altair GraphQL Client"
        ]
    ],
    "link": "$env:AppData\\Altair GraphQL Client",
    "cleanup": "$env:LocalAppData\\altair-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Altair GraphQL Client.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/altair-graphql/altair/releases/download/v$version/altair_$version_x64_win.exe"
            }
        }
    }
}
