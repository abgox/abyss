{
    "version": "0.56.3-alpha",
    "description": "本地优先、端到端加密的软件，用于创建和存储任务、笔记、想法、文档、工作流等 | Local-first, E2E encrypted software for creating and storing tasks, notes, ideas, documents, workflows, and more",
    "homepage": "https://anytype.io",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/anyproto/anytype-ts/releases/download/v0.56.3-alpha/Anytype.Setup.0.56.3-alpha.exe",
            "hash": "ab7a751f9e0bb01f800b92a828ba97f7265b1ea983085d1d1395558dba0ae87d"
        }
    },
    "shortcuts": [
        [
            "app\\Anytype.exe",
            "Anytype"
        ]
    ],
    "link": "$env:AppData\\anytype",
    "cleanup": "$env:LocalAppData\\anytype-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Anytype.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/anyproto/anytype-ts/releases/download/v$version/Anytype.Setup.$version.exe"
            }
        }
    }
}
