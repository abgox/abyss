{
    "version": "0.56.6-beta",
    "description": "本地优先、端到端加密的软件，用于创建和存储任务、笔记、想法、文档、工作流等 | Local-first, E2E encrypted software for creating and storing tasks, notes, ideas, documents, workflows, and more",
    "homepage": "https://anytype.io",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/anyproto/anytype-ts/releases/download/v0.56.6-beta/Anytype.Setup.0.56.6-beta.exe",
            "hash": "8698fd4a6cccc45646ce968e89ad040f9a27ce1b926a669de23313187e4a8d84"
        }
    },
    "shortcuts": [
        [
            "app\\Anytype.exe",
            "Anytype"
        ]
    ],
    "link": "$env:AppData\\anytype",
    "cleanup": "$env:LocalAppData\\anytype-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Anytype.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/anyproto/anytype-ts/releases/download/v$version/Anytype.Setup.$version.exe"
            }
        }
    }
