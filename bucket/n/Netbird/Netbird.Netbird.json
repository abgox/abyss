    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/netbirdio/netbird/releases/download/v0.81.1/netbird_installer_0.81.1_windows_amd64.exe",
            "hash": "7e7dbb2216f17a5a35a5fb6a176f8c013996f7824fdeffa7993eda9ff150a11b"
        },
        "arm64": {
            "url": "https://github.com/netbirdio/netbird/releases/download/v0.81.1/netbird_installer_0.81.1_windows_arm64.exe",
