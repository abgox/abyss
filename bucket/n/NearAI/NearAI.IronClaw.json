{
    "version": "1.4.0",
    "description": "安全、开源的 OpenClaw 替代方案，运行在 NEAR AI 云的加密环境中 | The secure, open-source alternative to OpenClaw that runs in encrypted enclaves on NEAR AI Cloud",
    "homepage": "https://www.ironclaw.com",
    "license": {
        "identifier": "Apache-2.0|MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nearai/ironclaw/releases/download/ironclaw-v1.4.0/ironclaw-x86_64-pc-windows-msvc.tar.gz",
            "hash": "a2195a7788e108701151411557220c2e0cb841204f7a68b4bbd59de65e7d46cc",
            "extract_dir": "ironclaw-x86_64-pc-windows-msvc"
        }
    },
    "extract_to": "app",
    "bin": "app\\ironclaw.exe",
    "link": "$home\\.ironclaw",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        },
        "regex": "ironclaw-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nearai/ironclaw/releases/download/ironclaw-v$version/ironclaw-x86_64-pc-windows-msvc.tar.gz"
            }
        }
    }
}
