{
    "version": "0.12.6",
    "description": "一个旨在重构 Vim 的文本编辑器项目 | A project that seeks to aggressively refactor Vim",
    "homepage": "https://neovim.io",
    "license": {
        "identifier": "Apache-2.0|Vim"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/neovim/neovim/releases/download/v0.12.6/nvim-win64.zip",
            "hash": "4e12b7103b601ffc8f25954b4da100f339faa73dccb69a5b135e897fa3d893ed"
        }
    },
    "extract_dir": "nvim-win64",
    "extract_to": "app",
    "bin": [
        "app\\bin\\nvim.exe",
        "app\\bin\\xxd.exe"
    ],
    "shortcuts": [
        [
            "app\\bin\\nvim.exe",
            "Neovim"
        ]
    ],
    "link": [
        "$env:LocalAppData\\nvim",
        "$env:LocalAppData\\nvim-data"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/neovim/neovim/releases/download/v$version/nvim-win64.zip"
            }
        }
    }
}
