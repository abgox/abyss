{
    "version": "2.8.1",
    "description": "一款极简主义的护眼提醒应用，旨在减轻长时间使用屏幕时的眼睛疲劳 | A minimalist eye-care reminder app designed to reduce eye strain during extended screen usage",
    "homepage": "https://blinkeye.app",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nomandhoni-cs/blink-eye/releases/download/v2.8.1/Blink.Eye_2.8.1_x64-setup.exe",
            "hash": "4eb61e6150a2ffd58d269a372109e729d210abab1100d5fceab69b2a13b3a143"
        }
    },
    "shortcuts": [
        [
            "app\\Blink-Eye.exe",
            "Blink Eye"
        ]
    ],
    "link": "$env:AppData\\com.blinkeye.app",
    "cleanup": "$env:LocalAppData\\com.blinkeye.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nomandhoni-cs/blink-eye/releases/download/v$version/Blink.Eye_$version_x64-setup.exe"
            }
        }
    }
}
