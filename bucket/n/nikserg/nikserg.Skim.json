{
    "version": "1.0.31",
    "description": "一款轻快、简约的 AI 邮件客户端 | A fast, minimalist, AI email client",
    "homepage": "https://skim-tech.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nikserg/skim/releases/download/v1.0.31/Skim_1.0.31_x64-setup.exe",
            "hash": "6e3326431c328f706e523b626ebddd93ed51cd0ad7c6234dad15fcac325ef533"
        }
    },
    "shortcuts": [
        [
            "app\\Skim.exe",
            "Skim"
        ]
    ],
    "link": "$env:AppData\\com.skim.app",
    "cleanup": "$env:LocalAppData\\com.skim.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nikserg/skim/releases/download/v$version/Skim_$version_x64-setup.exe"
            }
        }
    }
}
