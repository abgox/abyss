            "hash": "cae77605438b802915e16743a779214814b74db3d5d090033ad5a025387c8980"
        },
        "arm64": {
            "url": "https://github.com/nushell/nightly/releases/download/0.114.2-nightly.35+69a2733/nu-0.114.2-nightly.35-aarch64-pc-windows-msvc.zip",
            "hash": "c64825132afe66d8f8ca68551de506f3b744668208d7aded347846c893819c63"
        }
