{
    "version": "1.7.0",
    "description": "一款开源、简洁、高颜值的酷狗音乐第三方客户端 | An open-source, concise, and aesthetically pleasing third-party client for KuGou Music",
    "homepage": "https://music.moekoe.cn",
    "license": {
        "identifier": "GPL-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/iAJue/MoeKoeMusic/releases/download/v1.7.0/MoeKoe_Music_Setup_v1.7.0.exe",
            "hash": "b02de80501845eccbeedb0bf864df9073add0485398e6024b37c8782e7cf327c"
        }
    },
    "shortcuts": [
        [
            "app\\MoeKoe Music.exe",
            "MoeKoe Music"
        ]
    ],
    "link": "$env:AppData\\moekoemusic",
    "cleanup": "$env:LocalAppData\\moekoemusic-updater",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall MoeKoe Music.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iAJue/MoeKoeMusic/releases/download/v$version/MoeKoe_Music_Setup_v$version.exe"
            }
        }
    }
}
