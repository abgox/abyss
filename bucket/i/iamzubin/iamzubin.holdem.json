{
    "version": "3.1.1",
    "description": "一款开源应用程序，它提供了一个临时的拖放存放区域，以便在桌面上更轻松地进行文件管理和多任务处理 | An open-source app that provides a temporary drag-and-drop holding area for easier file management and multitasking on desktop",
    "homepage": "https://github.com/iamzubin/holdem",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/iamzubin/holdem/releases/download/3.1.1/holdem_3.1.1_x64-setup.exe",
            "hash": "96c76ef8c7f63400a038e7061c8696b9e2e819f5e8061ce78a6ddbd4c13a556b"
        }
    },
    "shortcuts": [
        [
            "app\\holdem.exe",
            "Holdem"
        ]
    ],
    "link": "$env:AppData\\com.holdem.app",
    "cleanup": "$env:LocalAppData\\com.holdem.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iamzubin/holdem/releases/download/$version/holdem_$version_x64-setup.exe"
            }
        }
    }
}
