{
    "version": "1.2.7",
    "description": "集成 AI 能力的下一代远程终端应用，支持多工作空间、SSH 连接和智能命令执行 | Next-gen AI-powered remote terminal with multi-workspace, SSH connections and intelligent command execution",
    "homepage": "https://www.iaterm.ai",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/infiniact/homebrew-iaterm/releases/download/v1.2.7/IATerm_1.2.7_x64-setup.exe",
            "hash": "7030b8f8fac771d2b452a82f24040e9d7e4f64c47700f5e81ada05a265539ffd"
        }
    },
    "shortcuts": [
        [
            "app\\iaterm.exe",
            "IATerm"
        ]
    ],
    "link": "$env:AppData\\com.infiniact.iaterm",
    "cleanup": "$env:LocalAppData\\com.infiniact.iaterm",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/infiniact/homebrew-iaterm/releases/download/v$version/IATerm_$version_x64-setup.exe"
            }
        }
    }
}
