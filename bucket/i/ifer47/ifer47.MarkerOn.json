{
    "version": "2.10.2",
    "description": "支持点击穿透模式的轻量级开源屏幕标注工具 | Lightweight open-source screen annotation tool with click-through mode",
    "homepage": "https://ifer47.github.io/markeron",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ifer47/markeron/releases/download/v2.10.2/MarkerOn_2.10.2_x64-setup.exe",
            "hash": "61344adfc8442b7b9064eb3de954863c751606febf749e64ccb2a5d0338fd117"
        }
    },
    "shortcuts": [
        [
            "app\\MarkerOn.exe",
            "MarkerOn"
        ]
    ],
    "link": "$env:AppData\\com.markeron.app",
    "cleanup": "$env:LocalAppData\\com.markeron.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ifer47/markeron/releases/download/v$version/MarkerOn_$version_x64-setup.exe"
            }
        }
    }
}
