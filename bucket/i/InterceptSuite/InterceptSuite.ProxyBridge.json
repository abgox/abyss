    "homepage": "https://interceptsuite.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/InterceptSuite/ProxyBridge/releases/download/v4.1.0/ProxyBridge-Setup-4.1.0.exe",
            "hash": "8a15463c9309d543defa20420187042c3653d4fbd9c3a9e0d44df8e7775cb8be"
        }
    },
    "bin": [
        "app\\ProxyBridge.exe",
        "app\\ProxyBridge_CLI.exe"
    ],
    "shortcuts": [
        [
            "app\\ProxyBridge.exe",
            "ProxyBridge"
        ]
    ],
    "link": "$env:AppData\\ProxyBridge",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninst.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/InterceptSuite/ProxyBridge/releases/download/v$version/ProxyBridge-Setup-$version.exe"
            }
        }
    }
