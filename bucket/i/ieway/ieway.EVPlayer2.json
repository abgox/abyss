{
    "version": "5.0.4",
    "description": "在线观看加密视频的播放器 | A player that allows online viewing of encrypted videos",
    "homepage": "https://www.ieway.cn/evplayer2.html",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://ctpublic.ieway.cn/public/download/EVPlayer2_v5.0.4.exe",
            "hash": "51a574283817484045e3f4d16086b637b4db19a2a3ecfdc8603579d55725f441"
        }
    },
    "location": "$env:ProgramFiles\\EVPlayer2",
    "link": "$env:LocalAppData\\EVPlayer2",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'Uninstaller\\unins000.exe' -ArgumentList '/VerySilent'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App -ArgumentList '/VerySilent'"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://www.ieway.cn/evplayer2.html",
        "regex": "EVPlayer2_v([\\d.]+).exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://ctpublic.ieway.cn/public/download/EVPlayer2_v$version.exe"
            }
        }
    }
