{
    "version": "12.66.0",
    "description": "为你的单机游戏提供海量免费模组和修改器 | Thousands of free mods and trainers for your favorite single-player PC games",
    "homepage": "https://wand.com",
    "license": {
        "identifier": "Freemium",
        "url": "https://www.wand.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://storage-cdn.wemod.com/app/releases/stable/Wand-12.66.0-full.nupkg",
            "hash": "6be4513733f61b2dca48a35fbec32c0cf748c512dc2bc46a2e192dc4a4920b28"
        }
    },
    "extract_dir": "lib\\net45",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\Wand.exe",
            "Wand"
        ]
    ],
    "link": [
        "$env:AppData\\Wand",
        "$env:LocalAppData\\Wand",
        "$home\\Videos\\Wand"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "New-Item -ItemType Junction -Path \"$env:LocalAppData\\Wand\\app-$version\" -Target \"$dir\\app\" | Out-Null"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "Remove-Item -Path \"$env:LocalAppData\\Wand\\app-$($manifest.version)\" -Recurse -Force",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://api.wemod.com/client/channels/stable/RELEASES",
        "regex": "Wand-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://storage-cdn.wemod.com/app/releases/stable/Wand-$version-full.nupkg"
            }
        }
    }
}
