{
    "version": "1.3.1",
    "description": "开源免费的 HTTP(S) 流量捕获软件 | Open source free capture HTTP(S) traffic software",
    "homepage": "https://github.com/wanghongenpin/proxypin",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/wanghongenpin/proxypin/releases/download/v1.3.1/proxypin-windows-setup.exe",
            "hash": "ad725a7bf317fb20c16bbe14d64aca240873b668f137784043b4ad5c5ef19dd0"
        }
    },
    "shortcuts": [
        [
            "app\\ProxyPin.exe",
            "ProxyPin"
        ]
    ],
    "link": [
        "$home\\.proxypin",
        "$env:AppData\\com.proxy.pin\\ProxyPin"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wanghongenpin/proxypin/releases/download/v$version/proxypin-windows-setup.exe"
            }
        }
    }
