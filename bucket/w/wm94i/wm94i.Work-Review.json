{
    "version": "1.1.1",
    "description": "工作回顾与 AI 日报助手 | Work review and AI daily report assistant",
    "homepage": "https://github.com/wm94i/Work_Review",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/wm94i/Work_Review/releases/download/v1.1.1/Work_Review_1.1.1_x64-setup.exe",
            "hash": "dd69ab4465306d6c0d28e5940e8991e70bd64219384c2987b3a373c56b4d42be"
        }
    },
    "shortcuts": [
        [
            "app\\Work_Review.exe",
            "Work Review"
        ]
    ],
    "link": "$env:AppData\\work-review",
    "cleanup": "$env:LocalAppData\\com.workreview.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wm94i/Work_Review/releases/download/v$version/Work_Review_$version_x64-setup.exe"
            }
        }
    }
}
