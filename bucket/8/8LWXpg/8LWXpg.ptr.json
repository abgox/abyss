{
    "version": "0.15.2",
    "description": "一个用于管理 PowerToys Run 插件的命令行工具。它可用于安装、卸载、更新、列出和导入插件 | A cli tool to manage PowerToys Run plugins. It can be used to install, uninstall, update, list, and import plugins",
    "homepage": "https://github.com/8LWXpg/ptr",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/8LWXpg/ptr/releases/download/v0.15.2/ptr-x86_64-pc-windows-msvc.zip",
            "hash": "5baaa6552a2d922475fcbcca899b2a1a6cf1283814dbcf8f6f1e66d4cdf23ee9"
        },
        "arm64": {
            "url": "https://github.com/8LWXpg/ptr/releases/download/v0.15.2/ptr-aarch64-pc-windows-msvc.zip",
            "hash": "dcdb624c1f5bb1dbfc21a9bdbd635abed7ea65bab455420b348b5b6233b8e994"
        }
    },
    "extract_to": "app",
    "bin": "app\\ptr.exe",
    "link": "$env:LocalAppData\\Microsoft\\PowerToys\\PowerToys Run\\Plugins\\version.toml",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/8LWXpg/ptr/releases/download/v$version/ptr-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/8LWXpg/ptr/releases/download/v$version/ptr-aarch64-pc-windows-msvc.zip"
