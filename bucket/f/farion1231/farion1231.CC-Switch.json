{
    "version": "4.0.6",
    "description": "适用于 Claude Code、Codex、OpenCode、OpenClaw 以及 Gemini CLI 的全方位管理工具 | The All-in-One Manager for Claude Code, Codex, OpenCode, OpenClaw & Gemini CLI",
    "homepage": "https://ccswitch.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/farion1231/cc-switch/releases/download/v4.0.6/CC-Switch-v4.0.6-Windows-Portable.zip",
            "hash": "e5d4b80d90826d38997b779c864fab40c075174cad6224d40373581076d3d82c"
        },
        "arm64": {
            "url": "https://github.com/farion1231/cc-switch/releases/download/v4.0.6/CC-Switch-v4.0.6-Windows-arm64-Portable.zip",
            "hash": "629fdcd3cd014d4fda7ae24fcfd80e7043a5a8ebbbfa11a4e4130bf278e378de"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\cc-switch.exe",
            "CC-Switch"
        ]
    ],
    "link": "$home\\.cc-switch",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/farion1231/cc-switch/releases/download/v$version/CC-Switch-v$version-Windows-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/farion1231/cc-switch/releases/download/v$version/CC-Switch-v$version-Windows-arm64-Portable.zip"
            }
        }
    }
}
