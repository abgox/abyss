{
    "version": "2.1.4",
    "description": "适用于 Windows 的快速文件搜索和应用程序启动器 | Quick file searcher and app launcher with community-made plugins",
    "homepage": "https://www.flowlauncher.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Flow-Launcher/Flow.Launcher/releases/download/v2.1.4/Flow-Launcher-Portable.zip",
            "hash": "32cd448751863eca7a4fa9ee282bb6fe4e617ec1c8f23af707796a72279ba1d8"
        }
    },
    "extract_dir": "FlowLauncher\\app-2.1.4",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\Flow.Launcher.exe",
            "Flow Launcher"
        ]
    ],
    "persist": [
        [
            "app\\UserData",
            "AppData\\Roaming\\FlowLauncher"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Flow-Launcher/Flow.Launcher/releases/download/v$version/Flow-Launcher-Portable.zip"
            }
        },
        "extract_dir": "FlowLauncher\\app-$version"
    }
}
