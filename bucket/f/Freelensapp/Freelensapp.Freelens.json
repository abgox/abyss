{
    "version": "2.0.0",
    "description": "一个免费且开源的用户界面，专为管理 Kubernetes 集群而设计 | A free and open-source user interface designed for managing Kubernetes clusters",
    "homepage": "https://freelensapp.github.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/freelensapp/freelens/releases/download/v2.0.0/Freelens-2.0.0-windows-amd64.msi",
            "hash": "08ccae8beabc2cd9bd789a2a8883ba5c8d9093a92fdfb2abcadd76c38603e483"
        },
        "arm64": {
            "url": "https://github.com/freelensapp/freelens/releases/download/v2.0.0/Freelens-2.0.0-windows-arm64.msi",
            "hash": "9ad9570204f153ca9c4adad8051556211622c59765a517be19e38dd261d72c92"
        }
    },
    "extract_dir": "freelens",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\Freelens.exe",
            "Freelens"
        ]
    ],
    "link": [
        "$env:AppData\\Freelens",
        "$home\\.freelens"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/freelensapp/freelens/releases/download/v$version/Freelens-$version-windows-amd64.msi"
            },
            "arm64": {
                "url": "https://github.com/freelensapp/freelens/releases/download/v$version/Freelens-$version-windows-arm64.msi"
            }
        }
    }
}
