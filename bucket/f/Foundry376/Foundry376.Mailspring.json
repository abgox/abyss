{
    "version": "1.25.0",
    "description": "一个漂亮，快速，完全开源的邮件客户端 | A beautiful, fast and fully open source mail client",
    "homepage": "https://github.com/Foundry376/Mailspring",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Foundry376/Mailspring/releases/download/1.25.0/MailspringSetup.exe",
            "hash": "ebdddf7635531d89d81fd92b23d8f6bbda62c462c4d2229f433f65e6c22b126b"
        }
    },
    "location": "$env:LocalAppData\\Mailspring",
    "link": "$env:AppData\\Mailspring",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'Update.exe' -ArgumentList '--silent'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App -ArgumentList '--uninstall'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Foundry376/Mailspring/releases/download/$version/MailspringSetup.exe"
            }
        }
    }
}
