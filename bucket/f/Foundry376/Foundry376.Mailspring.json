{
    "version": "1.24.1",
    "description": "一个漂亮，快速，完全开源的邮件客户端 | A beautiful, fast and fully open source mail client",
    "homepage": "https://github.com/Foundry376/Mailspring",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Foundry376/Mailspring/releases/download/1.24.1/MailspringSetup.exe",
            "hash": "0122003f943ccfaabbc8aabc7a7610eb773d37e8b29fd2c50e4a565ebc0dc190"
        }
    },
    "location": "$env:LocalAppData\\Mailspring",
    "link": "$env:AppData\\Mailspring",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'Update.exe' -ArgumentList '--silent'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App -ArgumentList '--uninstall'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Foundry376/Mailspring/releases/download/$version/MailspringSetup.exe"
            }
        }
    }
}
