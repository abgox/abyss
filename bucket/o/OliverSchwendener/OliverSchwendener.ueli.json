{
    "version": "9.29.1",
    "description": "跨平台的按键启动器 | Cross-Platform Keystroke Launcher",
    "homepage": "https://ueli.app",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/oliverschwendener/ueli/releases/download/v9.29.1/Ueli-Setup-9.29.1.exe",
            "hash": "d60b26136b5c08362c51c1863ff3be545b34e46366cbc6ff602e8fbe9bbca166"
        }
    },
    "shortcuts": [
        [
            "app\\Ueli.exe",
            "Ueli"
        ]
    ],
    "link": "$env:AppData\\ueli",
    "cleanup": "$env:LocalAppData\\ueli-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Ueli.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/oliverschwendener/ueli/releases/download/v$version/Ueli-Setup-$version.exe"
            }
        }
    }
}
