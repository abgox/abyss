                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/oxc-project/oxc/releases/download/oxfmt_v0.70.0/oxfmt-aarch64-pc-windows-msvc.zip",
            "hash": "b37fc6b1f42715b0cf6a176d2fdf6bbcb7c42976c8316dd0ddb9dd025413af1e",
