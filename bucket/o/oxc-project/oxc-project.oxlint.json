                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/oxc-project/oxc/releases/download/oxlint_v1.90.0/oxlint-aarch64-pc-windows-msvc.zip",
            "hash": "e10d6cbb8d034e0c7dbe1a90c191d2079e654af250493eac2867299773b71c38",
