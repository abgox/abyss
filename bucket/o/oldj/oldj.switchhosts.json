{
    "version": "5.0.3",
    "description": "一个管理、切换多个 hosts 方案的工具，快速切换 hosts | An App for hosts management & switching. Switch hosts quickly",
    "homepage": "https://switchhosts.app",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/oldj/SwitchHosts/releases/download/v5.0.3/SwitchHosts-5.0.3-windows-x64-setup.exe",
            "hash": "0f0af3e5f4bae316eede8ff1299f15e7cca8da81be33e3aac7153a278d434ed1"
        },
        "arm64": {
            "url": "https://github.com/oldj/SwitchHosts/releases/download/v5.0.3/SwitchHosts-5.0.3-windows-arm64-setup.exe",
            "hash": "b3bea32d1fb489af5acf21bcf58fab1eaf0b5b15c417abd8caec6583c834ad40"
        }
    },
    "shortcuts": [
        [
            "app\\switchhosts.exe",
            "SwitchHosts"
        ]
    ],
    "link": "$home\\.SwitchHosts",
    "cleanup": "$env:LocalAppData\\net.oldj.switchhosts",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/oldj/SwitchHosts/releases/download/v$version/SwitchHosts-$version-windows-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/oldj/SwitchHosts/releases/download/v$version/SwitchHosts-$version-windows-arm64-setup.exe"
            }
        }
    }
}
