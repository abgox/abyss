{
    "version": "5.0.2",
    "description": "一个管理、切换多个 hosts 方案的工具，快速切换 hosts | An App for hosts management & switching. Switch hosts quickly",
    "homepage": "https://switchhosts.app",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/oldj/SwitchHosts/releases/download/v5.0.2/SwitchHosts-5.0.2-windows-x64-setup.exe",
            "hash": "8eac40bb459ebdf949ddc593a4d857003253bc8ccb49ef228e20875c118aac04"
        },
        "arm64": {
            "url": "https://github.com/oldj/SwitchHosts/releases/download/v5.0.2/SwitchHosts-5.0.2-windows-arm64-setup.exe",
            "hash": "46b0d1ae05884ca6d3a12c8b5bc062f3dbe276affd44d09aea7f11b9e8fda55e"
        }
    },
    "shortcuts": [
        [
            "app\\switchhosts.exe",
            "SwitchHosts"
        ]
    ],
    "link": "$home\\.SwitchHosts",
    "cleanup": "$env:LocalAppData\\net.oldj.switchhosts",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/oldj/SwitchHosts/releases/download/v$version/SwitchHosts-$version-windows-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/oldj/SwitchHosts/releases/download/v$version/SwitchHosts-$version-windows-arm64-setup.exe"
            }
        }
    }
}
