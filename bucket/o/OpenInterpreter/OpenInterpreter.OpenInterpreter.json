{
    "version": "0.0.42",
    "description": "专为低成本模型优化的代码智能体 | A coding agent optimized for low-cost models",
    "homepage": "http://openinterpreter.com",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.42/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz",
            "hash": "5d8ba993a4530fa60a322f1a379a9ef16844749bc184685c38d84d04ddf779ed"
        },
        "arm64": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.42/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz",
            "hash": "b990318d7c45b5807b53b00e9e82d07f389e9fecae72f14e4b691fc53c270b45"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\bin\\i.exe",
        "app\\bin\\interpreter.exe"
    ],
    "link": "$home\\.openinterpreter",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        },
        "regex": "rust-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz"
            }
        }
    }
}
