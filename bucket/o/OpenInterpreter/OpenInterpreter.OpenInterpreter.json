{
    "version": "0.0.44",
    "description": "专为低成本模型优化的代码智能体 | A coding agent optimized for low-cost models",
    "homepage": "http://openinterpreter.com",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.44/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz",
            "hash": "57f7a4c0658a620b7376ba53a6fc91216f01753abc9469c9d17cdda4c24d5778"
        },
        "arm64": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.44/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz",
            "hash": "53214a58ef4e886846357a83f99f6d7435e0cc8c94c448b028e939866e5edaec"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\bin\\i.exe",
        "app\\bin\\interpreter.exe"
    ],
    "link": "$home\\.openinterpreter",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        },
        "regex": "rust-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz"
            }
        }
    }
}
