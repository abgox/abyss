{
    "version": "0.0.39",
    "description": "专为低成本模型优化的代码智能体 | A coding agent optimized for low-cost models",
    "homepage": "http://openinterpreter.com",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.39/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz",
            "hash": "43e7dff2a4d57def484b66f32d06638dc7957fd4ed17d041d83b0776efdc42b7"
        },
        "arm64": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.39/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz",
            "hash": "eb886127d46dcabcc03a958e4c40db1719584c3161efc3dc37bc05a09bd45d82"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\bin\\i.exe",
        "app\\bin\\interpreter.exe"
    ],
    "link": "$home\\.openinterpreter",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        },
        "regex": "rust-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz"
            }
        }
    }
}
