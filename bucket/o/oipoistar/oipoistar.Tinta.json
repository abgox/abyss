{
    "version": "3.9.6",
    "description": "适用于 Windows 的轻量快速 Markdown 与 Mermaid 查看器 | Fast, lightweight markdown and Mermaid viewer for Windows",
    "homepage": "https://tinta.cc",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/oipoistar/tinta/releases/download/v3.9.6/tinta.exe",
            "hash": "ebba82bbd5f7f4b933942522fe57e8593d6a8a63b4ed46ed491b1176bc1a1f68"
        }
    },
    "extract_to": "app",
    "bin": "app\\tinta.exe",
    "link": "$env:AppData\\Tinta",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/oipoistar/tinta/releases/download/v$version/tinta.exe"
            }
        }
    }
}
