{
    "version": "0.20.0",
    "description": "WSL-UI - 一款轻量级桌面应用程序，用于管理 Windows 子系统 Linux（WSL）发行版 | WSL-UI - A lightweight desktop application to manage Windows Subsystem for Linux (WSL) distributions",
    "homepage": "https://wsl-ui.octasoft.co.uk",
    "license": {
        "identifier": "BUSL-1.1"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/octasoft-ltd/wsl-ui/releases/download/v0.20.0/WSL.UI_0.20.0_x64-setup.exe",
            "hash": "8d0a9e9f0c8dfe75b7ed8d485b68dcc939933aec03c182e0a36f37de31e6be20"
        },
        "arm64": {
            "url": "https://github.com/octasoft-ltd/wsl-ui/releases/download/v0.20.0/WSL.UI_0.20.0_arm64-setup.exe",
            "hash": "0cefa073b28107661a3a927306ecd6b9420548b63783bae26f4300726624f38e"
        }
    },
    "shortcuts": [
        [
            "app\\wsl-ui.exe",
            "WSL UI"
        ]
    ],
    "link": "$env:LocalAppData\\wsl-ui",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/octasoft-ltd/wsl-ui/releases/download/v$version/WSL.UI_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/octasoft-ltd/wsl-ui/releases/download/v$version/WSL.UI_$version_arm64-setup.exe"
            }
        }
    }
}
