{
    "version": "6.0.0",
    "description": "集找番、追番、看番的一站式弹幕追番平台 | An all-in-one bullet-screen anime platform for finding, following, and watching anime",
    "homepage": "https://animeko.org",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/open-ani/animeko/releases/download/v6.0.0/ani-6.0.0-windows-x86_64.zip",
            "hash": "6b928cd7d6acccae8462ad538e6b60a07026999920470345731de8536020df8a"
        }
    },
    "extract_dir": "Ani",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\Ani.exe",
            "Animeko"
        ]
    ],
    "link": "$env:AppData\\Him188\\Ani",
    "cleanup": "$env:LocalAppData\\Him188\\Ani",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/open-ani/animeko/releases/download/v$version/ani-$version-windows-x86_64.zip"
            }
        }
    }
}
