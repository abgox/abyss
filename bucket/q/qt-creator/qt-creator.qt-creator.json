{
    "version": "21.0.0-beta2",
    "description": "用于 Qt 框架开发的集成开发环境 (IDE) | IDE for development with the Qt framework",
    "homepage": "https://doc.qt.io/qtcreator/index.html",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/qt-creator/qt-creator/releases/download/v21.0.0-beta2/qtcreator-windows-x64-msvc-21.0.0-beta2.7z",
            "hash": "a2128b02e01a3787a41cb8a4c1ebc855b0961e1139576b2e15ce7444154274c4"
        }
    },
    "extract_to": "app",
    "bin": "app\\bin\\qtcreator.exe",
    "shortcuts": [
        [
            "app\\bin\\qtcreator.exe",
            "Qt Creator"
        ]
    ],
    "link": "$env:AppData\\QtProject",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qt-creator/qt-creator/releases/download/v$version/qtcreator-windows-x64-msvc-$version.7z"
            }
        }
    }
}
