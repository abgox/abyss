{
    "version": "26.8.2-0",
    "description": "一款可跨平台运行的桌面应用程序，助力你创建和管理各类 API 请求 | A cross-platform desktop application that helps you create and manage API requests",
    "homepage": "https://hoppscotch.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/hoppscotch/releases/releases/download/v26.8.2-0/Hoppscotch_SelfHost_win_x64_portable.zip",
            "hash": "5abf61ed8bd58024337753ac3809d4f2a8a86a27d7fc6e6ae8da90d998fd6d76"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\hoppscotch-desktop.exe",
            "Hoppscotch"
        ]
    ],
    "persist": [
        [
            "app\\hoppscotch-desktop-data",
            "AppData\\Roaming\\io.hoppscotch.desktop"
        ]
    ],
    "cleanup": "$env:LocalAppData\\io.hoppscotch.desktop",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/hoppscotch/releases/releases/download/v$version/Hoppscotch_SelfHost_win_x64_portable.zip"
            }
        }
    }
}
