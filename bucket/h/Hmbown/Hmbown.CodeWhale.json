{
    "version": "0.9.12",
    "description": "面向终端的开源代码智能代理工具 | An open source coding agent for your terminal",
    "homepage": "https://codewhale.net",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Hmbown/CodeWhale/releases/download/v0.9.12/codewhale-windows-x64-portable.zip",
            "hash": "ffd37a23df92c997570df53926161f0672bff4ec2f54a6778130a716a977f2ae",
            "extract_dir": "codewhale-windows-x64-portable"
        },
        "arm64": {
            "url": "https://github.com/Hmbown/CodeWhale/releases/download/v0.9.12/codewhale-windows-arm64-portable.zip",
            "hash": "b4fd5a421cff395f72a87c3362d66db4981a770ca5f193847f2b31e46a1c8216",
            "extract_dir": "codewhale-windows-arm64-portable"
        }
    },
    "renamed": {
        "new": "Hmbown.CodeWhale",
        "old": "Hmbown.DeepSeek-TUI"
    },
    "extract_to": "app",
    "bin": [
        "app\\codew.exe",
        "app\\codewhale.exe"
    ],
    "link": [
        "$env:AppData\\codewhale",
        "$home\\.codewhale"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-arm64-portable.zip"
            }
        }
    }
