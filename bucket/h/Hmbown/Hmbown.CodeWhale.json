            "hash": "765621e36096311c0bd541f98ae3c771e5fdcaed50f8cc7039658ec3e64d321a",
            "extract_dir": "codewhale-windows-x64-portable"
        },
        "arm64": {
            "url": "https://github.com/Hmbown/CodeWhale/releases/download/v0.10.1/codewhale-windows-arm64-portable.zip",
            "hash": "4bb5f7d35eb7285b10cd769400ca16de955ce12abcbe15a777fefc14283680b3",
            "extract_dir": "codewhale-windows-arm64-portable"
        }
    },
    "renamed": {
        "new": "Hmbown.CodeWhale",
        "old": "Hmbown.DeepSeek-TUI"
    },
    "extract_to": "app",
    "bin": [
        "app\\codew.exe",
        "app\\codewhale.exe"
    ],
    "link": [
        "$env:AppData\\codewhale",
        "$home\\.codewhale"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-arm64-portable.zip"
            }
        }
    }
