{
    "version": "0.9.11",
    "description": "面向终端的开源代码智能代理工具 | An open source coding agent for your terminal",
    "homepage": "https://codewhale.net",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Hmbown/CodeWhale/releases/download/v0.9.11/codewhale-windows-x64-portable.zip",
            "hash": "b0f6c0863e3b35902d3efd5bccc79214d3ce06f4d3dc2a5e05301d74be6bec72",
            "extract_dir": "codewhale-windows-x64-portable"
        },
        "arm64": {
            "url": "https://github.com/Hmbown/CodeWhale/releases/download/v0.9.11/codewhale-windows-arm64-portable.zip",
            "hash": "5bccabac05cca20ccfb9d2b3b9b9f80766365dc363626920900ba687c6f2d188",
            "extract_dir": "codewhale-windows-arm64-portable"
        }
    },
    "renamed": {
        "new": "Hmbown.CodeWhale",
        "old": "Hmbown.DeepSeek-TUI"
    },
    "extract_to": "app",
    "bin": [
        "app\\codew.exe",
        "app\\codewhale.exe"
    ],
    "link": [
        "$env:AppData\\codewhale",
        "$home\\.codewhale"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-arm64-portable.zip"
            }
        }
    }
}
