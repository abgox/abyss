{
    "version": "0.10.0",
    "description": "面向终端的开源代码智能代理工具 | An open source coding agent for your terminal",
    "homepage": "https://codewhale.net",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Hmbown/CodeWhale/releases/download/v0.10.0/codewhale-windows-x64-portable.zip",
            "hash": "cfdd13ecb92d559fe36799025e7c1958341a057d8e6bb4f3c07baba03cf3b1d7",
            "extract_dir": "codewhale-windows-x64-portable"
        },
        "arm64": {
            "url": "https://github.com/Hmbown/CodeWhale/releases/download/v0.10.0/codewhale-windows-arm64-portable.zip",
            "hash": "27d1f77fb8495fbc3e3c45dc70ab95361ae58e410a61df5a6d951f83d800fd4d",
            "extract_dir": "codewhale-windows-arm64-portable"
        }
    },
    "renamed": {
        "new": "Hmbown.CodeWhale",
        "old": "Hmbown.DeepSeek-TUI"
    },
    "extract_to": "app",
    "bin": [
        "app\\codew.exe",
        "app\\codewhale.exe"
    ],
    "link": [
        "$env:AppData\\codewhale",
        "$home\\.codewhale"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Hmbown/CodeWhale/releases/download/v$version/codewhale-windows-arm64-portable.zip"
            }
        }
    }
}
