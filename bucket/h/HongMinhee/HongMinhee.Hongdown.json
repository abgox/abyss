{
    "version": "0.5.3",
    "description": "一款遵循洪民憙的 Markdown 风格规范的 Markdown 格式化工具 | A Markdown formatter that enforces Hong Minhee's Markdown style conventions",
    "homepage": "https://dahlia.github.io/hongdown",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/dahlia/hongdown/releases/download/0.5.3/hongdown-0.5.3-x86_64-pc-windows-msvc.zip",
            "hash": "92b55325bf42cf5f9c2e000ac72f8d058454957237f3bc7130c739482c22daac"
        },
        "arm64": {
            "url": "https://github.com/dahlia/hongdown/releases/download/0.5.3/hongdown-0.5.3-aarch64-pc-windows-msvc.zip",
            "hash": "f953b2dfeda8b7f5b2da0f2a6c1bc1961109cfef15f0fd69247d044c7e2735b5"
        }
    },
    "extract_to": "app",
    "bin": "app\\hongdown.exe",
    "link": "$env:AppData\\hongdown",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dahlia/hongdown/releases/download/$version/hongdown-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/dahlia/hongdown/releases/download/$version/hongdown-$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
