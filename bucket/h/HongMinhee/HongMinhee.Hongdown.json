{
    "version": "0.5.2",
    "description": "一款遵循洪民憙的 Markdown 风格规范的 Markdown 格式化工具 | A Markdown formatter that enforces Hong Minhee's Markdown style conventions",
    "homepage": "https://dahlia.github.io/hongdown",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/dahlia/hongdown/releases/download/0.5.2/hongdown-0.5.2-x86_64-pc-windows-msvc.zip",
            "hash": "e70b4ec695826a8af1414892df78a68a57c9e49934d83c6735e377b12e8a22a9"
        },
        "arm64": {
            "url": "https://github.com/dahlia/hongdown/releases/download/0.5.2/hongdown-0.5.2-aarch64-pc-windows-msvc.zip",
            "hash": "fb19fa1bde6cb27d3d2f911a633e5c7b1f6c707a9ab81eeb7b9bb54d19aad3df"
        }
    },
    "extract_to": "app",
    "bin": "app\\hongdown.exe",
    "link": "$env:AppData\\hongdown",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dahlia/hongdown/releases/download/$version/hongdown-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/dahlia/hongdown/releases/download/$version/hongdown-$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
