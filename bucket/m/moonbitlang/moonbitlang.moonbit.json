{
    "version": "0.1.20260904-0.10.12-0.1.20260904",
    "description": "MoonBit 是一种类似 Rust 的语言（支持垃圾回收），也是一个为 WebAssembly 体验优化的工具链 | MoonBit is a Rust-like language (with GC support) and toolchain optimized for WebAssembly experience",
    "homepage": "https://www.moonbitlang.com",
    "license": {
        "identifier": "Apache-2.0,AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://cli.moonbitlang.cn/binaries/latest/moonbit-windows-x86_64.zip",
                "https://cli.moonbitlang.cn/cores/core-latest.zip"
            ],
            "hash": [
                "3e5449e862d4979b2fc64e6a248ec5babbd110440c8f2a7bf813c6fa01d8581f",
                "f770d1f314f4aa88389e854c7e76814a534a2d84e93fe33e1737a516614d327f"
            ]
        }
    },
    "extract_to": [
        "app\\.moon",
        "app\\.moon\\lib"
    ],
    "env_set": {
        "MOON_HOME": "$dir\\app\\.moon"
    },
    "env_add_path": "app\\.moon\\bin",
    "persist": [
        [
            "app\\.moon\\registry",
            ".moon\\registry"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "Push-Location \"$dir\\app\\.moon\\lib\\core\"",
        "moon.exe bundle --warn-list -a --all --quiet 2>$null",
        "moon.exe bundle --warn-list -a --target wasm-gc --quiet 2>$null",
        "Pop-Location",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://cli.moonbitlang.com/version.json",
        "jsonpath": "$..version",
        "regex": "([\\d.]+).+?,.+?([\\d.]+).+?,.+?([\\d.]+)",
        "replace": "${1}-${2}-${3}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://cli.moonbitlang.cn/binaries/latest/moonbit-windows-x86_64.zip",
                    "https://cli.moonbitlang.cn/cores/core-latest.zip"
                ]
            }
        }
    }
}
