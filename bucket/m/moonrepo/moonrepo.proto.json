{
    "version": "0.62.2",
    "description": "一个可插拔的多语言版本管理器 | A pluggable multi-language version manager",
    "homepage": "https://moonrepo.dev/proto",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/moonrepo/proto/releases/download/v0.62.2/proto_cli-x86_64-pc-windows-msvc.zip",
            "hash": "48975ccff8ac882abab325149e00d32740c22c5100f68e6c3d0241fba5b8e1ac"
        }
    },
    "extract_to": "app",
    "env_add_path_expand": "$home\\.proto\\shims",
    "bin": "app\\proto.exe",
    "link": "$home\\.proto",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moonrepo/proto/releases/download/v$version/proto_cli-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
