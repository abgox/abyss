{
    "version": "2.0.1",
    "description": "一个易用的代理客户端 | An easy-to-use proxy client",
    "homepage": "https://github.com/mihomo-party-org/clash-party",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "notes_cn": "$app 会在安装成功后自动启动。",
    "notes": "$app will be automatically launched after installation.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mihomo-party-org/clash-party/releases/download/v2.0.1/clash-party-windows-2.0.1-x64-portable.7z",
            "hash": "b9010b916b096179f374c671d728da3cab5316c2a0eabe43dc17a3434e3e03ff"
        },
        "arm64": {
            "url": "https://github.com/mihomo-party-org/clash-party/releases/download/v2.0.1/clash-party-windows-2.0.1-arm64-portable.7z",
            "hash": "88b678bed78d269b42c84640fe30e4a1ba5023bde157ebde971f6c774a56a5b6"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\Clash Party.exe",
            "Clash Party"
        ]
    ],
    "persist": [
        [
            "app\\data",
            "AppData\\Roaming\\mihomo-party"
        ]
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "# 安装完成后自动启动一次，以解决首次启动必须使用管理员权限的问题",
        "$null = Start-Job -ScriptBlock {",
        "    param($dir)",
        "    While (!(Test-Path \"$dir\\app\\data\")) {",
        "        Start-Sleep -Milliseconds 100",
        "    }",
        "    Start-Process \"$dir\\app\\Clash Party.exe\"",
        "} -ArgumentList $dir"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mihomo-party-org/clash-party/releases/download/v$version/clash-party-windows-$version-x64-portable.7z"
            },
            "arm64": {
                "url": "https://github.com/mihomo-party-org/clash-party/releases/download/v$version/clash-party-windows-$version-arm64-portable.7z"
            }
        }
    }
}
