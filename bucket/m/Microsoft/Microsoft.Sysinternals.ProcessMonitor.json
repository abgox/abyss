{
    "version": "4.1",
    "description": "一款适用于 Windows 系统的高级监控工具，可实时显示文件系统、注册表以及进程和线程的活动情况 | An advanced monitoring tool for Windows that shows real-time file system, Registry and process/thread activity",
    "homepage": "https://learn.microsoft.com/sysinternals/downloads/procmon",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.sysinternals.com/files/ProcessMonitor.zip",
            "hash": "4ff309fe52c56599377896b7863cb77b6c601d9f2522e52da7a182eac593e8e1",
            "bin": [
                [
                    "app\\Procmon64.exe",
                    "procmon",
                    "/accepteula"
                ]
            ],
            "shortcuts": [
                [
                    "app\\Procmon64.exe",
                    "ProcessMonitor",
                    "/accepteula"
                ]
            ]
        },
        "arm64": {
            "url": "https://download.sysinternals.com/files/ProcessMonitor.zip",
            "hash": "4ff309fe52c56599377896b7863cb77b6c601d9f2522e52da7a182eac593e8e1",
            "bin": [
                [
                    "app\\Procmon64a.exe",
                    "procmon",
                    "/accepteula"
                ]
            ],
            "shortcuts": [
                [
                    "app\\Procmon64a.exe",
                    "ProcessMonitor",
                    "/accepteula"
                ]
            ]
        }
    },
    "extract_to": "app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.Sysinternals.ProcessMonitor",
            "ext": "zip"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
