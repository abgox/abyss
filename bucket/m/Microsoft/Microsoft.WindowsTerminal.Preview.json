{
    "version": "1.26.2734.0",
    "description": "新的 Windows 终端，为 Windows 提供标签命令行体验 | The new Windows Terminal, a tabbed command line experience for Windows",
    "homepage": "https://github.com/microsoft/terminal",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/microsoft/terminal/releases/download/v1.26.2734.0/Microsoft.WindowsTerminalPreview_1.26.2734.0_8wekyb3d8bbwe.msixbundle",
            "hash": "dbc240a34e327fa65fc5edabe523a55cdc3a1b165f067e291c165cdc811269dd"
        },
        "arm64": {
            "url": "https://github.com/microsoft/terminal/releases/download/v1.26.2734.0/Microsoft.WindowsTerminalPreview_1.26.2734.0_8wekyb3d8bbwe.msixbundle",
            "hash": "dbc240a34e327fa65fc5edabe523a55cdc3a1b165f067e291c165cdc811269dd"
        }
    },
    "msix": "Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe",
    "link": "$env:LocalAppData\\Packages\\Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe\\LocalState",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$parentId = (Get-Process | Where-Object { $_.Id -eq $PID }).Parent.Id",
        "$processName = (Get-Process | Where-Object { $_.Id -eq $parentId }).ProcessName",
        "if ($processName -eq 'WindowsTerminal') {",
        "    if ($PSUICulture -like 'zh*') {",
        "       Write-Host \"不能在 WindowsTerminal 中安装、更新、卸载 WindowsTerminal\" -ForegroundColor Red",
        "    }",
        "    else {",
        "       Write-Host \"You cannot $cmd WindowsTerminal in WindowsTerminal.\" -ForegroundColor Red",
        "    }",
        "   exit 1",
        "}",
        "A-New-Link",
        "A-Install-MsixPackage"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "$parentId = (Get-Process | Where-Object { $_.Id -eq $PID }).Parent.Id",
        "$processName = (Get-Process | Where-Object { $_.Id -eq $parentId }).ProcessName",
        "if ($processName -eq 'WindowsTerminal') {",
        "    if ($PSUICulture -like 'zh*') {",
        "       Write-Host \"不能在 WindowsTerminal 中安装、更新、卸载 WindowsTerminal\" -ForegroundColor Red",
        "    }",
        "    else {",
        "       Write-Host \"You cannot $cmd WindowsTerminal in WindowsTerminal.\" -ForegroundColor Red",
        "    }",
        "   exit 1",
        "}",
        "A-Uninstall-MsixPackage",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.WindowsTerminal.Preview",
            "ext": "msixbundle"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
