{
    "version": "21.0.12.8",
    "description": "微软构建的 OpenJDK 是一种全新的免费长期支持发行版，也是微软与 Java 生态系统开展协作和贡献的新方式 | The Microsoft Build of OpenJDK is a new no-cost long-term supported distribution and Microsoft's new way to collaborate and contribute to the Java ecosystem",
    "homepage": "https://www.microsoft.com/openjdk",
    "license": {
        "identifier": "GPL2 with Classpath Exception",
        "url": "https://openjdk.java.net/legal/gplv2+ce.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://aka.ms/download-jdk/microsoft-jdk-21.0.12-windows-x64.msi#winget#/dl.msi",
            "hash": "96ee22a4863c1b6f92ff3c8af0f8dab4a7dffc210440b1641950d9001d0e23ed"
        },
        "arm64": {
            "url": "https://aka.ms/download-jdk/microsoft-jdk-21.0.12-windows-aarch64.msi#winget#/dl.msi",
            "hash": "00b5888d71cbd1e5762e4266ba56046869be1f78d1b5d36485c9a3d94f5c4a55"
        }
    },
    "extract_dir": "PFiles64\\Microsoft\\jdk-21.0.12.8-hotspot",
    "extract_to": "app",
    "env_set": {
        "JAVA_HOME": "$dir\\app"
    },
    "env_add_path": "app\\bin",
    "commands": [
        "java",
        "jabswitch"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.OpenJDK.21",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        },
        "extract_dir": "PFiles64\\Microsoft\\jdk-$version-hotspot"
    }
}
