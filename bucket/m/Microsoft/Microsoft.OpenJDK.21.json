{
    "version": "21.0.12.101",
    "description": "微软构建的 OpenJDK 是一种全新的免费长期支持发行版，也是微软与 Java 生态系统开展协作和贡献的新方式 | The Microsoft Build of OpenJDK is a new no-cost long-term supported distribution and Microsoft's new way to collaborate and contribute to the Java ecosystem",
    "homepage": "https://www.microsoft.com/openjdk",
    "license": {
        "identifier": "GPL2 with Classpath Exception",
        "url": "https://openjdk.java.net/legal/gplv2+ce.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://aka.ms/download-jdk/microsoft-jdk-21.0.12.1-windows-x64.msi#winget#/dl.msi",
            "hash": "3a3f7e1a9fd9edd1fcc0545ffbe7dc87787a8417dc1bf303e41c7a697c8490c1"
        },
        "arm64": {
            "url": "https://aka.ms/download-jdk/microsoft-jdk-21.0.12.1-windows-aarch64.msi#winget#/dl.msi",
            "hash": "9680ea11e52fea7ce29ccbd4d0559a325e848f95fb1a73c4d5e1bc7e66943890"
        }
    },
    "extract_dir": "PFiles64\\Microsoft\\jdk-21.0.12.101-hotspot",
    "extract_to": "app",
    "env_set": {
        "JAVA_HOME": "$dir\\app"
    },
    "env_add_path": "app\\bin",
    "commands": [
        "java",
        "jabswitch"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.OpenJDK.21",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        },
        "extract_dir": "PFiles64\\Microsoft\\jdk-$version-hotspot"
    }
}
