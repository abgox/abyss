{
    "version": "17.14",
    "description": "一个用于显示进程已打开或加载的句柄与动态链接库相关信息的工具 | A tool that shows information about which handles and DLLs processes have opened or loaded",
    "homepage": "https://learn.microsoft.com/sysinternals/downloads/process-explorer",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.sysinternals.com/files/ProcessExplorer.zip",
            "hash": "746770d3f54326dd7da16c2b2815803ab131f348cba24a91cb6a38cfd2f7073f",
            "bin": [
                [
                    "app\\procexp64.exe",
                    "procexp",
                    "/accepteula"
                ]
            ],
            "shortcuts": [
                [
                    "app\\procexp64.exe",
                    "ProcessExplorer",
                    "/accepteula"
                ]
            ]
        },
        "arm64": {
            "url": "https://download.sysinternals.com/files/ProcessExplorer.zip",
            "hash": "746770d3f54326dd7da16c2b2815803ab131f348cba24a91cb6a38cfd2f7073f",
            "bin": [
                [
                    "app\\procexp64a.exe",
                    "procexp",
                    "/accepteula"
                ]
            ],
            "shortcuts": [
                [
                    "app\\procexp64a.exe",
                    "ProcessExplorer",
                    "/accepteula"
                ]
            ]
        }
    },
    "extract_to": "app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.Sysinternals.ProcessExplorer",
            "ext": "zip"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
