{
    "version": "157.0.4341.16",
    "description": "(Beta 版本) 微软 Edge 浏览器 - 一款由微软创建和开发的跨平台网络浏览器 | (Beta version) Microsoft Edge - A cross-platform web browser created and developed by Microsoft",
    "homepage": "https://www.microsoft.com/edge",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.microsoft.com/servicesagreement"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.microsoft.com/download/f7f00b3d-e57c-4e5b-9014-350d57195e58/MicrosoftEdgeBetaEnterpriseX64.msi#/dl.msi_",
            "hash": "ee670330a6d6accce6437c96dc4f2fd14c4dc5b140541d7dca61cfdd4bb1bee6"
        },
        "arm64": {
            "url": "https://download.microsoft.com/download/f7f00b3d-e57c-4e5b-9014-350d57195e58/MicrosoftEdgeBetaEnterpriseARM64.msi#/dl.msi_",
            "hash": "a82a154d4d8f597fd33f91705419e358b758e72583260e5d40d96e88247fed1f"
        }
    },
    "location": "${env:ProgramFiles(x86)}\\Microsoft\\Edge Beta",
    "link": "$env:LocalAppData\\Microsoft\\Edge Beta\\User Data",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.Edge.Beta",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
