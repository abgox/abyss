{
    "version": "153.0.4234.8",
    "description": "(Beta 版本) 微软 Edge 浏览器 - 一款由微软创建和开发的跨平台网络浏览器 | (Beta version) Microsoft Edge - A cross-platform web browser created and developed by Microsoft",
    "homepage": "https://www.microsoft.com/edge",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.microsoft.com/servicesagreement"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.microsoft.com/download/0fd09128-55f2-43c0-86e5-b5b679d42d84/MicrosoftEdgeBetaEnterpriseX64.msi#/dl.msi_",
            "hash": "26644337d1a3941c455636b19e8f820b61135e758bcb3c0b3373c6301e66978f"
        },
        "arm64": {
            "url": "https://download.microsoft.com/download/0fd09128-55f2-43c0-86e5-b5b679d42d84/MicrosoftEdgeBetaEnterpriseARM64.msi#/dl.msi_",
            "hash": "508b04874b4d5f90e3364aa10677a8f2430f56820b6ca26ab8c99a56df3f789c"
        }
    },
    "location": "${env:ProgramFiles(x86)}\\Microsoft\\Edge Beta",
    "link": "$env:LocalAppData\\Microsoft\\Edge Beta\\User Data",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.Edge.Beta",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
