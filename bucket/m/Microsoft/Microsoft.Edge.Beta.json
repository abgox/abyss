{
    "version": "156.0.4314.30",
    "description": "(Beta 版本) 微软 Edge 浏览器 - 一款由微软创建和开发的跨平台网络浏览器 | (Beta version) Microsoft Edge - A cross-platform web browser created and developed by Microsoft",
    "homepage": "https://www.microsoft.com/edge",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.microsoft.com/servicesagreement"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.microsoft.com/download/ec72226c-67c1-4639-99ec-877942ef0421/MicrosoftEdgeBetaEnterpriseX64.msi#/dl.msi_",
            "hash": "970cbef8e56a9c949c59267cbbd55d854293ba0153ddd6d53ffd6757a23aea5d"
        },
        "arm64": {
            "url": "https://download.microsoft.com/download/ec72226c-67c1-4639-99ec-877942ef0421/MicrosoftEdgeBetaEnterpriseARM64.msi#/dl.msi_",
            "hash": "0f13d624a3087e22f424e7ba63047e5af921136365600eaece43ed61721bb77a"
        }
    },
    "location": "${env:ProgramFiles(x86)}\\Microsoft\\Edge Beta",
    "link": "$env:LocalAppData\\Microsoft\\Edge Beta\\User Data",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.Edge.Beta",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
