{
    "version": "152.0.4167.0",
    "description": "(Dev 版本) 微软 Edge 浏览器 - 一款由微软创建和开发的跨平台网络浏览器 | (Dev version) Microsoft Edge - A cross-platform web browser created and developed by Microsoft",
    "homepage": "https://www.microsoft.com/edge",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.microsoft.com/servicesagreement"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.microsoft.com/download/12ed9c22-7a8e-4d96-9dcf-ef1f85d062a9/MicrosoftEdgeDevEnterpriseX64.msi#/dl.msi_",
            "hash": "066fed9beee02d8818ba65c25727380e2a6af25e9fba2035f4a12e30e972a6ac"
        },
        "arm64": {
            "url": "https://download.microsoft.com/download/12ed9c22-7a8e-4d96-9dcf-ef1f85d062a9/MicrosoftEdgeDevEnterpriseARM64.msi#/dl.msi_",
            "hash": "4826be80f31ad54670030a00beeac4f2f09a5cbf8bf0e2580167a871cbad693a"
        }
    },
    "location": "${env:ProgramFiles(x86)}\\Microsoft\\Edge Dev",
    "link": "$env:LocalAppData\\Microsoft\\Edge Dev\\User Data",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.Edge.Dev",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
