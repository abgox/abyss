{
    "version": "157.0.4322.0",
    "description": "(Dev 版本) 微软 Edge 浏览器 - 一款由微软创建和开发的跨平台网络浏览器 | (Dev version) Microsoft Edge - A cross-platform web browser created and developed by Microsoft",
    "homepage": "https://www.microsoft.com/edge",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.microsoft.com/servicesagreement"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.microsoft.com/download/045f7559-4ae5-42cb-9b0f-900118450a3a/MicrosoftEdgeDevEnterpriseX64.msi#/dl.msi_",
            "hash": "36a483a568ba8febe3cab69323480104934eb6e4ffdb0e851973337540819ff0"
        },
        "arm64": {
            "url": "https://download.microsoft.com/download/045f7559-4ae5-42cb-9b0f-900118450a3a/MicrosoftEdgeDevEnterpriseARM64.msi#/dl.msi_",
            "hash": "4551523f2c6f25acef4725fa87c79a738f6b012fb84b19e994faacc38b768cb9"
        }
    },
    "location": "${env:ProgramFiles(x86)}\\Microsoft\\Edge Dev",
    "link": "$env:LocalAppData\\Microsoft\\Edge Dev\\User Data",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.Edge.Dev",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
