{
    "version": "1.143.0",
    "description": "vscode - 一个轻量级、功能强大，插件生态丰富的文件编辑器 | vscode - A lightweight but powerful source code editor",
    "homepage": "https://code.visualstudio.com",
    "license": {
        "identifier": "Microsoft Software License",
        "url": "https://code.visualstudio.com/license/"
    },
    "architecture": {
        "64bit": {
            "url": "https://update.code.visualstudio.com/1.143.0/win32-x64-user/stable#/dl.exe",
            "hash": "c7617f4702e7624becbec8d3c2be4432c20402b6911fc0d2aba08971d2afb53a"
        },
        "arm64": {
            "url": "https://update.code.visualstudio.com/1.143.0/win32-arm64-user/stable#/dl.exe",
            "hash": "0c988752da798465c533c68b2ceaa1acade0ae0bfc296dcd57dfcc0995dc3273"
        }
    },
    "env_add_path": [
        "app\\bin",
        "app\\bin\\copilot-shim"
    ],
    "commands": "code",
    "shortcuts": [
        [
            "app\\Code.exe",
            "Visual Studio Code"
        ]
    ],
    "link": [
        "$env:AppData\\Code",
        "$home\\.vscode"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\unins000.exe' -ArgumentList '/CurrentUser', '/VerySilent', '/SuppressMsgBoxes', '/NoRestart', '/MergeTasks=!runcode,!addtopath,addcontextmenufiles,addcontextmenufolders,addcontextmenubackground', '/SP-', \"/Dir=$dir\\app\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App -ArgumentList '/VerySilent', '/SuppressMsgBoxes', '/NoRestart', '/Force'"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://update.code.visualstudio.com/api/update/win32-x64-user/stable/latest",
        "jsonpath": "$.productVersion"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://update.code.visualstudio.com/$version/win32-x64-user/stable#/dl.exe",
                "hash": {
                    "url": "https://update.code.visualstudio.com/api/versions/$version/win32-x64-user/stable",
                    "jsonpath": "$.sha256hash"
                }
            },
            "arm64": {
                "url": "https://update.code.visualstudio.com/$version/win32-arm64-user/stable#/dl.exe",
                "hash": {
                    "url": "https://update.code.visualstudio.com/api/versions/$version/win32-arm64-user/stable",
                    "jsonpath": "$.sha256hash"
                }
            }
        }
    }
}
