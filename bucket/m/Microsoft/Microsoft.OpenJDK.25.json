{
    "version": "25.0.4.101",
    "description": "微软构建的 OpenJDK 是一种全新的免费长期支持发行版，也是微软与 Java 生态系统开展协作和贡献的新方式 | The Microsoft Build of OpenJDK is a new no-cost long-term supported distribution and Microsoft's new way to collaborate and contribute to the Java ecosystem",
    "homepage": "https://www.microsoft.com/openjdk",
    "license": {
        "identifier": "GPL2 with Classpath Exception",
        "url": "https://openjdk.java.net/legal/gplv2+ce.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://aka.ms/download-jdk/microsoft-jdk-25.0.4.1-windows-x64.msi#winget#/dl.msi",
            "hash": "a7c4cee7c626e6947357a0bfb21bf8bf740f063daaea4a15e4775c5b37f87cc6"
        },
        "arm64": {
            "url": "https://aka.ms/download-jdk/microsoft-jdk-25.0.4.1-windows-aarch64.msi#winget#/dl.msi",
            "hash": "381d2e9823f9c313f1df885e448721dddc08fb40ded5ac8d6f8bea34a8a4da18"
        }
    },
    "extract_dir": "PFiles64\\Microsoft\\jdk-25.0.4.101-hotspot",
    "extract_to": "app",
    "env_set": {
        "JAVA_HOME": "$dir\\app"
    },
    "env_add_path": "app\\bin",
    "commands": [
        "java",
        "jabswitch"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Microsoft.OpenJDK.25",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        },
        "extract_dir": "PFiles64\\Microsoft\\jdk-$version-hotspot"
    }
}
