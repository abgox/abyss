{
    "version": "26.5.0.5542",
    "description": "适用于 Windows 的增强型终端，配备 X11 服务器、多标签 SSH 客户端、网络工具等诸多功能 | Enhanced terminal for Windows with X11 server, tabbed SSH client, network tools and much more",
    "homepage": "https://mobaxterm.mobatek.net",
    "license": {
        "identifier": "Unknown",
        "url": "https://mobaxterm.mobatek.net/license.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.mobatek.net/2652026082870834/MobaXterm_Installer_v26.5.zip",
            "hash": "fb898e15b98cd2656fef04108601bc6102a2f19f48b6412b25f4f0563b3b0c1d"
        }
    },
    "extract_to": "app",
    "link": "$env:AppData\\MobaXterm",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi -MsiPath (Get-ChildItem $dir *.msi -Recurse | Select-Object -First 1).FullName"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Mobatek.MobaXterm",
            "ext": "zip"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX86",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x86_machine.InstallerSha256"
                }
            }
        }
    }
}
