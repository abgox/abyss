{
    "version": "154.0",
    "description": "一款易于设置和定制的免费电子邮件应用程序 | A free email application that's easy to set up and customize",
    "homepage": "https://www.thunderbird.net",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.mozilla.org/en-US/foundation/licensing/"
    },
    "architecture": {
        "64bit": {
            "url": "https://download-installer.cdn.mozilla.net/pub/thunderbird/releases/154.0/win64/en-US/Thunderbird%20Setup%20154.0.exe",
            "hash": "18ee5928cf6a8b35a582bf4758d03cc3aaf3f33ed3615f54ca15e4029a1371a7"
        }
    },
    "shortcuts": [
        [
            "app\\thunderbird.exe",
            "Thunderbird"
        ],
        [
            "app\\thunderbird.exe",
            "Thunderbird Profile Manager",
            "-P"
        ]
    ],
    "link": [
        "$env:AppData\\Thunderbird",
        "$env:LocalAppData\\Thunderbird"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall\\helper.exe' -ArgumentList '/S','/PreventRebootRequired=true',\"/InstallDirectoryPath='$dir\\app'\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Mozilla.Thunderbird",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
