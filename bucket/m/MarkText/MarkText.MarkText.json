{
    "version": "0.22.0",
    "description": "一个简单优雅的 MarkDown 编辑器 | A simple and elegant markdown editor",
    "homepage": "https://www.marktext.cc",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.22.0/marktext-win-x64-0.22.0-setup.exe",
            "hash": "f710518d5559998515a3799ab4a74d971dd1436532048d3d9d62e808fef4001f"
        },
        "arm64": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.22.0/marktext-win-arm64-0.22.0-setup.exe",
            "hash": "377e7bafda950201640afd76aeb0d93a5b255f0899435452a27fc7e82ebe5c30"
        }
    },
    "bin": "app\\MarkText.exe",
    "shortcuts": [
        [
            "app\\MarkText.exe",
            "MarkText"
        ]
    ],
    "link": "$env:AppData\\MarkText",
    "cleanup": "$env:LocalAppData\\marktext-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall MarkText.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-x64-$version-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-arm64-$version-setup.exe"
            }
        }
    }
}
