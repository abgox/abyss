{
    "version": "0.21.1",
    "description": "一个简单优雅的 MarkDown 编辑器 | A simple and elegant markdown editor",
    "homepage": "https://www.marktext.cc",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.21.1/marktext-win-x64-0.21.1-setup.exe",
            "hash": "7843c4fc791e85f9824619946e802e2cf79fc790cadb1a98ce86e0a330432fed"
        },
        "arm64": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.21.1/marktext-win-arm64-0.21.1-setup.exe",
            "hash": "19bb2872eb4bdf6dcf971967af672330cfcb3b3e446da16f73420f9bcfc68e79"
        }
    },
    "bin": "app\\MarkText.exe",
    "shortcuts": [
        [
            "app\\MarkText.exe",
            "MarkText"
        ]
    ],
    "link": "$env:AppData\\MarkText",
    "cleanup": "$env:LocalAppData\\marktext-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall MarkText.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-x64-$version-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-arm64-$version-setup.exe"
            }
        }
    }
}
