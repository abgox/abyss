{
    "version": "0.20.0",
    "description": "一个简单优雅的 MarkDown 编辑器 | A simple and elegant markdown editor",
    "homepage": "https://www.marktext.cc",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.20.0/marktext-win-x64-0.20.0-setup.exe",
            "hash": "4c825f40d1222a3d9dc3acf397ccdf7464d9cb9d89759ee42ba7e0b7354ace4f"
        },
        "arm64": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.20.0/marktext-win-arm64-0.20.0-setup.exe",
            "hash": "58356c635de5c0f2a5a115f69c24b9c1e5e8a613dc1054d614fecf9eebc23689"
        }
    },
    "bin": "app\\MarkText.exe",
    "shortcuts": [
        [
            "app\\MarkText.exe",
            "MarkText"
        ]
    ],
    "link": "$env:AppData\\MarkText",
    "cleanup": "$env:LocalAppData\\marktext-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall MarkText.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-x64-$version-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-arm64-$version-setup.exe"
            }
        }
    }
}
