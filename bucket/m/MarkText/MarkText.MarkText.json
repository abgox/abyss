{
    "version": "0.21.2",
    "description": "一个简单优雅的 MarkDown 编辑器 | A simple and elegant markdown editor",
    "homepage": "https://www.marktext.cc",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.21.2/marktext-win-x64-0.21.2-setup.exe",
            "hash": "561f691da22750797bec07815bb8eb601b8c0c0d255d8a09031783f340b05579"
        },
        "arm64": {
            "url": "https://github.com/marktext/marktext/releases/download/v0.21.2/marktext-win-arm64-0.21.2-setup.exe",
            "hash": "60da0f26029c9796a62c1a32f7ae877c63d0975e0b03a9ce4ed0ccb57e4444e5"
        }
    },
    "bin": "app\\MarkText.exe",
    "shortcuts": [
        [
            "app\\MarkText.exe",
            "MarkText"
        ]
    ],
    "link": "$env:AppData\\MarkText",
    "cleanup": "$env:LocalAppData\\marktext-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall MarkText.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-x64-$version-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/marktext/marktext/releases/download/v$version/marktext-win-arm64-$version-setup.exe"
            }
        }
    }
}
