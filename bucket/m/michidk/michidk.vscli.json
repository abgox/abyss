{
    "version": "1.3.2",
    "description": "一个简化 VSCode 项目启动的 CLI/TUI，重点关注开发容器 | A CLI/TUI that simplifies launching VSCode projects, with a focus on dev containers",
    "homepage": "https://github.com/michidk/vscli",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/michidk/vscli/releases/download/v1.3.2/vscli-x86_64-pc-windows-msvc.zip",
            "hash": "939901d49e8a0737f12d838689ce2f3dcd8b053d220d4ba54dc7c0de8bf129ad",
            "extract_dir": "vscli-x86_64-pc-windows-msvc"
        }
    },
    "extract_to": "app",
    "bin": "app\\vscli.exe",
    "link": "$env:LocalAppData\\vscli",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/michidk/vscli/releases/download/v$version/vscli-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
