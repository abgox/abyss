{
    "version": "3.2.14",
    "description": "一个 AI 助手 | An AI assistant",
    "homepage": "https://www.kimi.com",
    "license": {
        "identifier": "Unknown",
        "url": "https://kimi.moonshot.cn/user/agreement/modeluse"
    },
    "architecture": {
        "64bit": {
            "url": "https://kimi-img.moonshot.cn/app/upgrade/Kimi-Setup-3.2.14.exe",
            "hash": "878296efb34e59a2be1d22c74e04479d3b76a2d39a6979cc4aad408c1501ec23"
        }
    },
    "shortcuts": [
        [
            "app\\Kimi 智能助手.exe",
            "Kimi 智能助手"
        ]
    ],
    "link": [
        "$env:AppData\\kimi",
        "$env:LocalAppData\\KimiAppCache"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "MoonshotAI.Kimi",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
