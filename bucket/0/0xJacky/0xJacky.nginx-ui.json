{
    "version": "2.5.8",
    "description": "另一个适用于 Nginx 的 Web 用户界面 | Yet another Web UI for Nginx",
    "homepage": "https://nginxui.com",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/0xJacky/nginx-ui/releases/download/v2.5.8/nginx-ui-windows-64.zip",
            "hash": "d7ad8ef7c1c558e38f49228dff6df0fc2b0d3dd9588bf556bc8c29a50c523c97"
        }
    },
    "extract_to": "app",
    "bin": "app\\nginx-ui.exe",
    "link": "$env:LocalAppData\\nginx-ui",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/0xJacky/nginx-ui/releases/download/v$version/nginx-ui-windows-64.zip"
            }
        }
    }
}
