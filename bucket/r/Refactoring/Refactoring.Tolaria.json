{
    "version": "2027.8.28",
    "description": "一款基于本地优先模式、支持 Markdown 语法的笔记应用，内置 Git 客户端并集成人工智能功能 | A local-first, Markdown-based note app with a built-in Git client and AI integration",
    "homepage": "https://tolaria.md",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/refactoringhq/tolaria/releases/download/v2027-08-28/Tolaria_2027.8.28_x64-setup.exe",
            "hash": "2f2e5f9093c3759f9a6e4f7a3a923db65e539d4c873cb091002e25af34ee34db"
        }
    },
    "shortcuts": [
        [
            "app\\Tolaria.exe",
            "Tolaria"
        ]
    ],
    "link": "$env:AppData\\com.tolaria.app",
    "cleanup": "$env:LocalAppData\\club.refactoring.tolaria",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        },
        "regex": "(\\d+)-(0)?(\\d+)-(0)?(\\d+)",
        "replace": "${1}.${3}.${5}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/refactoringhq/tolaria/releases/download/v$majorVersion-$match2$minorVersion-$match4$patchVersion/Tolaria_$version_x64-setup.exe"
            }
        }
    }
}
