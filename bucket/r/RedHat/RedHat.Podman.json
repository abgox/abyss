{
    "version": "6.1.3",
    "description": "用于开发、管理、运行 OCI 容器的无守护程序容器引擎 | A daemonless container engine for developing, managing, and running OCI Containers",
    "homepage": "https://podman.io",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/podman-container-tools/podman/releases/download/v6.1.3/podman-installer-windows-amd64.msi#/dl.msi_",
            "hash": "8eb4b84b9130f915a83d2b659caa430270f0de4fe566f97c32fc1c919d28e22b"
        },
        "arm64": {
            "url": "https://github.com/podman-container-tools/podman/releases/download/v6.1.3/podman-installer-windows-arm64.msi#/dl.msi_",
            "hash": "b5096f603b5bf6b98823ebe10768afce5a925837edbbd9e99174aba2a5fc1e9c"
        }
    },
    "location": "$env:LocalAppData\\Programs\\Podman",
    "commands": "podman",
    "link": [
        "$home\\.config\\containers\\podman",
        "$home\\.local\\share\\containers",
        "$env:AppData\\containers",
        "$env:ProgramData\\containers"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/podman-container-tools/podman/releases/download/v$version/podman-installer-windows-amd64.msi#/dl.msi_"
            },
            "arm64": {
                "url": "https://github.com/podman-container-tools/podman/releases/download/v$version/podman-installer-windows-arm64.msi#/dl.msi_"
            }
        }
    }
}
