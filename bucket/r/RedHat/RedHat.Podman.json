{
    "version": "6.1.0",
    "description": "用于开发、管理、运行 OCI 容器的无守护程序容器引擎 | A daemonless container engine for developing, managing, and running OCI Containers",
    "homepage": "https://podman.io",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/podman-container-tools/podman/releases/download/v6.1.0/podman-installer-windows-amd64.msi#/dl.msi_",
            "hash": "1958aac22abb3a9cf7b52626c71ba1a26015c323f0b5fa74671e303b22b043d3"
        },
        "arm64": {
            "url": "https://github.com/podman-container-tools/podman/releases/download/v6.1.0/podman-installer-windows-arm64.msi#/dl.msi_",
            "hash": "1d5f33844e168c0892e10f8e0e5c3085f250e5641f916ac1b7bf3665f97efbab"
        }
    },
    "location": "$env:LocalAppData\\Programs\\Podman",
    "commands": "podman",
    "link": [
        "$home\\.config\\containers\\podman",
        "$home\\.local\\share\\containers",
        "$env:AppData\\containers",
        "$env:ProgramData\\containers"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/podman-container-tools/podman/releases/download/v$version/podman-installer-windows-amd64.msi#/dl.msi_"
            },
            "arm64": {
                "url": "https://github.com/podman-container-tools/podman/releases/download/v$version/podman-installer-windows-arm64.msi#/dl.msi_"
            }
        }
    }
}
