{
    "version": "2.0.28",
    "description": "一款基于 todo.txt 语法的开源待办事项管理器 | An open-source todo manager based on the todo.txt syntax",
    "homepage": "https://github.com/ransome1/sleek",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ransome1/sleek/releases/download/v2.0.28/sleek-2.0.28-win-x64-Setup.exe",
            "hash": "14199ab2cd61671b1025bbfa6deb89fcd36bdaa6658ce87057e0acf2bfdddba8"
        },
        "arm64": {
            "url": "https://github.com/ransome1/sleek/releases/download/v2.0.28/sleek-2.0.28-win-arm64-Setup.exe",
            "hash": "96f3f977a0e2e0875ec6e9b7e3947119a06f3a1dcfa138534c46d216c313c92e"
        }
    },
    "shortcuts": [
        [
            "app\\sleek.exe",
            "sleek"
        ]
    ],
    "link": "$env:AppData\\sleek",
    "cleanup": "$env:LocalAppData\\sleek-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall sleek.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ransome1/sleek/releases/download/v$version/sleek-$version-win-x64-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/ransome1/sleek/releases/download/v$version/sleek-$version-win-arm64-Setup.exe"
            }
        }
    }
}
