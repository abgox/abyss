{
    "version": "2.7.2",
    "description": "可将网页应用整合为一体且功能丰富的工具 | Tool for organizing web apps into one application with rich features",
    "homepage": "https://rambox.app",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ramboxapp/download/releases/download/v2.7.2/Rambox-2.7.2-win-x64.exe",
            "hash": "64a5b632a58c8ee74efe348598fe15257036e147e2a9d48e108da154c9c4a2e1"
        }
    },
    "shortcuts": [
        [
            "app\\Rambox.exe",
            "Rambox"
        ]
    ],
    "link": "$env:AppData\\rambox",
    "cleanup": "$env:LocalAppData\\rambox-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Rambox.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ramboxapp/download/releases/download/v$version/Rambox-$version-win-x64.exe"
            }
        }
    }
}
