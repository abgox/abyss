{
    "version": "3.3.3",
    "description": "一个可在你的电脑上运行的网络文件服务器 | A web file server to run on your computer",
    "homepage": "https://github.com/rejetto/hfs",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rejetto/hfs/releases/download/v3.3.3/hfs-windows-x64-3.3.3.zip",
            "hash": "9172965da16b19bfc794be48b373fd70b37b17f3d0eed20cfe7604382a9f912d"
        }
    },
    "extract_to": "app",
    "bin": [
        [
            "app\\hfs.exe",
            "hfs",
            "--cwd \"$dir\\app\\.hfs\""
        ]
    ],
    "shortcuts": [
        [
            "app\\hfs.exe",
            "HFS",
            "--cwd \"$dir\\app\\.hfs\""
        ]
    ],
    "persist": [
        [
            "app\\.hfs",
            ".hfs"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rejetto/hfs/releases/download/v$version/hfs-windows-x64-$version.zip"
            }
        }
    }
}
