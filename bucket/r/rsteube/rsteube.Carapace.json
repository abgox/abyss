{
    "version": "1.8.0",
    "description": "多 shell、多命令、参数补全器 | multi-shell, multi-command, argument completer",
    "homepage": "https://carapace.sh",
    "license": {
        "identifier": "MIT"
    },
    "notes_cn": [
        "安装完成后，需要根据不同 Shell 手动注册补全器。",
        "具体操作请参考：https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "notes": [
        "After installation, you need to manually register the completer according to different shells.",
        "Refer to: https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "suggest": {
        "PSCompletions": "abyss/abgox.PSCompletions"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v1.8.0/carapace-bin_1.8.0_windows_amd64.zip",
            "hash": "ee5ba25180a8929e34c5b7f4aa20f898369c31c5e5939f68819cda0da1959762"
        },
        "arm64": {
            "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v1.8.0/carapace-bin_1.8.0_windows_arm64.zip",
            "hash": "df6bee5821a9b5ea323638e0410b0f328fce6c00c71fa6858fcac73afbe751e4"
        }
    },
    "conflicts": [
        "rsteube.Carapace",
        "rsteube.Carapace.nightly"
    ],
    "extract_to": "app",
    "env_set": {
        "CARAPACE_TOOLTIP": "1"
    },
    "bin": "app\\carapace.exe",
    "link": [
        "$env:AppData\\carapace",
        "$env:LocalAppData\\carapace"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v$version/carapace-bin_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v$version/carapace-bin_$version_windows_arm64.zip"
            }
        }
    }
}
