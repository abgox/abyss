{
    "version": "2026-10-30",
    "description": "多 shell、多命令、参数补全器 | multi-shell, multi-command, argument completer",
    "homepage": "https://carapace.sh",
    "license": {
        "identifier": "MIT"
    },
    "notes_cn": [
        "安装完成后，需要根据不同 Shell 手动注册补全器。",
        "具体操作请参考：https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "notes": [
        "After installation, you need to manually register the completer according to different shells.",
        "Refer to: https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/carapace-sh/nightly/releases/download/2026-10-30/carapace-bin_1.8.1-SNAPSHOT-c7dbfd459_windows_amd64.zip",
            "hash": "13438bb0ec355c9c4c24c083cfc4baad798c5fcd70070653f9fada525009b7ae"
        },
        "arm64": {
            "url": "https://github.com/carapace-sh/nightly/releases/download/2026-10-30/carapace-bin_1.8.1-SNAPSHOT-c7dbfd459_windows_arm64.zip",
            "hash": "1fd402aaf455a2f27d3a680fc44226b1c0a97faa77c0b5c9e2b1e4b6132300dd"
        }
    },
    "conflicts": [
        "rsteube.Carapace",
        "rsteube.Carapace.nightly"
    ],
    "extract_to": "app",
    "env_set": {
        "CARAPACE_TOOLTIP": "1"
    },
    "bin": "app\\carapace.exe",
    "link": [
        "$env:AppData\\carapace",
        "$env:LocalAppData\\carapace"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest",
            "raw": true
        },
        "regex": "/download/([^/]+)/carapace-bin_(?<ver>[\\d.]+)-SNAPSHOT-(?<hash>[a-f0-9]+)_windows_amd64.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/carapace-sh/nightly/releases/download/$version/carapace-bin_$matchVer-SNAPSHOT-$matchHash_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/carapace-sh/nightly/releases/download/$version/carapace-bin_$matchVer-SNAPSHOT-$matchHash_windows_arm64.zip"
            }
        }
    }
}
