{
    "version": "2.9.8",
    "description": "一个适用于 JavaScript 和 TypeScript 的现代运行时环境 | A modern runtime for JavaScript and TypeScript",
    "homepage": "https://deno.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/denoland/deno/releases/download/v2.9.8/deno-x86_64-pc-windows-msvc.zip",
            "hash": "cba84b26e0df5ae7f74fc66b86a95b866872a86292ebd84fa1e959927edd93bf"
        }
    },
    "extract_to": "app",
    "env_set": {
        "DENO_DIR": "$scoopdir\\persist\\@abgox.abyss\\.deno",
        "DENO_INSTALL_ROOT": "$scoopdir\\persist\\@abgox.abyss\\.deno\\bin"
    },
    "env_add_path": ".deno\\bin",
    "bin": "app\\deno.exe",
    "link": [
        "$home\\.deno",
        "$env:LocalAppData\\deno"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/denoland/deno/releases/download/v$version/deno-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
