{
    "version": "1.3.3",
    "description": "小旺 AI 截图，一款接入 DeepSeek 的 AI 截图神器，轻巧、好用、免费、无广告 | wang-screenshot - A screenshot tool that integrates with DeepSeek's AI technology, lightweight, easy to use, free, and without advertisements",
    "homepage": "https://www.xiaowang.com",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://ai-search-static.dangbei.net/ai-screenshot-updates/xw-screenshot-setup.exe#/dl.7z",
            "hash": "9545cca66b1aae5332bc19609ebddb5839f32984465d647daf71f9babd3fc558"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\wang-screenshot.exe",
            "小旺 AI 截图"
        ]
    ],
    "link": "$env:AppData\\com.wangscreenshot.app",
    "cleanup": "$env:LocalAppData\\com.wangscreenshot.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Dangbei.XiaowangScreenshot",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.7z",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
