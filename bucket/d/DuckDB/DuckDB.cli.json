{
    "version": "1.5.6",
    "description": "一种用于过程分析的 SQL 数据库管理系统 | An analytical in-process SQL database management system",
    "homepage": "http://www.duckdb.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/duckdb/duckdb/releases/download/v1.5.6/duckdb_cli-windows-amd64.zip",
            "hash": "798eae475d07c645ff3b914f7b0e676d06502b5412dd7552638fafed81f9e916"
        },
        "arm64": {
            "url": "https://github.com/duckdb/duckdb/releases/download/v1.5.6/duckdb_cli-windows-arm64.zip",
            "hash": "266052dbf513da86d0d90209db09ec56e79af75b7fbe2d952810526dfc5d2726"
        }
    },
    "extract_to": "app",
    "bin": "app\\duckdb.exe",
    "link": "$home\\.duckdb",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/duckdb/duckdb/releases/download/v$version/duckdb_cli-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/duckdb/duckdb/releases/download/v$version/duckdb_cli-windows-arm64.zip"
            }
        }
    }
}
