{
    "version": "1.12.0",
    "description": "一个本地的开源人工智能应用构建工具。它速度快、注重隐私，且完全在你的掌控之中 —— 就像 Lovable、v0 或 Bolt 一样，但能直接在你的设备上运行 | A local, open-source AI app builder. It's fast, private, and fully under your control — like Lovable, v0, or Bolt, but running right on your machine",
    "homepage": "https://dyad.sh",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/dyad-sh/dyad/releases/download/v1.12.0/dyad-1.12.0.Setup.exe",
            "hash": "1da2b6d4f456611cb89fac21021af5237e6828a2efc4200570ed702683510e87"
        }
    },
    "location": "$env:LocalAppData\\dyad",
    "link": "$env:AppData\\dyad",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'Update.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App -ArgumentList '--uninstall'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dyad-sh/dyad/releases/download/v$version/dyad-$version.Setup.exe"
            }
        }
    }
}
