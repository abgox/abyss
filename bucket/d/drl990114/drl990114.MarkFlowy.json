{
    "version": "1.2.3",
    "description": "一个跨平台 Markdown 编辑器，但是更轻快、更智能、更纯粹 | A cross platform Markdown editor, but it is lighter, smarter, and purer",
    "homepage": "https://www.markflowy.cc",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/drl990114/MarkFlowy/releases/download/v1.2.3/MarkFlowy_v1.2.3_x64-setup.exe",
            "hash": "68f9e0996ae4b95c855a69474d4d53925878c23fa43bb68be431d68162f4b82b"
        }
    },
    "shortcuts": [
        [
            "app\\markflowy.exe",
            "MarkFlowy"
        ]
    ],
    "link": [
        "$env:AppData\\com.drl990114.markflowy",
        "$home\\.markflowy"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drl990114/MarkFlowy/releases/download/v$version/MarkFlowy_v$version_x64-setup.exe"
            }
        }
    }
}
