{
    "version": "0.20.0",
    "description": "一款用于 git、diff、grep 和 blame 输出的语法高亮分页器 | A syntax-highlighting pager for git, diff, grep, and blame output",
    "homepage": "https://dandavison.github.io/delta",
    "license": {
        "identifier": "MIT"
    },
    "depends": "abyss/jftuga.less",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dandavison/delta/releases/download/0.20.0/delta-0.20.0-x86_64-pc-windows-msvc.zip",
            "hash": "f1338f6f364abd4b471c45368271a7ef4bc6a87c4dbcf917f4940068176172c9",
            "extract_dir": "delta-0.20.0-x86_64-pc-windows-msvc"
        }
    },
    "extract_to": "app",
    "bin": "app\\delta.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dandavison/delta/releases/download/$version/delta-$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "delta-$version-x86_64-pc-windows-msvc"
            }
        }
    }
}
