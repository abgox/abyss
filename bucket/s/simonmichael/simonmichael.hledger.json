{
    "version": "1.52.4",
    "description": "一款功能强大、速度快、直观的纯文本会计工具，具有 CLI、TUI 和 Web 界面 | Robust, fast, intuitive plain text accounting tool with CLI, TUI and web interfaces",
    "homepage": "https://hledger.org",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/simonmichael/hledger/releases/download/1.52.4/hledger-windows-x64.zip",
            "hash": "2921b1c61b4d8ff32622b5eff01de4d5e7e166cb456e89002d42640f474b6fde"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\hledger-ui.exe",
        "app\\hledger-web.exe",
        "app\\hledger.exe"
    ],
    "link": "$home\\.hledger.journal",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-New-File \"$home\\.hledger.journal\" -Content \"; journal created $(Get-Date -Format 'yyyy-MM-dd')\"",
        "A-New-Link"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/simonmichael/hledger/releases/download/$version/hledger-windows-x64.zip"
            }
        }
    }
}
