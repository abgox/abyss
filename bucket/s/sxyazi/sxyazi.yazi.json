{
    "version": "26.8.15",
    "description": "一个用 Rust 编写的终端文件管理器，基于非阻塞异步 I/O | A terminal file manager written in Rust, based on non-blocking async I/O",
    "homepage": "https://yazi-rs.github.io",
    "license": {
        "identifier": "MIT"
    },
    "suggest": {
        "fd": "abyss/sharkdp.fd",
        "ripgrep": "abyss/BurntSushi.ripgrep.MSVC"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/sxyazi/yazi/releases/download/v26.8.15/yazi-x86_64-pc-windows-msvc.zip",
            "hash": "451f6770999fa8f9b08e6c9f94a688c263b6d3007b0944c4407f1ae335eace30",
            "extract_dir": "yazi-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/sxyazi/yazi/releases/download/v26.8.15/yazi-aarch64-pc-windows-msvc.zip",
            "hash": "e20be1bf57a3c06f444b46aac76c1aaa6d2e2fceb1da393d94b959ba8a2458ff",
            "extract_dir": "yazi-aarch64-pc-windows-msvc"
        }
    },
    "conflicts": [
        "sxyazi.yazi",
        "sxyazi.yazi.nightly"
    ],
    "extract_to": "app",
    "env_set": {
        "YAZI_FILE_ONE": "$env:ProgramFiles\\Git\\usr\\bin\\file.exe"
    },
    "bin": [
        "app\\ya.exe",
        "app\\yazi.exe"
    ],
    "link": "$env:AppData\\yazi",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sxyazi/yazi/releases/download/v$version/yazi-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/sxyazi/yazi/releases/download/v$version/yazi-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
