{
    "version": "26.9.1",
    "description": "一个用 Rust 编写的终端文件管理器，基于非阻塞异步 I/O | A terminal file manager written in Rust, based on non-blocking async I/O",
    "homepage": "https://yazi-rs.github.io",
    "license": {
        "identifier": "MIT"
    },
    "suggest": {
        "fd": "abyss/sharkdp.fd",
        "ripgrep": "abyss/BurntSushi.ripgrep.MSVC"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/sxyazi/yazi/releases/download/v26.9.1/yazi-x86_64-pc-windows-msvc.zip",
            "hash": "7c033e5f2de6355fd03d865319053fc97db780275974ed17653c057f5d0f8d21",
            "extract_dir": "yazi-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/sxyazi/yazi/releases/download/v26.9.1/yazi-aarch64-pc-windows-msvc.zip",
            "hash": "4d50878132db344dc208f84d8db0799f00905aa36dec30f63beb826f7c760b12",
            "extract_dir": "yazi-aarch64-pc-windows-msvc"
        }
    },
    "conflicts": [
        "sxyazi.yazi",
        "sxyazi.yazi.nightly"
    ],
    "extract_to": "app",
    "env_set": {
        "YAZI_FILE_ONE": "$env:ProgramFiles\\Git\\usr\\bin\\file.exe"
    },
    "bin": [
        "app\\ya.exe",
        "app\\yazi.exe"
    ],
    "link": "$env:AppData\\yazi",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sxyazi/yazi/releases/download/v$version/yazi-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/sxyazi/yazi/releases/download/v$version/yazi-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
