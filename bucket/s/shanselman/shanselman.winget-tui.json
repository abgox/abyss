{
    "version": "0.14.0",
    "description": "适用于 WinGet 的终端用户界面 | A TUI for WinGet",
    "homepage": "https://github.com/shanselman/winget-tui",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/shanselman/winget-tui/releases/download/v0.14.0/winget-tui-x64.exe#/winget-tui.exe",
            "hash": "ece531c102c6a805f2c5c88e5521b6415ecb84dcfca909495ee24ec3f7030adb"
        },
        "arm64": {
            "url": "https://github.com/shanselman/winget-tui/releases/download/v0.14.0/winget-tui-arm64.exe#/winget-tui.exe",
            "hash": "ea8712aa246176c3ae4e472d3c44951e3fec46e69c6915ac1bde8b57a5704d3a"
        }
    },
    "extract_to": "app",
    "bin": "app\\winget-tui.exe",
    "link": "$env:AppData\\winget-tui",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/shanselman/winget-tui/releases/download/v$version/winget-tui-x64.exe#/winget-tui.exe"
            },
            "arm64": {
                "url": "https://github.com/shanselman/winget-tui/releases/download/v$version/winget-tui-arm64.exe#/winget-tui.exe"
            }
        }
    }
}
