{
    "version": "0.12.0",
    "description": "一个快速的、键盘驱动的 Git 终端 UI，用 Zig 编写 | A fast, keyboard driven terminal UI for Git, written in Zig",
    "homepage": "https://github.com/simoarpe/ziggity",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/simoarpe/ziggity/releases/download/v0.12.0/ziggity-v0.12.0-x86_64-windows-gnu.zip",
            "hash": "12ec2119202f300e5cac8891ee1bac1d4d0d330670e160a464d3af5083bc387c"
        }
    },
    "extract_to": "app",
    "bin": "app\\ziggity.exe",
    "link": "$home\\.config\\ziggity",
    "cleanup": "$env:LocalAppData\\ziggity",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/simoarpe/ziggity/releases/download/v$version/ziggity-v$version-x86_64-windows-gnu.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
