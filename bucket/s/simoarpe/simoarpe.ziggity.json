{
    "version": "0.26.0",
    "description": "一个快速的、键盘驱动的 Git 终端 UI，用 Zig 编写 | A fast, keyboard driven terminal UI for Git, written in Zig",
    "homepage": "https://github.com/simoarpe/ziggity",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/simoarpe/ziggity/releases/download/v0.26.0/ziggity-v0.26.0-x86_64-windows-gnu.zip",
            "hash": "f6f2800eb81d2265c37e5e7dbf33ea15f2a61ae55e29f92691aabc2ac0da1594"
        }
    },
    "extract_to": "app",
    "bin": "app\\ziggity.exe",
    "link": "$home\\.config\\ziggity",
    "cleanup": "$env:LocalAppData\\ziggity",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/simoarpe/ziggity/releases/download/v$version/ziggity-v$version-x86_64-windows-gnu.zip"
            }
        }
    }
}
