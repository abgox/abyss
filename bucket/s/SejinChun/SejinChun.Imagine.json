{
    "version": "2.7.1",
    "description": "一款适用于 Windows 系统的免费、轻量级图像和动画查看器 | A free, lightweight image and animation viewer for Windows",
    "homepage": "https://www.nyam.pe.kr/dev/imagine",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.nyam.pe.kr/dev/imagine/#license"
    },
    "architecture": {
        "64bit": {
            "url": "https://raw.githubusercontent.com/nyam1003/imagine/main/x64/Imagine_2.7.1_x64_Unicode_Full.zip",
            "hash": "b536676cb4ea175479aaed2c2f941387f4c0350cfbf3b9624cde39a37930d17d",
            "bin": [
                "app\\Imagine64.exe",
                [
                    "app\\Imagine64.exe",
                    "Imagine"
                ]
            ],
            "shortcuts": [
                [
                    "app\\Imagine64.exe",
                    "Imagine"
                ]
            ]
        },
        "arm64": {
            "url": "https://raw.githubusercontent.com/nyam1003/imagine/main/arm64/Imagine_2.7.1_arm64_Unicode_Full.zip",
            "hash": "c7fdeac2f5a889b2d99d61f23a3e87b229d803c0bf5b4650119bea71e4d15181",
            "bin": [
                "app\\ImagineA64.exe",
                [
                    "app\\ImagineA64.exe",
                    "Imagine"
                ]
            ],
            "shortcuts": [
                [
                    "app\\ImagineA64.exe",
                    "Imagine"
                ]
            ]
        }
    },
    "extract_to": "app",
    "link": "$env:AppData\\Imagine",
    "persist": [
        [
            "app\\Imagine.ini",
            "Imagine.ini"
        ],
        [
            "app\\PlugInst.inf",
            "PlugInst.inf"
        ],
        [
            "app\\Plugin",
            "Plugin"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://www.nyam.pe.kr/dev/imagine/",
        "regex": "v(\\d[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://raw.githubusercontent.com/nyam1003/imagine/main/x64/Imagine_$version_x64_Unicode_Full.zip"
            },
            "arm64": {
                "url": "https://raw.githubusercontent.com/nyam1003/imagine/main/arm64/Imagine_$version_arm64_Unicode_Full.zip"
            }
        }
    }
}
