{
    "version": "1.1308.1",
    "description": "Snyk CLI 会扫描并监控你的项目，以查找安全漏洞 | Snyk CLI scans and monitors your projects for security vulnerabilities",
    "homepage": "https://snyk.io",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/snyk/cli/releases/download/v1.1308.1/snyk-win.exe",
            "hash": "17279c121efbf34681db15082346d9c8d0dd5e6e140686036356c1e74d711dfd"
        }
    },
    "extract_to": "app",
    "bin": [
        [
            "app\\snyk-win.exe",
            "snyk"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/snyk/cli/releases/download/v$version/snyk-win.exe"
            }
        }
    }
}
