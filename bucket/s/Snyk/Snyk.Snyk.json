{
    "version": "1.1308.0",
    "description": "Snyk CLI 会扫描并监控你的项目，以查找安全漏洞 | Snyk CLI scans and monitors your projects for security vulnerabilities",
    "homepage": "https://snyk.io",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/snyk/cli/releases/download/v1.1308.0/snyk-win.exe",
            "hash": "25604b23be3b07e629ff5d6dc100ff3a315e2d992852420939c09970cd0095f8"
        }
    },
    "extract_to": "app",
    "bin": [
        [
            "app\\snyk-win.exe",
            "snyk"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/snyk/cli/releases/download/v$version/snyk-win.exe"
            }
        }
    }
}
