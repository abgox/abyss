{
    "version": "3.9.9",
    "description": "适用于 Windows 的高性能本地文件检索与效率启动工具 | High-performance local file search and productivity launcher for Windows",
    "homepage": "https://swiftlist.github.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/SwiftList/SwiftList/releases/download/v3.9.9/SwiftList-Setup.exe",
            "hash": "eaff032dcea45807d3ef23fa8c502e4022200bdc7f58408536768f2bccae52cf"
        }
    },
    "shortcuts": [
        [
            "app\\SwiftList.App.exe",
            "SwiftList"
        ]
    ],
    "link": "$env:LocalAppData\\SwiftList",
    "cleanup": "$env:ProgramData\\SwiftList",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SwiftList/SwiftList/releases/download/v$version/SwiftList-Setup.exe"
            }
        }
    }
}
