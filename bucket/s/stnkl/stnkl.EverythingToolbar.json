    "homepage": "https://github.com/srwi/EverythingToolbar",
    "license": {
        "identifier": "MIT,Apache,..."
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/srwi/EverythingToolbar/releases/download/3.3.0/EverythingToolbar-3.3.0-x64.exe",
            "hash": "0d2c6895150f5977d218f22f4ba07f4285a1d2f441bf2f7a5244811ba3efed82"
        }
    },
    "shortcuts": [
        [
            "app\\EverythingToolbar.Launcher.exe",
            "EverythingToolbar"
        ]
    ],
    "link": "$env:AppData\\EverythingToolbar",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/srwi/EverythingToolbar/releases/download/$version/EverythingToolbar-$version-x64.exe"
            }
        }
