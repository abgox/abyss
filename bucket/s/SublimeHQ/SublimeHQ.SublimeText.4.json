{
    "version": "4.0.0.420000",
    "description": "一款用于代码、标记和散文的复杂跨平台文本编辑器 | A sophisticated cross-platform text editor for code, markup and prose",
    "homepage": "https://www.sublimetext.com",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.sublimetext.com/eula"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.sublimetext.com/sublime_text_build_4200_x64_setup.exe",
            "hash": "3d3c70e51aef08f85d7160bcc70793bed9acec250973090ab67d98987bce7c7e"
        }
    },
    "bin": "app\\subl.exe",
    "shortcuts": [
        [
            "app\\sublime_text.exe",
            "Sublime Text 4"
        ]
    ],
    "persist": [
        [
            "app\\Data",
            "AppData\\Roaming\\Sublime Text"
        ]
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "SublimeHQ.SublimeText.4",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
