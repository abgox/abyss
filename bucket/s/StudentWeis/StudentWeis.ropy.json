{
    "version": "0.5.5",
    "description": "一款采用 Rust 与 GPUI 编写的跨平台轻量级剪贴板管理工具 | Cross-platform, lightweight clipboard manager written in Rust and GPUI",
    "homepage": "https://github.com/StudentWeis/ropy",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/StudentWeis/ropy/releases/download/0.5.5/ropy-x86_64-pc-windows-msvc.zip",
            "hash": "fab4a9e50efdb3496976ffda991121b7623f0120fc7b82531e07fc5f29c54f15"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\ropy.exe",
            "Ropy"
        ]
    ],
    "link": [
        "$env:AppData\\ropy",
        "$env:LocalAppData\\ropy"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/StudentWeis/ropy/releases/download/$version/ropy-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
