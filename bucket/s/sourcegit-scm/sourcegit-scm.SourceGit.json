            "hash": "66e12ca936a286136e05a80caaed97c177096ebfe714cf613dc6dac7fcb7f43f"
        },
        "arm64": {
            "url": "https://github.com/sourcegit-scm/sourcegit/releases/download/v2026.19/sourcegit_2026.19.win-arm64.zip",
            "hash": "c52dd77cfe28e3cb5947e1f83b291bd868630ce525560e80c6e5887e3d430021"
        }
