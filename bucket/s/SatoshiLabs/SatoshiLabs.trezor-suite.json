{
    "version": "26.9.3",
    "description": "用于管理 Trezor 硬件钱包的桌面应用程序 | Desktop application for managing Trezor hardware wallet",
    "homepage": "https://github.com/trezor/trezor-suite",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/trezor/trezor-suite/releases/download/v26.9.3/Trezor-Suite-26.9.3-win-x64.exe",
            "hash": "2c157989194533be4b5647ed167c2a418687d0063275155748d26ca5f4a552c9"
        }
    },
    "shortcuts": [
        [
            "app\\Trezor Suite.exe",
            "Trezor Suite"
        ]
    ],
    "link": "$env:AppData\\@trezor\\suite-desktop",
    "cleanup": "$env:LocalAppData\\@trezorsuite-desktop-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Trezor Suite.exe' -ArgumentList '/CurrentUser','/S',\"/D=$dir\\app\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "SatoshiLabs.trezor-suite",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
