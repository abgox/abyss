    "homepage": "https://schollz.com/software/croc6",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/schollz/croc/releases/download/v11.0.0/croc_v11.0.0_Windows-64bit.zip",
            "hash": "b6fb240481d4a650932694c909bb266a891dec5979cf425bb87bce725f1859aa"
        },
        "arm64": {
            "url": "https://github.com/schollz/croc/releases/download/v11.0.0/croc_v11.0.0_Windows-ARM64.zip",
            "hash": "dca4f20fbb88f5fb5d0e86b54c99be8a80f9150a3bb9a8a25708783a476cbc21"
        }
    },
    "extract_to": "app",
    "bin": "app\\croc.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/schollz/croc/releases/download/v$version/croc_v$version_Windows-64bit.zip"
            },
            "arm64": {
                "url": "https://github.com/schollz/croc/releases/download/v$version/croc_v$version_Windows-ARM64.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
