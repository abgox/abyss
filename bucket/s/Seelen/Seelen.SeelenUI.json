{
    "version": "2.8.8",
    "description": "适用于 Windows 的完全可定制的桌面环境 | Fully Customizable Desktop Environment for Windows",
    "homepage": "https://github.com/eythaann/Seelen-UI",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/eythaann/Seelen-UI/releases/download/v2.8.8/Seelen.UI_2.8.8.0_x64.Msix",
            "hash": "6b21f0380e5a097bac1f09cc9f7d03448c9fdd8a67969e8cceda9e5713f12999"
        }
    },
    "msix": "Seelen.SeelenUI_p6yyn03m1894e",
    "link": "$env:AppData\\com.seelen.seelen-ui",
    "cleanup": "$env:LocalAppData\\com.seelen.seelen-ui",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Seelen.SeelenUI",
            "ext": "msix"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
