            "hash": "403d446d6ca9a9f2edb694d0ecf64c2be7468facade100b9d6e9e65430672bd2"
        },
        "arm64": {
            "url": "https://github.com/anomalyco/opencode/releases/download/v1.18.34/opencode-desktop-win-arm64.exe",
