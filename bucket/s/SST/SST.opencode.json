    "homepage": "https://opencode.ai",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/sst/opencode/releases/download/v1.18.9/opencode-windows-x64.zip",
            "hash": "1becf92ceb23edd7d951e7e3d8efcbe9c9808f5cc728f1b75277d5f951ada5c2"
        },
        "arm64": {
            "url": "https://github.com/sst/opencode/releases/download/v1.18.9/opencode-windows-arm64.zip",
