{
    "version": "2.0.13",
    "description": "一个开源、安全、跨平台的密码管理器 | An open-source, secure, and cross-platform password manager",
    "homepage": "https://github.com/loganchef/Ciphora",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/loganchef/Ciphora/releases/download/v2.0.13/Ciphora_2.0.13_x64-setup.exe",
            "hash": "e23e379ae02c45879ad009611c68a48982bc09d52d86921c09c7987a2c7e5e92"
        }
    },
    "shortcuts": [
        [
            "app\\Ciphora.exe",
            "Ciphora"
        ]
    ],
    "link": "$env:AppData\\com.ciphora.password-manager",
    "cleanup": "$env:LocalAppData\\com.ciphora.password-manager",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/loganchef/Ciphora/releases/download/v$version/Ciphora_$version_x64-setup.exe"
            }
        }
    }
}
