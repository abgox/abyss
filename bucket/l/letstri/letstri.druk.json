{
    "version": "1.37.0",
    "description": "一款运行在终端中的代码编辑器 | A code editor that lives in your terminal",
    "homepage": "https://druk.sh",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/letstri/druk/releases/download/v1.37.0/druk-windows-x64.zip",
            "hash": "a89268569a48d020f56a44f7d01dc6e5e0d76d56e83696a0b8ef6e675fe5e6a3"
        }
    },
    "extract_to": "app",
    "bin": "app\\druk.exe",
    "link": "$home\\.config\\druk",
    "cleanup": "$home\\.cache\\druk",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/letstri/druk/releases/download/v$version/druk-windows-x64.zip"
            }
        }
    }
}
