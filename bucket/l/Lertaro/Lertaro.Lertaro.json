{
    "version": "5.4.7",
    "description": "适用于 Windows 的高性能本地文件检索与效率启动工具 | High-performance local file search and productivity launcher for Windows",
    "homepage": "https://lertaro.github.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.4.7/Lertaro-Setup.exe",
            "hash": "078386201450d7a96c67148184a2a78b53fecb507c03ba2962f18a092cc52c4c"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.4.7/Lertaro-Setup-arm64.exe",
            "hash": "33480a5ebf9906402eb96994933eb0a2f6b703a5d961eef6dae4e9b0c7a4ed79"
        }
    },
    "shortcuts": [
        [
            "app\\Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "link": "$env:LocalAppData\\Lertaro",
    "cleanup": "$env:ProgramData\\Lertaro",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup-arm64.exe"
            }
        }
    }
}
