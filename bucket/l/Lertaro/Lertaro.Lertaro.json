{
    "version": "5.11.0",
    "description": "适用于 Windows 的高性能本地文件检索与效率启动工具 | High-performance local file search and productivity launcher for Windows",
    "homepage": "https://lertaro.github.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.11.0/Lertaro-Setup.exe",
            "hash": "a52f92b2ea5aebd293230856c7a5ba9aaf4d64eb4194a4e4a97e30f8cb58c8d8"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.11.0/Lertaro-Setup-arm64.exe",
            "hash": "2b9926d5f704a92b192a91e3ed23d3b142a72969da0413ba41b9ae0907fe6e0a"
        }
    },
    "shortcuts": [
        [
            "app\\Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "link": "$env:LocalAppData\\Lertaro",
    "cleanup": "$env:ProgramData\\Lertaro",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup-arm64.exe"
            }
        }
    }
}
