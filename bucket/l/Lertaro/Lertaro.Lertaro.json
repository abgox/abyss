{
    "version": "5.6.7",
    "description": "适用于 Windows 的高性能本地文件检索与效率启动工具 | High-performance local file search and productivity launcher for Windows",
    "homepage": "https://lertaro.github.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.6.7/Lertaro-Setup.exe",
            "hash": "1de6068fb616697901227751391d68a5ffbcd31a34951470d1679c192fe11e18"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.6.7/Lertaro-Setup-arm64.exe",
            "hash": "fcac6501686f7ee2b921013263563c7087d1abc52ee3ec79716900d5db4ea6ec"
        }
    },
    "shortcuts": [
        [
            "app\\Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "link": "$env:LocalAppData\\Lertaro",
    "cleanup": "$env:ProgramData\\Lertaro",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup-arm64.exe"
            }
        }
    }
}
