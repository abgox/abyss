{
    "version": "6.2.1",
    "description": "一款受 Postman 启发的开源 API 调试和性能测试桌面应用程序 | An open-source API debugging & performance testing desktop app inspired by Postman",
    "homepage": "https://github.com/lakernote/EasyPostman",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/lakernote/EasyPostman/releases/download/v6.2.1/EasyPostman-6.2.1-windows-x64-portable.zip",
            "hash": "3f187ec1f3693ecc36368f77584d955262c315622633047e36f3640ba77efbe6"
        }
    },
    "extract_dir": "EasyPostman",
    "extract_to": "app",
    "bin": "app\\EasyPostman.exe",
    "shortcuts": [
        [
            "app\\EasyPostman.exe",
            "EasyPostman"
        ]
    ],
    "link": "$home\\EasyPostman",
    "persist": [
        [
            "app\\app\\data",
            "EasyPostman"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lakernote/EasyPostman/releases/download/v$version/EasyPostman-$version-windows-x64-portable.zip"
            }
        }
    }
}
