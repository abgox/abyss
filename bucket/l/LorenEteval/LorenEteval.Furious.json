    "homepage": "https://github.com/LorenEteval/Furious",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/LorenEteval/Furious/releases/download/0.8.2/Furious-0.8.2-windows10-amd64.zip",
            "hash": "8d89aba0bc65666dc02fe7ebb364fd719364474eeaebe1a8d2f3da2d6b7451cb"
        }
    },
    "extract_dir": "Furious-0.8.2-windows",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\Furious.exe",
            "Furious"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LorenEteval/Furious/releases/download/$version/Furious-$version-windows10-amd64.zip"
            }
        },
        "extract_dir": "Furious-$version-windows"
    }
}
