{
    "version": "26.03",
    "description": "一个拥有极高压缩比的开源压缩软件 | A file archiver with a high compression ratio",
    "homepage": "https://7-zip.org",
    "license": {
        "identifier": "Unknown",
        "url": "https://7-zip.org/license.txt"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ip7z/7zip/releases/download/26.03/7z2603-x64.msi#/dl.msi_",
            "hash": "c0680064d698a62dd4a5a47f403db356a6531a5473e4c4b1d090ea2590513926"
        }
    },
    "location": "$env:ProgramFiles\\7-Zip",
    "env_add_path_expand": "$env:ProgramFiles\\7-Zip",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "if ($cmd -eq 'update') { return }",
        "A-Uninstall-Manually"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ip7z/7zip/releases/download/$version/7z$cleanVersion-x64.msi#/dl.msi_"
            }
        }
    }
}
