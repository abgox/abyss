{
    "version": "0.10.1",
    "description": "一款命令行代码打字游戏，能将你的源代码转化为打字挑战 | A CLI code-typing game that turns your source code into typing challenges",
    "homepage": "https://github.com/unhappychoice/gittype",
    "license": {
        "identifier": "MIT|Apache-2.0|..."
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/unhappychoice/gittype/releases/download/v0.10.1/gittype-v0.10.1-x86_64-pc-windows-msvc.zip",
            "hash": "c9d3d7ad28c8c95f27c46badd8aff6a0cb26d76f91ea1971079d6cb1ac2aaf76"
        }
    },
    "extract_to": "app",
    "bin": "app\\gittype.exe",
    "link": "$home\\.gittype",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/unhappychoice/gittype/releases/download/v$version/gittype-v$version-x86_64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
