{
    "version": "0.12.0",
    "description": "一款适用于终端的 Git 提交回放影视化工具，能将你的 Git 提交记录转化为生动的动态故事 | A cinematic Git commit replay tool for the terminal, turning your Git history into a living, animated story",
    "homepage": "https://github.com/unhappychoice/gitlogue",
    "license": {
        "identifier": "ISC"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/unhappychoice/gitlogue/releases/download/v0.12.0/gitlogue-v0.12.0-x86_64-pc-windows-msvc.zip",
            "hash": "86bf47a33e6efd01f6d1bfe1d881beef68f1dd44e4573c68672d92069045d144"
        }
    },
    "extract_to": "app",
    "bin": "app\\gitlogue.exe",
    "link": "$home\\.config\\gitlogue",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/unhappychoice/gitlogue/releases/download/v$version/gitlogue-v$version-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
