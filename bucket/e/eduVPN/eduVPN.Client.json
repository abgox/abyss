{
    "version": "4.6.3",
    "description": "使用加密连接访问您所在机构的网络或互联网 | Access your institute's network or the Internet using an encrypted connection",
    "homepage": "https://www.eduvpn.org",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://codeberg.org/eduVPN/windows/src/branch/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://app.eduvpn.org/windows/eduVPNClient_4.6.3_x64.msi#/dl.msi_",
            "hash": "1f74e31e8360a49fc8c73eaabf05e4a8331c71f5f0c9ba2db852fd13e7c37b00"
        },
        "arm64": {
            "url": "https://app.eduvpn.org/windows/eduVPNClient_4.6.3_ARM64.msi#/dl.msi_",
            "hash": "eae8e9b8e4deced19ecc1a0eb762834cd26ed4b6ccdb2f63c5566db6b91be03b"
        }
    },
    "location": "$env:ProgramFiles\\eduVPN",
    "cleanup": "$env:LocalAppData\\eduVPN",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "eduVPN.Client",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
