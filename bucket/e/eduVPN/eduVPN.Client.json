{
    "version": "4.6.2",
    "description": "使用加密连接访问您所在机构的网络或互联网 | Access your institute's network or the Internet using an encrypted connection",
    "homepage": "https://www.eduvpn.org",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://codeberg.org/eduVPN/windows/src/branch/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://app.eduvpn.org/windows/eduVPNClient_4.6.2_x64.msi#/dl.msi_",
            "hash": "1eb79e6ee8da4cf8f592e24afd57c953973364f8726cccb83e3fcaf193a6a3ca"
        },
        "arm64": {
            "url": "https://app.eduvpn.org/windows/eduVPNClient_4.6.2_ARM64.msi#/dl.msi_",
            "hash": "a0233239baa168ca4df5c168d9e7f20c539039dc6836d009185e085023739476"
        }
    },
    "location": "$env:ProgramFiles\\eduVPN",
    "cleanup": "$env:LocalAppData\\eduVPN",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "eduVPN.Client",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
