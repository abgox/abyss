{
    "version": "4.6.1",
    "description": "使用加密连接访问您所在机构的网络或互联网 | Access your institute's network or the Internet using an encrypted connection",
    "homepage": "https://www.eduvpn.org",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://codeberg.org/eduVPN/windows/src/branch/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://app.eduvpn.org/windows/eduVPNClient_4.6.1_x64.msi#/dl.msi_",
            "hash": "4746b52250ffebdd3498ce6f324675dddd7863af3527f78f2141a637df09816d"
        },
        "arm64": {
            "url": "https://app.eduvpn.org/windows/eduVPNClient_4.6.1_ARM64.msi#/dl.msi_",
            "hash": "fd8596364dc268036093503572595104c9dccb350995907473a5d5fb46ee49f8"
        }
    },
    "location": "$env:ProgramFiles\\eduVPN",
    "cleanup": "$env:LocalAppData\\eduVPN",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Msi"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Msi"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "eduVPN.Client",
            "ext": "msi"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            },
            "arm64": {
                "url": "$matchArm64#/dl.msi_",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_machine.InstallerSha256"
                }
            }
        }
    }
}
