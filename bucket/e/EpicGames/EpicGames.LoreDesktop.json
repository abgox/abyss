{
    "version": "0.9.2",
    "description": "开源的新一代版本控制系统 | Next-generation, open source version control system",
    "homepage": "https://lore.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://releases.lore.org/desktop/updates/stable/lore-desktop-v0.9.2-win-x86_64.exe",
            "hash": "048e68d865ad748bf464fcdd651847bf399d04f3ddc85b44faaf2d6957b65d90"
        }
    },
    "shortcuts": [
        [
            "app\\lore-desktop.exe",
            "Lore Desktop"
        ]
    ],
    "link": "$env:AppData\\lore-desktop",
    "cleanup": "$env:LocalAppData\\lore-desktop-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall lore-desktop.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "EpicGames.LoreDesktop",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://releases.lore.org/desktop/updates/stable/lore-desktop-v$version-win-x86_64.exe"
            }
        }
    }
}
