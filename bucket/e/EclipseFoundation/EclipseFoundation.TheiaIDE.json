{
    "version": "1.74.100",
    "description": "Eclipse Theia 是一款基于 Theia 平台构建的适用于云端和桌面端的现代化、原生支持人工智能的集成开发环境 | Eclipse Theia is a modern, AI-native IDE for cloud and desktop built on the Theia Platform",
    "homepage": "https://theia-ide.org",
    "license": {
        "identifier": "EPL-2.0|GPL-2.0|MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.eclipse.org/theia/ide/1.74.100/windows/TheiaIDESetup-1.74.100.exe",
            "hash": "8258cc2ab7bf7a195ed7b812c9dbca77e65ea29955ddd996f86af6ec41e0f226"
        }
    },
    "shortcuts": [
        [
            "app\\TheiaIDE.exe",
            "TheiaIDE"
        ]
    ],
    "link": [
        "$env:AppData\\Theia IDE",
        "$home\\.theia-ide"
    ],
    "cleanup": "$env:LocalAppData\\theia-ide-electron-app-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall TheiaIDE.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "EclipseFoundation.TheiaIDE",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
