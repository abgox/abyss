    "homepage": "https://github.com/Empty-57/ZeroBit-Player",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Empty-57/ZeroBit-Player/releases/download/v2.0.0/zerobit_player.zip",
            "hash": "3fd4fdc024eff2c165d65494e7ed07609b372d533614d4814e5fbce4ffd7b614"
        }
    },
    "extract_dir": "zerobit_player",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\zerobit_player.exe",
