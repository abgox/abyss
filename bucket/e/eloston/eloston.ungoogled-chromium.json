        "arm64": {
            "url": "https://github.com/ungoogled-software/ungoogled-chromium-windows/releases/download/154.0.8037.57-1.1/ungoogled-chromium_154.0.8037.57-1.1_installer_arm64.exe",
            "hash": "1ad86e0d8be07bc4ce8ae43beba1ab355508b643ac5bca32a81b20b852aea10c"
