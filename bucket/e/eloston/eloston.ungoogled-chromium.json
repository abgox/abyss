        "arm64": {
            "url": "https://github.com/ungoogled-software/ungoogled-chromium-windows/releases/download/155.0.8059.79-1.1/ungoogled-chromium_155.0.8059.79-1.1_installer_arm64.exe",
            "hash": "ba627f2cf34bd407ad97c856fce1e45e43a0f6a4a291c2aa499231f9f4c33725"
        }
