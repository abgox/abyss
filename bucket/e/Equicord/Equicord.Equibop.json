            "hash": "c461c07a2e9b7fbe0d0df1e5f325df9d9aa3315857ac35a75c865a04a5bc562c"
        },
        "arm64": {
            "url": "https://github.com/Equicord/Equibop/releases/download/v3.3.0/Equibop-Setup-3.3.0.exe",
            "hash": "c461c07a2e9b7fbe0d0df1e5f325df9d9aa3315857ac35a75c865a04a5bc562c"
        }
    },
    "shortcuts": [
        [
            "app\\equibop.exe",
            "Equibop"
        ]
    ],
    "link": "$env:AppData\\equibop",
    "cleanup": "$env:LocalAppData\\equibop-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Equibop.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Equicord/Equibop/releases/download/v$version/Equibop-Setup-$version.exe"
            },
            "arm64": {
                "url": "https://github.com/Equicord/Equibop/releases/download/v$version/Equibop-Setup-$version.exe"
            }
        }
    }
}
