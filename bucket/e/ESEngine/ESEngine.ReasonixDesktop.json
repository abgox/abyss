{
    "version": "1.38.12",
    "description": "面向终端的 DeepSeek 原生 AI 编码智能体 | A DeepSeek-native AI coding agent for your terminal",
    "homepage": "https://reasonix.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.38.12/Reasonix-windows-amd64-installer.exe",
            "hash": "48ac5420afe06645c26d6d97702bd7aa6303ce09be17b1587cea3cdf86180819"
        },
        "arm64": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.38.12/Reasonix-windows-arm64-installer.exe",
            "hash": "e816a31310ccca2305c6b6279b708ca0e4fdaad304011d35f05d3093f63a839c"
        }
    },
    "env_set_shared": {
        "REASONIX_HOME": {
            "value": "$scoopdir\\persist\\@abgox.abyss\\AppData\\Roaming\\reasonix",
            "owner": [
                "ESEngine.ReasonixCLI",
                "ESEngine.ReasonixDesktop"
            ]
        }
    },
    "shortcuts": [
        [
            "app\\reasonix-launcher.exe",
            "Reasonix"
        ]
    ],
    "link": "$env:AppData\\reasonix",
    "cleanup": "$env:LocalAppData\\reasonix-desktop.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "stable"
        },
        "regex": "desktop-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-amd64-installer.exe"
            },
            "arm64": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-arm64-installer.exe"
            }
        }
    }
}
