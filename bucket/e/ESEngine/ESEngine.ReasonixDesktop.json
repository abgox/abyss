{
    "version": "1.38.8",
    "description": "面向终端的 DeepSeek 原生 AI 编码智能体 | A DeepSeek-native AI coding agent for your terminal",
    "homepage": "https://reasonix.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.38.8/Reasonix-windows-amd64-installer.exe",
            "hash": "2aa89766823083eca2f3e6ae95a4410f96ba1c6bc4ec0162022542861bd85e8c"
        },
        "arm64": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.38.8/Reasonix-windows-arm64-installer.exe",
            "hash": "66f2db5b476b0759f75179b2d57f1f4e0b18be04fa25984c69160ff4b6028d60"
        }
    },
    "env_set_shared": {
        "REASONIX_HOME": {
            "value": "$scoopdir\\persist\\abgox.abyss\\AppData\\Roaming\\reasonix",
            "owner": [
                "ESEngine.ReasonixCLI",
                "ESEngine.ReasonixDesktop"
            ]
        }
    },
    "shortcuts": [
        [
            "app\\reasonix-launcher.exe",
            "Reasonix"
        ]
    ],
    "link": "$env:AppData\\reasonix",
    "cleanup": "$env:LocalAppData\\reasonix-desktop.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "stable"
        },
        "regex": "desktop-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-amd64-installer.exe"
            },
            "arm64": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-arm64-installer.exe"
            }
        }
    }
}
