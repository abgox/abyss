{
    "version": "1.39.8",
    "description": "面向终端的 DeepSeek 原生 AI 编码智能体 | A DeepSeek-native AI coding agent for your terminal",
    "homepage": "https://reasonix.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.39.8/Reasonix-windows-amd64-installer.exe",
            "hash": "c94a419b2f9d2edb85c1c2e948f6ff65bca27e5dbb2ef3f5d87ac399742a4cc7"
        },
        "arm64": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.39.8/Reasonix-windows-arm64-installer.exe",
            "hash": "06d3a616c014b531c174697ab725bec0d462b7cd55c3028b28a732f5747ae604"
        }
    },
    "env_set_shared": {
        "REASONIX_HOME": {
            "value": "$scoopdir\\persist\\@abgox.abyss\\AppData\\Roaming\\reasonix",
            "owner": [
                "ESEngine.ReasonixCLI",
                "ESEngine.ReasonixDesktop"
            ]
        }
    },
    "shortcuts": [
        [
            "app\\Reasonix.exe",
            "Reasonix"
        ]
    ],
    "link": "$env:AppData\\reasonix",
    "cleanup": "$env:LocalAppData\\reasonix-desktop.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "stable"
        },
        "regex": "desktop-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-amd64-installer.exe"
            },
            "arm64": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-arm64-installer.exe"
            }
        }
    }
}
