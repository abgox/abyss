    ],
    "link": "$env:AppData\\reasonix",
    "cleanup": "$env:LocalAppData\\reasonix-desktop.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
