{
    "version": "1.38.11",
    "description": "面向终端的 DeepSeek 原生 AI 编码智能体 | A DeepSeek-native AI coding agent for your terminal",
    "homepage": "https://reasonix.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.38.11/Reasonix-windows-amd64-installer.exe",
            "hash": "3eb58dc4d242a54c4429d1ffe7d1e1ceb8f1fd3fc2686bf1f18f6d3f987ec3c0"
        },
        "arm64": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.38.11/Reasonix-windows-arm64-installer.exe",
            "hash": "9ac280155a3df44f180be08909b5e3e675c1ae890430aaa1530999890ed66919"
        }
    },
    "env_set_shared": {
        "REASONIX_HOME": {
            "value": "$scoopdir\\persist\\@abgox.abyss\\AppData\\Roaming\\reasonix",
            "owner": [
                "ESEngine.ReasonixCLI",
                "ESEngine.ReasonixDesktop"
            ]
        }
    },
    "shortcuts": [
        [
            "app\\reasonix-launcher.exe",
            "Reasonix"
        ]
    ],
    "link": "$env:AppData\\reasonix",
    "cleanup": "$env:LocalAppData\\reasonix-desktop.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "stable"
        },
        "regex": "desktop-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-amd64-installer.exe"
            },
            "arm64": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-arm64-installer.exe"
            }
        }
    }
}
