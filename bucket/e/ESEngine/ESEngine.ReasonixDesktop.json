{
    "version": "1.39.4",
    "description": "面向终端的 DeepSeek 原生 AI 编码智能体 | A DeepSeek-native AI coding agent for your terminal",
    "homepage": "https://reasonix.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.39.4/Reasonix-windows-amd64-installer.exe",
            "hash": "02952b1c2b10aec2879440c95c7bc752f1aa3d1ff65e1dff2d2adcba5ef04d4c"
        },
        "arm64": {
            "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v1.39.4/Reasonix-windows-arm64-installer.exe",
            "hash": "989fc3f7f0dcf79cfc24c43d98d787aa0d3d82c60961d2b5a48738103da36cde"
        }
    },
    "env_set_shared": {
        "REASONIX_HOME": {
            "value": "$scoopdir\\persist\\@abgox.abyss\\AppData\\Roaming\\reasonix",
            "owner": [
                "ESEngine.ReasonixCLI",
                "ESEngine.ReasonixDesktop"
            ]
        }
    },
    "shortcuts": [
        [
            "app\\reasonix-launcher.exe",
            "Reasonix"
        ]
    ],
    "link": "$env:AppData\\reasonix",
    "cleanup": "$env:LocalAppData\\reasonix-desktop.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "stable"
        },
        "regex": "desktop-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-amd64-installer.exe"
            },
            "arm64": {
                "url": "https://github.com/esengine/DeepSeek-Reasonix/releases/download/desktop-v$version/Reasonix-windows-arm64-installer.exe"
            }
        }
    }
}
