    "description": "一款专注于快速绘制节点图的桌面工具 | A software that focuses on quickly drawing diagrams",
    "homepage": "https://github.com/graphif/project-graph",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/graphif/project-graph/releases/download/v4.3.2/Project.Graph_4.3.2_x64-setup.exe",
            "hash": "bade39be2a1a86ba1af1943d08b64294ba9e1897bf81faa732b0559bd3dbaf0c"
        }
    },
    "shortcuts": [
        [
            "app\\project-graph.exe",
            "Project Graph"
        ]
    ],
    "link": "$env:AppData\\liren.project-graph",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/graphif/project-graph/releases/download/v$version/Project.Graph_$version_x64-setup.exe"
            }
        }
    }
