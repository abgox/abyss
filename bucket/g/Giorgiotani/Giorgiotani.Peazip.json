{
    "version": "11.4.0",
    "description": "一款免费的文件归档工具和 rar 解压缩器 | A free file archiver utility and rar extractor",
    "homepage": "https://peazip.github.io",
    "license": {
        "identifier": "LGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/peazip/PeaZip/releases/download/11.4.0/peazip-11.4.0.WIN64.exe",
            "hash": "7c7e70f4bb64b0f8e6f088c33bb14d7791d9a7c1a762d062f3bfec1bbb8ac9d3"
        }
    },
    "bin": "app\\peazip.exe",
    "shortcuts": [
        [
            "app\\peazip.exe",
            "PeaZip"
        ]
    ],
    "link": "$env:AppData\\PeaZip",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/peazip/PeaZip/releases/download/$version/peazip-$version.WIN64.exe"
            }
        }
    }
}
