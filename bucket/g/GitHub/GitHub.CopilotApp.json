{
    "version": "1.1.27",
    "description": "一款面向智能体驱动开发的桌面应用，将并行工作流、GitHub 集成以及拉取请求全生命周期管理整合至同一平台 | A desktop application for agent-driven development that brings parallel workstreams, GitHub integration, and PR lifecycle management into one place",
    "homepage": "https://github.com/github/app",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/github/app/releases/download/v1.1.27/GitHub-Copilot-windows-x64-setup.exe",
            "hash": "22ede496bd68c5935a8b71d89956fbce604da13a64d1be27d99a451169cfe0b8"
        },
        "arm64": {
            "url": "https://github.com/github/app/releases/download/v1.1.27/GitHub-Copilot-windows-arm64-setup.exe",
            "hash": "8e78061ce70f5e9a85bbe2926e6d3e0f72d657cde5f11dd29009ee9114ffa68f"
        }
    },
    "shortcuts": [
        [
            "app\\github.exe",
            "GitHub Copilot"
        ]
    ],
    "link": "$env:AppData\\com.github.githubapp",
    "cleanup": [
        "$env:LocalAppData\\com.github.githubapp",
        "$env:LocalAppData\\github-copilot-sdk"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/github/app/releases/download/v$version/GitHub-Copilot-windows-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/github/app/releases/download/v$version/GitHub-Copilot-windows-arm64-setup.exe"
            }
        }
    }
}
