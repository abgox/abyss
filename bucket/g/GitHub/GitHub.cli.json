{
    "version": "2.101.0",
    "description": "gh - GitHub 的官方命令行工具 | gh - GitHub's official command line tool",
    "homepage": "https://cli.github.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/cli/cli/releases/download/v2.101.0/gh_2.101.0_windows_amd64.zip",
            "hash": "bc6c814367b193cd8e713611d61e36013c0ef843b8f516458fe3eda039192794"
        },
        "arm64": {
            "url": "https://github.com/cli/cli/releases/download/v2.101.0/gh_2.101.0_windows_arm64.zip",
            "hash": "e6cbb2d4afdad3e70f3d38b8d1ebaa3a0870a897cfc0e4cf569826710b96b4fd"
        }
    },
    "extract_to": "app",
    "bin": "app\\bin\\gh.exe",
    "link": "$env:AppData\\GitHub CLI",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cli/cli/releases/download/v$version/gh_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/cli/cli/releases/download/v$version/gh_$version_windows_arm64.zip"
            }
        }
    }
}
