{
    "version": "2.103.2",
    "description": "gh - GitHub 的官方命令行工具 | gh - GitHub's official command line tool",
    "homepage": "https://cli.github.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/cli/cli/releases/download/v2.103.2/gh_2.103.2_windows_amd64.zip",
            "hash": "fef9fcdd8fdabd0501ab8b3d99eac976f504ab55d01bef9e8ef428a5d900ddda"
        },
        "arm64": {
            "url": "https://github.com/cli/cli/releases/download/v2.103.2/gh_2.103.2_windows_arm64.zip",
            "hash": "cefaaa3efcd110ef7bf71071a2242b85fd3d2ac26d7d62e1082de6a1e60a81d6"
        }
    },
    "extract_to": "app",
    "bin": "app\\bin\\gh.exe",
    "link": "$env:AppData\\GitHub CLI",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cli/cli/releases/download/v$version/gh_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/cli/cli/releases/download/v$version/gh_$version_windows_arm64.zip"
            }
        }
    }
}
