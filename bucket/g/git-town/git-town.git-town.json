{
    "version": "24.1.0",
    "description": "一款 Git 插件，可新增 Git 命令，让协作软件开发更高效、更安全 | Git plugin that adds Git commands that make collaborative software development more efficient and safe",
    "homepage": "https://www.git-town.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/git-town/git-town/releases/download/v24.1.0/git-town_windows_intel_64.zip",
            "hash": "26016bc019d0d02839824cf2ea9530e4da171c10656def2bee3381429d024fff"
        },
        "arm64": {
            "url": "https://github.com/git-town/git-town/releases/download/v24.1.0/git-town_windows_arm_64.zip",
            "hash": "731e6e441f6267378afe0ffabd88e6341197a358d79958c833873a35e88920e1"
        }
    },
    "extract_to": "app",
    "bin": "app\\git-town.exe",
    "link": "$env:AppData\\git-town",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/git-town/git-town/releases/download/v$version/git-town_windows_intel_64.zip"
            },
            "arm64": {
                "url": "https://github.com/git-town/git-town/releases/download/v$version/git-town_windows_arm_64.zip"
            }
        }
    }
}
