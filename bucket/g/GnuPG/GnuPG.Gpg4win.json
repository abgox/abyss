{
    "version": "5.1.0",
    "description": "GNU Privacy Guard 是一款用于文件和电子邮件的加密软件，适用于 Windows 系统 | GNU Privacy Guard for Windows is encryption software for files and emails",
    "homepage": "https://www.gpg4win.org",
    "license": {
        "identifier": "GPL-2.0",
        "url": "https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gpg4win.git;a=blob_plain;f=COPYING;hb=HEAD"
    },
    "architecture": {
        "64bit": {
            "url": "https://files.gpg4win.org/gpg4win-5.1.0.exe",
            "hash": "9682f2825c70dc3e7efd8a3fcb9e676ccb9674bebbf6be1a30d5837f5b420a2e"
        }
    },
    "location": "$env:ProgramFiles\\Gpg4win",
    "env_add_path_expand": [
        "$env:ProgramFiles\\Gpg4win\\bin",
        "$env:ProgramFiles\\GnuPG\\bin"
    ],
    "link": [
        "$env:AppData\\gnupg",
        "$env:AppData\\Gpg4win"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'gpg4win-uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App -ArgumentList '/S'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://www.gpg4win.org/get-gpg4win.html",
        "regex": "Download Gpg4win ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://files.gpg4win.org/gpg4win-$version.exe",
                "hash": {
                    "url": "https://gpg4win.org/package-integrity.html"
                }
            }
        }
    }
}
