{
    "version": "r42",
    "description": "由 Go 语言编写的终端文件管理器，深受 ranger 文件管理器的启发 | A terminal file manager written in Go with a heavy inspiration from ranger file manager",
    "homepage": "https://github.com/gokcehan/lf",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/gokcehan/lf/releases/download/r42/lf-windows-amd64.zip",
            "hash": "13bb576b02373610dbcfb97e483272198a1b94cada66298a302954d87613465c"
        }
    },
    "extract_to": "app",
    "bin": "app\\lf.exe",
    "link": [
        "$env:AppData\\lf",
        "$env:LocalAppData\\lf"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gokcehan/lf/releases/download/$version/lf-windows-amd64.zip"
            }
        }
    }
}
