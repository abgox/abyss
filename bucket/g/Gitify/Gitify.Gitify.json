{
    "version": "7.10.0",
    "description": "菜单栏上的 GitHub 通知 | GitHub notifications on your menu bar",
    "homepage": "https://gitify.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/gitify-app/gitify/releases/download/v7.10.0/Gitify-Setup-7.10.0.exe",
            "hash": "1fe74a9d05200bdb2b90ca08c16b1a34cbe30411f2833f5692978edd2a85b6c2"
        }
    },
    "shortcuts": [
        [
            "app\\Gitify.exe",
            "Gitify"
        ]
    ],
    "link": "$env:AppData\\gitify",
    "cleanup": "$env:LocalAppData\\gitify-updater",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Gitify.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gitify-app/gitify/releases/download/v$version/Gitify-Setup-$version.exe"
            }
        }
    }
}
