{
    "version": "5.123.4",
    "description": "Yandex Music 是一项寻找和收听音乐和播客的服务，可为每位用户提供个性化推荐 | Yandex Music is a service for finding and listening to music and podcasts that provides personalized recommendations for each user",
    "homepage": "https://music.yandex.com",
    "license": {
        "identifier": "Proprietary",
        "url": "https://yandex.com/legal/"
    },
    "architecture": {
        "64bit": {
            "url": "https://music-desktop-application.s3.yandex.net/stable/Yandex_Music_x64_5.123.4.exe",
            "hash": "b2c8573a98364dee333815c9a6617b595d3f5bad97d570d5d1bec4f1ac8e9e95"
        }
    },
    "shortcuts": [
        [
            "app\\Яндекс Музыка.exe",
            "Яндекс Музыка"
        ]
    ],
    "link": "$env:AppData\\YandexMusic",
    "cleanup": "$env:LocalAppData\\yandexmusic-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Яндекс Музыка.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Yandex.Music",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
