{
    "version": "2.0.0",
    "description": "GPU 加速终端、SSH 工作区，以及你的 AI CLI 会话空间 | A GPU-accelerated terminal, SSH workspace, and home for your AI CLI sessions",
    "homepage": "https://github.com/Kuddev/pebrel",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Kuddev/pebrel/releases/download/v2.0.0/Pebrel-v2.0.0-windows-x64-setup.exe",
            "hash": "4c3ff71c6924a022717e97316acc32dd10db6972d91f33427ca502fbb7d79316"
        }
    },
    "shortcuts": [
        [
            "app\\pebrel.exe",
            "Pebrel"
        ]
    ],
    "link": "$env:AppData\\Pebrel",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kuddev/pebrel/releases/download/v$version/Pebrel-v$version-windows-x64-setup.exe"
            }
        }
    }
}
