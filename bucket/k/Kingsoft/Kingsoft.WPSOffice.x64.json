{
    "version": "12.1.0.28022",
    "description": "一站式办公服务平台 | Complete office suite with PDF editor",
    "homepage": "https://www.wps.cn",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://official-package.wpscdn.cn/wps/download/WPS_Setup_x64_28022.exe",
            "hash": "c4cd4be5204c9cfee87f6adbd5be3195df90d726504ef7b03952b433db942b02"
        }
    },
    "conflicts": [
        "Kingsoft.WPSOffice",
        "Kingsoft.WPSOffice.CN",
        "Kingsoft.WPSOffice.x64"
    ],
    "location": "$env:LocalAppData\\kingsoft\\WPS Office",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -ArgumentList '/S', '-agreelicense'",
        "A-Hold-App"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Kingsoft.WPSOffice.x64",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
