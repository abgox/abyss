{
    "version": "26.08.1",
    "description": "免费开源的视频编辑器 | Free and Open Source Video Editor",
    "homepage": "https://kdenlive.org",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://invent.kde.org/multimedia/kdenlive/-/blob/HEAD/COPYING"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.kde.org/stable/kdenlive/26.08/windows/kdenlive-26.08.1.exe",
            "hash": "b436430eb7dd4b3d1da318a53a77798cdaf3543a9f790824df214588b07f5d1e"
        }
    },
    "location": "$env:ProgramFiles\\kdenlive",
    "link": "$env:LocalAppData\\kdenliverc",
    "cleanup": "$env:LocalAppData\\kdenlive",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "KDE.Kdenlive",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
