            "hash": "70bacd1292a7f842383f47ce3c60cf35ce999cf0dbf12e3fcca4e101c4802be1"
        },
        "arm64": {
            "url": "https://github.com/kuaifan/dootask/releases/download/v1.9.59/DooTask-v1.9.59-win-arm64.exe",
            "hash": "acf051aec3bd64cfa0e5bc48c0aeac2ff9a41efe9e4f1bea400096e98b6d03a2"
