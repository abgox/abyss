{
    "version": "8.1.2-4",
    "description": "带有自定义扩展和增强功能的适用于 Jellyfin 的 FFmpeg | FFmpeg for Jellyfin with custom extensions and enhancements",
    "homepage": "https://github.com/jellyfin/jellyfin-ffmpeg",
    "license": {
        "identifier": "LGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v8.1.2-4/jellyfin-ffmpeg_8.1.2-4_portable_win64-clang-gpl.zip",
            "hash": "a6821d72985ee6d5a8af16925b468d1c4ec1f652b582a0a2a5039282c26ffca5"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\ffmpeg.exe",
        "app\\ffprobe.exe"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "Jellyfin.FFmpeg",
            "ext": "zip"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
