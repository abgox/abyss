{
    "version": "2026.2.1",
    "description": "JetBrains 的 IDE 产品，用于 .NET 开发 | A IDE by JetBrains for .NET development",
    "homepage": "https://www.jetbrains.com/rider",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.jetbrains.com/rider/JetBrains.Rider-2026.2.1.exe",
            "hash": "5726b642fddc5b98aab88218344d53c489493cf6f8990c7d5379eee5e05f767b"
        },
        "arm64": {
            "url": "https://download.jetbrains.com/rider/JetBrains.Rider-2026.2.1-aarch64.exe",
            "hash": "0cd1569cdfa192beb5ba70653458b4201d127697d33480a534b6e3ed70ef0fd2"
        }
    },
    "bin": [
        [
            "app\\bin\\rider64.exe",
            "Rider"
        ]
    ],
    "shortcuts": [
        [
            "app\\bin\\rider64.exe",
            "Rider 2026.2.1"
        ]
    ],
    "link": [
        "$env:AppData\\JetBrains",
        "$env:LocalAppData\\JetBrains"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$LogFile = '\"' + \"$env:TEMP\\Scoop_$app@$version_install.log\" + '\"'",
        "A-Install-App -Uninstaller 'app\\bin\\Uninstall.exe' -ArgumentList '/S', \"/LOG=$LogFile\", \"/D=$dir\\app\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App -ArgumentList '/S'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "JetBrains.Rider",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.jetbrains.com/rider/JetBrains.Rider-$version.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            },
            "arm64": {
                "url": "https://download.jetbrains.com/rider/JetBrains.Rider-$version-aarch64.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_user.InstallerSha256"
                }
            }
        },
        "shortcuts": [
            [
                "app\\bin\\rider64.exe",
                "Rider $version"
            ]
        ]
    }
}
