{
    "version": "2026.2.3",
    "description": "JetBrains 的 IDE 产品，用于 Rust 开发 | A IDE by JetBrains for Rust development",
    "homepage": "https://www.jetbrains.com/rust",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.jetbrains.com/rustrover/RustRover-2026.2.3.exe",
            "hash": "02b502300e977ee4db7a7b97b20f970da811a5131e71ab55ffb7ed66ebc9b3e1"
        },
        "arm64": {
            "url": "https://download.jetbrains.com/rustrover/RustRover-2026.2.3-aarch64.exe",
            "hash": "7735670284bc3c5c242731032302749dfbd565e1fc69f3caa25ac49e73f8c62a"
        }
    },
    "bin": [
        [
            "app\\bin\\rustrover64.exe",
            "RustRover"
        ]
    ],
    "shortcuts": [
        [
            "app\\bin\\rustrover64.exe",
            "RustRover 2026.2.3"
        ]
    ],
    "link": [
        "$env:AppData\\JetBrains",
        "$env:LocalAppData\\JetBrains"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$LogFile = '\"' + \"$env:TEMP\\Scoop_$app@$version_install.log\" + '\"'",
        "A-Install-App -Uninstaller 'app\\bin\\Uninstall.exe' -ArgumentList '/S', \"/LOG=$LogFile\", \"/D=$dir\\app\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App -ArgumentList '/S'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "JetBrains.RustRover",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.jetbrains.com/rustrover/RustRover-$version.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            },
            "arm64": {
                "url": "https://download.jetbrains.com/rustrover/RustRover-$version-aarch64.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_user.InstallerSha256"
                }
            }
        },
        "shortcuts": [
            [
                "app\\bin\\rustrover64.exe",
                "RustRover $version"
            ]
        ]
    }
}
