{
    "version": "2026.2.3",
    "description": "JetBrains 的 IDE 产品，用于 Golang 开发 | A IDE by JetBrains for Golang development",
    "homepage": "https://www.jetbrains.com/go",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.jetbrains.com/go/goland-2026.2.3.exe",
            "hash": "78d0f7fb368c7233470c057e12712fec7df315f5cecdbe1796cc9474541673e0"
        },
        "arm64": {
            "url": "https://download.jetbrains.com/go/goland-2026.2.3-aarch64.exe",
            "hash": "ece7ad14362ad3b417cfd5062a3fdefaec3b872de50ebcb79837992ca66cc710"
        }
    },
    "bin": [
        [
            "app\\bin\\goland64.exe",
            "GoLand"
        ]
    ],
    "shortcuts": [
        [
            "app\\bin\\goland64.exe",
            "GoLand 2026.2.3"
        ]
    ],
    "link": [
        "$env:AppData\\JetBrains",
        "$env:LocalAppData\\JetBrains"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$LogFile = '\"' + \"$env:TEMP\\Scoop_$app@$version_install.log\" + '\"'",
        "A-Install-App -Uninstaller 'app\\bin\\Uninstall.exe' -ArgumentList '/S', \"/LOG=$LogFile\", \"/D=$dir\\app\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Uninstall-App -ArgumentList '/S'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "JetBrains.GoLand",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.jetbrains.com/go/goland-$version.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            },
            "arm64": {
                "url": "https://download.jetbrains.com/go/goland-$version-aarch64.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.arm64_user.InstallerSha256"
                }
            }
        },
        "shortcuts": [
            [
                "app\\bin\\goland64.exe",
                "GoLand $version"
            ]
        ]
    }
}
