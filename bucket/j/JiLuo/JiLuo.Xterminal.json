{
    "version": "5.8.6",
    "description": "一个在线 SSH、SFTP 终端工具，支持文件在线编辑、状态监控等功能 | An online SSH and SFTP terminal tool that supports online file editing, status monitoring and other functions",
    "homepage": "https://www.xterminal.cn",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn-office.xterminal.cn/downloads/XTerminal-5.8.6-win-x64-installer.exe",
            "hash": "4f3daeaaba5106ac38c394f223001debb2a7de29bdbed13d3183aa1108e03408"
        }
    },
    "shortcuts": [
        [
            "app\\Xterminal.exe",
            "Xterminal"
        ]
    ],
    "link": "$env:AppData\\xterminal",
    "cleanup": "$env:LocalAppData\\xterminal-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall XTerminal.exe' -ArgumentList '/CurrentUser','/S',\"/D=$dir\\app\""
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "JiLuo.Xterminal",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn-office.xterminal.cn/downloads/XTerminal-$version-win-x64-installer.exe",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_user.InstallerSha256"
                }
            }
        }
    }
}
