{
    "version": "0.45.1",
    "description": "Jujutsu，又叫 jj，是一款既简单又强大的与 Git 兼容的版本控制系统 | Jujutsu, also called jj, is a Git-compatible VCS that is both simple and powerful",
    "homepage": "https://jj-vcs.dev",
    "license": {
        "identifier": "Apache-2.0"
    },
    "suggest": {
        "completions": "abyss/abgox.PSCompletions",
        "TUI": "abyss/IbrahimDursun.jjui"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jj-vcs/jj/releases/download/v0.45.1/jj-v0.45.1-x86_64-pc-windows-msvc.zip",
            "hash": "5dbf2619272c897394d34190a94b21a6ab8d1e8e59fcf7dfc173d8fa8aa90bf0"
        },
        "arm64": {
            "url": "https://github.com/jj-vcs/jj/releases/download/v0.45.1/jj-v0.45.1-aarch64-pc-windows-msvc.zip",
            "hash": "0f869d108316149f211d2ba50a626b4fe8ef99232db52f13300bde106821be9e"
        }
    },
    "extract_to": "app",
    "bin": "app\\jj.exe",
    "link": "$env:AppData\\jj",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jj-vcs/jj/releases/download/v$version/jj-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/jj-vcs/jj/releases/download/v$version/jj-v$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
