{
    "version": "0.45.0",
    "description": "Jujutsu，又叫 jj，是一款既简单又强大的与 Git 兼容的版本控制系统 | Jujutsu, also called jj, is a Git-compatible VCS that is both simple and powerful",
    "homepage": "https://jj-vcs.dev",
    "license": {
        "identifier": "Apache-2.0"
    },
    "suggest": {
        "completions": "abyss/abgox.PSCompletions",
        "TUI": "abyss/IbrahimDursun.jjui"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jj-vcs/jj/releases/download/v0.45.0/jj-v0.45.0-x86_64-pc-windows-msvc.zip",
            "hash": "02849951956c1f306dc4535494005267f8554e9f19c508f3c612fc08c2ccf8af"
        },
        "arm64": {
            "url": "https://github.com/jj-vcs/jj/releases/download/v0.45.0/jj-v0.45.0-aarch64-pc-windows-msvc.zip",
            "hash": "e3611d415ab98027035d3dfc49b55c373ae666d9e8f27c8cc28746f563ed6626"
        }
    },
    "extract_to": "app",
    "bin": "app\\jj.exe",
    "link": "$env:AppData\\jj",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jj-vcs/jj/releases/download/v$version/jj-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/jj-vcs/jj/releases/download/v$version/jj-v$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
