{
    "version": "1.4",
    "description": "Neat Download Manager 是一款免费的下载管理器和加速器 | Neat Download Manager is a free download manager and accelerator",
    "homepage": "https://www.neatdownloadmanager.com",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.neatdownloadmanager.com/file/NeatDM_setup.exe",
            "hash": "3474f9a78cf4a443eeba53d136d0d36d860cecdf955c39075f99287fc759c69e"
        }
    },
    "shortcuts": [
        [
            "app\\NeatDM.exe",
            "Neat Download Manager"
        ]
    ],
    "link": "$env:AppData\\NeatDM",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "winget": {
            "id": "JavadMotallebi.NeatDownloadManager",
            "ext": "exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX86",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x86_machine.InstallerSha256"
                }
            }
        }
    }
}
