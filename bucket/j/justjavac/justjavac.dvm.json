{
    "version": "1.10.0",
    "description": "Deno 版本管理器 —— 轻松管理多个活跃的 deno 版本的方式 | Deno Version Manager - Easy way to manage multiple active deno versions",
    "homepage": "https://dvm.deno.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/justjavac/dvm/releases/download/v1.10.0/dvm-x86_64-pc-windows-msvc.zip",
            "hash": "cd58f1c62ef2b40c7f4efa1f75bf36f9003c7dea715c734d81c87f2e3cb06f42"
        }
    },
    "extract_to": "app",
    "env_set": {
        "DVM_DIR": "$persist_dir\\.dvm"
    },
    "env_add_path": ".dvm\\bin",
    "bin": "app\\dvm.exe",
    "link": [
        "$home\\.dvm",
        "$home\\.dvmrc"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/justjavac/dvm/releases/download/v$version/dvm-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
