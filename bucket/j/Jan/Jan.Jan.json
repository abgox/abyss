{
    "version": "0.8.6",
    "description": "ChatGPT 的开源替代品，可在计算机上百分百脱机运行 | An open source alternative to ChatGPT that runs 100% offline on your computer",
    "homepage": "https://jan.ai",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/menloresearch/jan/releases/download/v0.8.6/Jan_0.8.6_x64-setup.exe",
            "hash": "f47f2d205eb92743bdd60ffe7d3b7b434b45a97a8dce092c1185c97d1f5a5268"
        }
    },
    "bin": "app\\jan.exe",
    "shortcuts": [
        [
            "app\\jan.exe",
            "Jan"
        ]
    ],
    "link": "$env:AppData\\jan",
    "cleanup": "$env:LocalAppData\\jan-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/menloresearch/jan/releases/download/v$version/Jan_$version_x64-setup.exe"
            }
        }
    }
}
