{
    "version": "31.4.4",
    "description": "一款基于 Electron 的桌面绘图应用程序，它封装了 draw.io 核心编辑器 | A diagramming desktop app based on Electron that wraps the core draw.io editor",
    "homepage": "https://www.diagrams.net",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jgraph/drawio-desktop/releases/download/v31.4.4/draw.io-31.4.4-windows.zip",
            "hash": "00ac91ae78caec3496341999b8ed61e02490406b09c70620fd233b4a883edc79"
        }
    },
    "extract_to": "app",
    "bin": "app\\draw.io.exe",
    "shortcuts": [
        [
            "app\\draw.io.exe",
            "draw.io"
        ]
    ],
    "link": "$env:AppData\\draw.io",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jgraph/drawio-desktop/releases/download/v$version/draw.io-$version-windows.zip"
            }
        }
    }
}
