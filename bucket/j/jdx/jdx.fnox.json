            "hash": "49ea9a62555cea64d57daf08658f4074abcd1055546adcd7047a4ec324c0c078"
        },
        "arm64": {
            "url": "https://github.com/jdx/fnox/releases/download/v1.31.1/fnox-aarch64-pc-windows-msvc.zip",
