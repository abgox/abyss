{
    "version": "2.5.0",
    "description": "一款快速的 Node.js 包管理器 | A fast Node.js package manager",
    "homepage": "https://aube.jdx.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jdx/aube/releases/download/v2.5.0/aube-v2.5.0-x86_64-pc-windows-msvc.zip",
            "hash": "4d39e74cc45bf418f9cdf0bd81ac846aefc8b7045077afe8cf3226366dc091fe"
        },
        "arm64": {
            "url": "https://github.com/jdx/aube/releases/download/v2.5.0/aube-v2.5.0-aarch64-pc-windows-msvc.zip",
            "hash": "ed6d1b1d1878170f213b7880e9300b923ad6fa13920e2dc7730ab4a43accf681"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\aube.exe",
        "app\\aubr.exe",
        "app\\aubx.exe"
    ],
    "link": "$home\\.config\\aube",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
