{
    "version": "1.35.0",
    "description": "一款快速的 Node.js 包管理器 | A fast Node.js package manager",
    "homepage": "https://aube.jdx.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jdx/aube/releases/download/v1.35.0/aube-v1.35.0-x86_64-pc-windows-msvc.zip",
            "hash": "6e0fcd8150f5c16925ec90c83de1bc90866d07fefce4c57398ceb81651d86ff0"
        },
        "arm64": {
            "url": "https://github.com/jdx/aube/releases/download/v1.35.0/aube-v1.35.0-aarch64-pc-windows-msvc.zip",
            "hash": "46f6e3b4b742a65efc218d9baefd5a13ea4d30af935b824d83c465022f874baf"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\aube.exe",
        "app\\aubr.exe",
        "app\\aubx.exe"
    ],
    "link": "$home\\.config\\aube",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
