{
    "version": "2.2.14",
    "description": "一款快速的 Node.js 包管理器 | A fast Node.js package manager",
    "homepage": "https://aube.jdx.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jdx/aube/releases/download/v2.2.14/aube-v2.2.14-x86_64-pc-windows-msvc.zip",
            "hash": "1ed12d917865cef8426a1fc98706a0f85aab292b003e1e971c4e703a102dd687"
        },
        "arm64": {
            "url": "https://github.com/jdx/aube/releases/download/v2.2.14/aube-v2.2.14-aarch64-pc-windows-msvc.zip",
            "hash": "eae61509d784ce076419ea9994c547a5469e3efb2b20439f24f5899d64f8b61c"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\aube.exe",
        "app\\aubr.exe",
        "app\\aubx.exe"
    ],
    "link": "$home\\.config\\aube",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
