{
    "version": "1.36.0",
    "description": "一款快速的 Node.js 包管理器 | A fast Node.js package manager",
    "homepage": "https://aube.jdx.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jdx/aube/releases/download/v1.36.0/aube-v1.36.0-x86_64-pc-windows-msvc.zip",
            "hash": "60ba3fddbea53405411700ced508071eefc98143479e87ce02ae1bc278b768ad"
        },
        "arm64": {
            "url": "https://github.com/jdx/aube/releases/download/v1.36.0/aube-v1.36.0-aarch64-pc-windows-msvc.zip",
            "hash": "47e2957fe55008246b188da4fc70362fef1026b587eebd2f587151b14fdb01b6"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\aube.exe",
        "app\\aubr.exe",
        "app\\aubx.exe"
    ],
    "link": "$home\\.config\\aube",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
