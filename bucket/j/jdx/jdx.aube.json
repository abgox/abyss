{
    "version": "1.37.0",
    "description": "一款快速的 Node.js 包管理器 | A fast Node.js package manager",
    "homepage": "https://aube.jdx.dev",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jdx/aube/releases/download/v1.37.0/aube-v1.37.0-x86_64-pc-windows-msvc.zip",
            "hash": "7a264819a7c05d107ac72916f82209a183bfd26842b9528f1ca281bb32596c5e"
        },
        "arm64": {
            "url": "https://github.com/jdx/aube/releases/download/v1.37.0/aube-v1.37.0-aarch64-pc-windows-msvc.zip",
            "hash": "6021114fdc7e2ee758e833bff04240fcbdc4eb28711a334c1dbe2ba7c58d64a2"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\aube.exe",
        "app\\aubr.exe",
        "app\\aubx.exe"
    ],
    "link": "$home\\.config\\aube",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\1.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "script": [
            ". $pwd\\util\\1.ps1",
            "A-Get-LatestVersionFromGithub"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/jdx/aube/releases/download/v$version/aube-v$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
