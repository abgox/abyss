            "hash": "0f3b7e8c79fda137438451b2a9030972bd086ae11e79ec91477e8de11ec014ae"
        },
        "arm64": {
            "url": "https://github.com/xpipe-io/xpipe/releases/download/24.0.4/xpipe-installer-windows-arm64.msi",
