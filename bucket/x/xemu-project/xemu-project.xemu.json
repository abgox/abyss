{
    "version": "0.8.138",
    "description": "一款免费的开源应用程序，可模拟初代微软 Xbox 游戏机，让人们能够在 Windows、macOS 和 Linux 系统上玩初代 Xbox 游戏 | A free and open-source application that emulates the original Microsoft Xbox game console, enabling people to play their original Xbox games on Windows, macOS, and Linux systems",
    "homepage": "https://xemu.app",
    "license": {
        "identifier": "GPL-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/xemu-project/xemu/releases/download/v0.8.138/xemu-win-x86_64-release.zip",
            "hash": "bb6d8b3a82ca514a162ebd0f237a912143238bfc635311f9835768eb2ceedba4"
        },
        "arm64": {
            "url": "https://github.com/xemu-project/xemu/releases/download/v0.8.138/xemu-win-aarch64-release.zip",
            "hash": "c48e3de31ca38f957b9554fab8a784f1da3dbbabe6b728386b0e82cfa5c47131"
        }
    },
    "extract_to": "app",
    "bin": "app\\xemu.exe",
    "shortcuts": [
        [
            "app\\xemu.exe",
            "xemu"
        ]
    ],
    "link": "$env:AppData\\xemu\\xemu",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xemu-project/xemu/releases/download/v$version/xemu-win-x86_64-release.zip"
            },
            "arm64": {
                "url": "https://github.com/xemu-project/xemu/releases/download/v$version/xemu-win-aarch64-release.zip"
            }
        }
    }
}
